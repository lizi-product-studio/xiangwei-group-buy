{
  "name": "@hometown/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/scripts/migrate.ts",
    "admin:bootstrap": "node --env-file-if-exists=../../.env --import tsx src/scripts/bootstrap-admin.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@hometown/api-contracts": "workspace:*",
    "@hometown/domain": "workspace:*",
    "bullmq": "5.63.2",
    "casbin": "^5.51.1",
    "china-area-data": "5.0.1",
    "fastify": "5.8.5",
    "ioredis": "5.8.2",
    "mysql2": "3.15.3",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.20.6"
  }
}
