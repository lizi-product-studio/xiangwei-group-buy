<view class="product-image">
  <image wx:if="{{requestSrc}}" class="product-image__photo" src="{{requestSrc}}" data-version="{{requestVersion}}" mode="aspectFill" bindload="loadedImage" binderror="failedImage" aria-label="商品主图" />
  <view wx:if="{{!resolvedSrc || failed}}" class="product-image__placeholder product-image__placeholder--action" bindtap="retryImage" role="button" aria-label="重新加载商品图片"><text>{{failed ? '图片加载失败，点击重试' : '暂无图片'}}</text></view>
  <view wx:elif="{{!loaded}}" class="product-image__placeholder"><text>图片加载中</text></view>
</view>
