:host { display: block; width: 100%; height: 100%; }
.product-image { position: relative; width: 100%; height: 100%; overflow: hidden; background: #f0f1eb; }
.product-image__photo { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
.product-image__placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 8rpx; color: #8a9186; font-size: 22rpx; text-align: center; box-sizing: border-box; }
.product-image__placeholder--action { background: #f0f1eb; }
