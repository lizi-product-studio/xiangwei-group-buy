.pickup-page{min-height:100vh;padding:28rpx;background:#faf9f4;box-sizing:border-box;color:#17263a}.pickup-page__intro{padding:34rpx;border-radius:28rpx;background:#17263a;color:#fff;display:flex;flex-direction:column;gap:12rpx}.pickup-page__intro text:first-child{font-size:36rpx;font-weight:700}.pickup-page__intro text:last-child{font-size:25rpx;line-height:1.6;color:#dce2ec}.state-card{margin-top:24rpx;padding:52rpx 28rpx;border-radius:24rpx;background:#fff;display:flex;flex-direction:column;align-items:center;gap:18rpx;color:#6f7784}.state-card--error{color:#bd3d28}.area-group{margin-top:28rpx}.area-group__title{padding:0 8rpx 14rpx;display:flex;justify-content:space-between;align-items:center}.area-group__title text:first-child{font-size:31rpx;font-weight:700}.area-group__title text:last-child{font-size:23rpx;color:#8b929d}.point-row{margin-bottom:14rpx;padding:24rpx;background:#fff;border:2rpx solid transparent;border-radius:24rpx;display:flex;align-items:center;gap:18rpx}.point-row--selected{border-color:#e94c2f;background:#fffaf7}.point-row__pin{width:62rpx;height:62rpx;border-radius:18rpx;background:#fce5dd;color:#df4327;display:flex;align-items:center;justify-content:center;font-weight:700}.point-row__copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:8rpx}.point-row__copy text:first-child{font-size:29rpx;font-weight:650}.point-row__copy text:last-child{font-size:23rpx;line-height:1.45;color:#7c838e}.point-row__check{font-size:24rpx;color:#df4327;font-weight:600}.interest-link{display:block;width:auto;margin:26rpx auto 52rpx;padding:0;color:#71804a;background:transparent;font-size:22rpx}
