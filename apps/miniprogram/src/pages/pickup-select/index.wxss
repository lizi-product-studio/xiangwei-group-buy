.pickup-page{min-height:100vh;padding:28rpx;background:#faf8f2;box-sizing:border-box;color:#23312d}.pickup-page__intro{padding:34rpx;border-radius:28rpx;background:#23312d;color:#fff;display:flex;flex-direction:column;gap:12rpx}.pickup-page__intro .ui-text:first-child{font-size:36rpx;font-weight:700}.pickup-page__intro .ui-text:last-child{font-size:25rpx;line-height:1.6;color:#dce2ec}.state-card{margin-top:24rpx;padding:52rpx 28rpx;border-radius:24rpx;background:#fff;display:flex;flex-direction:column;align-items:center;gap:18rpx;color:#6f7784}.state-card--error{color:#bd3d28}.area-group{margin-top:28rpx}.area-group__title{padding:0 8rpx 14rpx;display:flex;justify-content:space-between;align-items:center}.area-group__title .ui-text:first-child{font-size:31rpx;font-weight:700}.area-group__title .ui-text:last-child{font-size:23rpx;color:#8b929d}.point-row{margin-bottom:14rpx;padding:24rpx;background:#fff;border:2rpx solid transparent;border-radius:24rpx;display:flex;align-items:center;gap:18rpx}.point-row--selected{border-color:#c2412d;background:#fffaf7}.point-row__pin{width:62rpx;height:62rpx;border-radius:18rpx;background:#fce5dd;color:#c2412d;display:flex;align-items:center;justify-content:center;font-weight:700}.point-row__copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:8rpx}.point-row__copy .ui-text:first-child{font-size:29rpx;font-weight:650}.point-row__copy .ui-text:last-child{font-size:23rpx;line-height:1.45;color:#7c838e}.point-row__check{font-size:24rpx;color:#c2412d;font-weight:600}.interest-link{display:block;width:auto;margin:26rpx auto 52rpx;padding:0;color:#71804a;background:transparent;font-size:22rpx}

.pickup-page {padding:36rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));}.pickup-page__intro {padding:0 0 28rpx;background:transparent;color:#23312d;border-radius:0;}.pickup-page__intro .ui-text:first-child {font-size:38rpx;}.pickup-page__intro .ui-text:last-child {color:#626c60;font-size:26rpx;line-height:1.7;}.point-row {align-items:flex-start;background:#fffefa;border:1rpx solid #e9e7df;border-radius:22rpx;padding:26rpx 22rpx;gap:16rpx;}.point-row--selected {border:2rpx solid #e9aa97;background:#fff3ec;}.point-row__pin {background:transparent;width:40rpx;height:40rpx;flex:none;}.point-row__asset {width:40rpx;height:40rpx;}.point-row__copy {font-size:24rpx;line-height:1.6;}.point-row__check {flex:none;font-size:24rpx;color:#3f6b35;}.state-card {font-size:26rpx;line-height:1.7;text-align:center;background:#fffefa;border:1rpx solid #e9e7df;}.pickup-page .state-card__action {width:100%!important;max-width:460rpx;box-sizing:border-box;padding:20rpx 24rpx!important;margin:12rpx 0 0!important;border-radius:18rpx;background:#c2412d;color:white;font-size:28rpx;}.pickup-page .interest-link {width:100%!important;margin:24rpx 0!important;padding:18rpx 0!important;font-size:24rpx;line-height:1.6;}
