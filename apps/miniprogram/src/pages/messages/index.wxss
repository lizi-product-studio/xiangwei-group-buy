.messages-page{min-height:100vh;padding:28rpx;background:#faf8f2;box-sizing:border-box}.reminder-card{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:30rpx;background:#23312d;border-radius:24rpx;color:#fff}.reminder-card .ui-view{display:flex;flex:1;flex-direction:column;gap:9rpx}.reminder-card .ui-text:first-child{font-size:29rpx;font-weight:650}.reminder-card .ui-text:last-child{color:#d6ded9;font-size:24rpx;line-height:1.45}.reminder-card .ui-button{margin:0;color:#42582e;background:#edf4e7;border-radius:30rpx;font-size:24rpx}.state-card{display:flex;flex-direction:column;gap:12rpx;margin-top:22rpx;padding:55rpx 28rpx;background:#fff;border-radius:22rpx;color:#7e8790;text-align:center;font-size:23rpx}.state-card--error{color:#b74831}.message-card{margin-top:18rpx;padding:27rpx;background:#fff;border:1rpx solid #e9e7df;border-radius:22rpx}.message-card--unread{border-color:#f1c2b6;box-shadow:0 6rpx 18rpx rgba(211,75,45,.06)}.message-card .ui-view{display:flex;justify-content:space-between;gap:16rpx}.message-card .ui-view .ui-text:first-child{color:#25313d;font-size:27rpx;font-weight:650}.message-card .ui-view .ui-text:last-child{color:#939aa3;font-size:24rpx}.message-card>.ui-text:nth-child(2){display:block;margin-top:14rpx;color:#707883;font-size:22rpx;line-height:1.55}.message-card__link{display:block;margin-top:16rpx;color:#e04c30;font-size:24rpx}

.messages-page {padding:36rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));}.reminder-card {padding:0 0 28rpx;border-radius:0;border-bottom:1rpx solid #e9e7df;background:transparent;color:#23312d;align-items:flex-start;}.reminder-card .ui-text:first-child {font-size:36rpx;}.reminder-card .ui-text:last-child {font-size:24rpx;color:#818780;line-height:1.6;}.reminder-card .ui-button {flex:none;border-radius:14rpx;padding:14rpx 18rpx!important;font-size:24rpx;}.message-card {padding:28rpx;background:#fffefa;border-radius:24rpx;}.message-card--unread {box-shadow:none;border-color:#cbd6bb;}.message-card .ui-view {flex-wrap:wrap;}.message-card>.ui-text:nth-child(2) {font-size:26rpx;line-height:1.7;}.message-card__link {color:#597a43;font-size:24rpx;}.state-card {font-size:26rpx;line-height:1.7;border:1rpx solid #e9e7df;background:#fffefa;}
.reminder-card__status{flex:none;padding:12rpx 18rpx;border-radius:999rpx;background:#edf4e7;color:#597a43;font-size:23rpx;font-weight:600}.reminder-card__status--declined{background:#f2f1ec;color:#747a74}
