.messages-page{min-height:100vh;padding:28rpx;background:#faf9f4;box-sizing:border-box}.reminder-card{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:30rpx;background:#17263a;border-radius:24rpx;color:#fff}.reminder-card view{display:flex;flex:1;flex-direction:column;gap:9rpx}.reminder-card text:first-child{font-size:29rpx;font-weight:800}.reminder-card text:last-child{color:#d6ded9;font-size:21rpx;line-height:1.45}.reminder-card button{margin:0;color:#42582e;background:#edf4e7;border-radius:30rpx;font-size:20rpx}.state-card{display:flex;flex-direction:column;gap:12rpx;margin-top:22rpx;padding:55rpx 28rpx;background:#fff;border-radius:22rpx;color:#7e8790;text-align:center;font-size:23rpx}.state-card--error{color:#b74831}.message-card{margin-top:18rpx;padding:27rpx;background:#fff;border:1rpx solid #ece9e1;border-radius:22rpx}.message-card--unread{border-color:#f1c2b6;box-shadow:0 6rpx 18rpx rgba(211,75,45,.06)}.message-card view{display:flex;justify-content:space-between;gap:16rpx}.message-card view text:first-child{color:#25313d;font-size:27rpx;font-weight:800}.message-card view text:last-child{color:#939aa3;font-size:19rpx}.message-card>text:nth-child(2){display:block;margin-top:14rpx;color:#707883;font-size:22rpx;line-height:1.55}.message-card__link{display:block;margin-top:16rpx;color:#e04c30;font-size:21rpx}
