.after-sale-page{min-height:100vh;padding:28rpx;background:#faf8f2;box-sizing:border-box}.tip-card{padding:32rpx;border-radius:26rpx;background:#fff3ed;color:#8f3827}.tip-card .ui-text{display:block}.tip-card .ui-text:first-child{font-size:31rpx;font-weight:650}.tip-card .ui-text:last-child{margin-top:10rpx;font-size:23rpx;line-height:1.55}.form-card{margin-top:22rpx;padding:30rpx;background:#fff;border:1rpx solid #e9e7df;border-radius:24rpx}.label{display:block;margin-bottom:14rpx;color:#27313d;font-size:25rpx;font-weight:700}.picker{display:flex;align-items:center;justify-content:space-between;height:84rpx;padding:0 22rpx;margin-bottom:28rpx;background:#f8f8f5;border:1rpx solid #e7e6e0;border-radius:16rpx;color:#34404c;font-size:25rpx}.picker .ui-text{color:#939aa3;font-size:38rpx}.ui-textarea{width:100%;height:220rpx;padding:20rpx;box-sizing:border-box;background:#f8f8f5;border:1rpx solid #e7e6e0;border-radius:16rpx;color:#34404c;font-size:24rpx;line-height:1.5}.form-card .ui-button{margin-top:28rpx}
.claim-row{margin:18rpx 0;padding:22rpx;border:1rpx solid #e7e6e0;border-radius:18rpx}.claim-row__header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx;font-weight:700}.claim-empty{padding:26rpx 0;color:#7b828a;font-size:24rpx;line-height:1.5}

.after-sale-page {padding:36rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));}.tip-card {padding:0 0 16rpx;background:transparent;color:#23312d;border-radius:0;}.tip-card .ui-text:first-child {font-size:38rpx;}.tip-card .ui-text:last-child {font-size:26rpx;color:#818780;line-height:1.7;}.form-card {padding:28rpx;background:#fffefa;border-radius:24rpx;font-size:26rpx;line-height:1.6;}.claim-row {padding:24rpx 0;border:0;border-top:1rpx solid #e9e7df;border-radius:0;}.claim-row__header {gap:16rpx;font-size:26rpx;}.picker {background:white;font-size:26rpx;}.after-sale-page .primary-button,.after-sale-page .secondary-button {width:100%!important;margin:28rpx 0 0!important;padding:20rpx!important;}
