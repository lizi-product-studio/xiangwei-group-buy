.after-sale-page{min-height:100vh;padding:28rpx;background:#faf9f4;box-sizing:border-box}.tip-card{padding:32rpx;border-radius:26rpx;background:#fff3ed;color:#8f3827}.tip-card text{display:block}.tip-card text:first-child{font-size:31rpx;font-weight:800}.tip-card text:last-child{margin-top:10rpx;font-size:23rpx;line-height:1.55}.form-card{margin-top:22rpx;padding:30rpx;background:#fff;border:1rpx solid #ece9e1;border-radius:24rpx}.label{display:block;margin-bottom:14rpx;color:#27313d;font-size:25rpx;font-weight:700}.picker{display:flex;align-items:center;justify-content:space-between;height:84rpx;padding:0 22rpx;margin-bottom:28rpx;background:#f8f8f5;border:1rpx solid #e7e6e0;border-radius:16rpx;color:#34404c;font-size:25rpx}.picker text{color:#939aa3;font-size:38rpx}textarea{width:100%;height:220rpx;padding:20rpx;box-sizing:border-box;background:#f8f8f5;border:1rpx solid #e7e6e0;border-radius:16rpx;color:#34404c;font-size:24rpx;line-height:1.5}.form-card button{margin-top:28rpx}
