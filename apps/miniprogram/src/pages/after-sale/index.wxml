<view class="after-sale-page">
  <view class="tip-card"><text>售后申请</text><text>请如实说明问题，客服会结合订单、领货核销与履约记录处理。{{qualityHint}}</text></view>
  <view class="form-card"><text class="label">问题类型</text><picker range="{{reasons}}" value="{{reasonIndex}}" bindchange="chooseReason"><view class="picker">{{reasons[reasonIndex]}}<text>›</text></view></picker><block wx:if="{{claimableItems.length && order && (order.status === 'PICKED_UP' || order.status === 'COMPLETED')}}"><text class="label">异常商品</text><picker range="{{claimableItems}}" value="{{selectedItemIndex}}" range-key="label" bindchange="chooseItem"><view class="picker">{{claimableItems[selectedItemIndex].label}}<text>›</text></view></picker><text class="label">异常数量</text><input class="picker" type="number" value="{{claimQuantity}}" bindinput="inputClaimQuantity" /></block><text class="label">问题说明</text><textarea value="{{description}}" maxlength="300" placeholder="请描述发生的情况、商品数量或领取时间等" bindinput="inputDescription" /><button class="primary-button" loading="{{submitting}}" bindtap="submit">提交申请</button></view>
</view>
