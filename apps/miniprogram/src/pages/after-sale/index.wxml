<view class="ui-view after-sale-page">
  <view class="ui-view tip-card"><text class="ui-text">售后申请</text><text class="ui-text">请如实说明问题，客服会结合订单、领货核销与履约记录处理。{{qualityHint}}</text></view>
  <view wx:if="{{!loggedIn}}" class="ui-view form-card"><text class="ui-text">登录后才能查看可申报商品并提交售后。</text><button class="ui-button primary-button" bindtap="openLogin">手机号快捷登录</button></view>
  <view wx:elif="{{loading}}" class="ui-view form-card"><text class="ui-text">正在加载可申报商品…</text></view>
  <view wx:elif="{{error}}" class="ui-view form-card"><text class="ui-text">{{error}}</text><button class="ui-button secondary-button" bindtap="loadOrder">重新加载</button></view>
  <view wx:else class="ui-view form-card">
    <text class="ui-text label">选择异常商品</text>
    <view wx:if="{{!claimRows.length}}" class="ui-view claim-empty">当前没有仍在 24 小时申报期内的已领取商品。</view>
    <view wx:for="{{claimRows}}" wx:key="skuId" class="ui-view claim-row">
      <view class="ui-view claim-row__header"><text class="ui-text">{{item.name}}（最多 {{item.maxQuantity}} 件）</text><switch class="ui-switch" checked="{{item.selected}}" data-index="{{index}}" bindchange="toggleClaimRow" /></view>
      <block wx:if="{{item.selected}}">
        <text class="ui-text label">问题类型</text>
        <picker range="{{reasons}}" value="{{item.reasonIndex}}" data-index="{{index}}" bindchange="chooseRowReason"><view class="ui-view picker">{{reasons[item.reasonIndex]}}<text class="ui-text">›</text></view></picker>
        <text class="ui-text label">异常数量</text>
        <input class="ui-input picker" type="number" value="{{item.quantity}}" data-index="{{index}}" bindinput="inputRowQuantity" />
        <text class="ui-text label">问题说明</text>
        <textarea class="ui-textarea" value="{{item.description}}" maxlength="300" data-index="{{index}}" placeholder="请描述该商品发生的情况（至少 5 个字）" bindinput="inputRowDescription" />
      </block>
    </view>
    <button class="ui-button {{!claimRows.length ? 'ui-disabled' : ''}} primary-button" loading="{{submitting}}" disabled="{{!claimRows.length}}" bindtap="submit">提交申请</button>
  </view>
</view>
