.checkout { padding: 24rpx 24rpx 180rpx; }
.pickup-card,.order-card,.rule-card { background: #fff; border: 1rpx solid #ece9e1; border-radius: 20rpx; }
.pickup-card { position: relative; padding: 28rpx; }.section-label { color: #92979f; font-size: 20rpx; }.pickup-card__name,.pickup-card__address { display: block; }.pickup-card__name { margin: 16rpx 0 10rpx; font-size: 31rpx; font-weight: 750; }.pickup-card__address { color: #858b94; font-size: 22rpx; }.pickup-card__change { position: absolute; right: 26rpx; top: 40rpx; color: #f05232; font-size: 22rpx; }
.order-card { margin-top: 20rpx; padding: 0 26rpx; }.order-card__merchant { padding: 24rpx 0; border-bottom: 1rpx solid #eeeae2; font-size: 24rpx; font-weight: 700; }.order-card__goods { display: grid; grid-template-columns: 110rpx 1fr auto; gap: 18rpx; align-items: center; padding: 26rpx 0; }.order-card__image { width: 110rpx; height: 110rpx; border-radius: 15rpx; }.order-card__goods view:nth-child(2) text,.order-card__goods view:last-child text { display: block; }.order-card__goods view:nth-child(2) text:first-child { font-size: 25rpx; font-weight: 700; }.order-card__goods view:nth-child(2) text:last-child,.order-card__goods view:last-child text:last-child { margin-top: 8rpx; color: #8b9199; font-size: 20rpx; }.order-card__goods .money { color: #f05232; font-size: 27rpx; }
.amount-line { display: flex; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid #edf0ed; color: #68727e; font-size: 22rpx; }.amount-line text:last-child { color: #17233a; }
.rule-card { margin-top: 20rpx; padding: 25rpx; line-height: 1.7; }.rule-card text { display: block; }.rule-card text:first-child { margin-bottom: 8rpx; color: #547b36; font-size: 23rpx; font-weight: 700; }.rule-card text:last-child { color: #747b84; font-size: 21rpx; }
.checkout-error text:first-child{color:#b8432e}.checkout-error text:last-child{color:#7a5550}.checkout-error button{width:100%;margin-top:20rpx;color:#cf492f;background:#fff1eb;border:1rpx solid #f4c5b8}
.checkout-bar { position: fixed; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 330rpx; gap: 18rpx; align-items: center; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.98); border-top: 1rpx solid #e7e8eb; }.checkout-bar view text { display: block; }.checkout-bar view text:first-child { color: #838992; font-size: 19rpx; }.checkout-bar .money { margin-top: 3rpx; color: #f05232; font-size: 38rpx; }.checkout-bar button { width: 100%; margin: 0; font-size: 25rpx; }
