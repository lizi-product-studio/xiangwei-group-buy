.checkout { padding: 24rpx 24rpx 180rpx; }
.pickup-card,.order-card,.rule-card { background: #fff; border: 1rpx solid #e9e7df; border-radius: 20rpx; }
.pickup-card { position: relative; padding: 28rpx; }.section-label { color: #92979f; font-size:24rpx; }.pickup-card__name,.pickup-card__address { display: block; }.pickup-card__name { margin: 16rpx 0 10rpx; font-size: 31rpx; font-weight:650; }.pickup-card__address { color: #626c60; font-size: 22rpx; }.pickup-card__change { position: absolute; right: 26rpx; top: 40rpx; color: #c2412d; font-size: 22rpx; }
.order-card { margin-top: 20rpx; padding: 0 26rpx; }.order-card__merchant { padding: 24rpx 0; border-bottom: 1rpx solid #eeeae2; font-size: 24rpx; font-weight: 700; }.order-card__goods { display: grid; grid-template-columns: 110rpx 1fr auto; gap: 18rpx; align-items: center; padding: 26rpx 0; }.order-card__image { width: 110rpx; height: 110rpx; border-radius: 15rpx; }.order-card__goods .ui-view:nth-child(2) .ui-text,.order-card__goods .ui-view:last-child .ui-text { display: block; }.order-card__goods .ui-view:nth-child(2) .ui-text:first-child { font-size: 25rpx; font-weight: 700; }.order-card__goods .ui-view:nth-child(2) .ui-text:last-child,.order-card__goods .ui-view:last-child .ui-text:last-child { margin-top: 8rpx; color: #626c60; font-size:24rpx; }.order-card__goods .money { color: #c2412d; font-size: 27rpx; }
.amount-line { display: flex; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid #edf0ed; color: #68727e; font-size: 22rpx; }.amount-line .ui-text:last-child { color: #23312d; }
.rule-card { margin-top: 20rpx; padding: 25rpx; line-height: 1.7; }.rule-card .ui-text { display: block; }.rule-card .ui-text:first-child { margin-bottom: 8rpx; color: #3f6b35; font-size: 23rpx; font-weight: 700; }.rule-card .ui-text:last-child { color: #737b71; font-size:24rpx; }
.checkout-error .ui-text:first-child{color:#b8432e}.checkout-error .ui-text:last-child{color:#7a5550}.checkout-error .ui-button{width:100%;margin-top:20rpx;color:#cf492f;background:#fff1eb;border:1rpx solid #f4c5b8}
.checkout-error .checkout-error__recovery{margin-top:12rpx;color:#858b82;font-size:23rpx;line-height:1.6}.checkout-error .text-button{border:0;background:transparent;color:#858b82}
.checkout-bar { position: fixed; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 330rpx; gap: 18rpx; align-items: center; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.98); border-top: 1rpx solid #e7e8eb; }.checkout-bar .ui-view .ui-text { display: block; }.checkout-bar .ui-view .ui-text:first-child { color: #838992; font-size:24rpx; }.checkout-bar .money { margin-top: 3rpx; color: #c2412d; font-size: 38rpx; }.checkout-bar .ui-button { width: 100%; margin: 0; font-size: 25rpx; }

.checkout {padding:36rpx 40rpx calc(190rpx + env(safe-area-inset-bottom));}.pickup-card,.order-card {background:#fffefa;border-radius:24rpx;}.pickup-card__address {font-size:24rpx;line-height:1.7;padding-right:18rpx;}.order-card__goods {grid-template-columns:106rpx minmax(0,1fr) auto;}.order-card__goods .ui-view {min-width:0;}.rule-card {background:#f0f2e8;border:0;}.rule-card .ui-text:last-child {font-size:24rpx;}.checkout-bar {padding-left:40rpx;padding-right:40rpx;grid-template-columns:1fr 300rpx;}.checkout .primary-button,.checkout .secondary-button {width:100%!important;margin-left:0!important;margin-right:0!important;padding:20rpx!important;}

.pickup-photo { width: 112rpx; height: 112rpx; margin-bottom: 16rpx; border-radius: 16rpx; overflow: hidden; }
.batch-intro{display:flex;flex-direction:column;gap:7rpx;margin:8rpx 0 18rpx;padding:22rpx;border-radius:18rpx;background:#fff0e9;color:#8d5d50;font-size:22rpx;line-height:1.55}.batch-intro__title{color:#302a25;font-size:28rpx;font-weight:750}.batch-order-card{margin-bottom:18rpx;padding:0 22rpx;border:1rpx solid #ebe7df;border-radius:20rpx;background:#fff;overflow:hidden}.batch-order-head{display:flex;justify-content:space-between;padding:20rpx 0 12rpx;border-bottom:1rpx solid #f0ebe5;color:#59645a;font-size:22rpx}.batch-order-head text:last-child{color:#c34c38;font-weight:700}.batch-campaign{display:block;margin-top:15rpx;color:#2d332d;font-size:27rpx;font-weight:700}.batch-location,.batch-arrival,.batch-cutoff{display:block;margin-top:7rpx;color:#737a72;font-size:21rpx;line-height:1.5}.batch-arrival{color:#a45b42}.batch-order-card .order-card__goods{display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f2eee9}.batch-order-card .order-card__image{flex:none;width:84rpx;height:84rpx}.batch-line-copy{flex:1;min-width:0;gap:6rpx}.batch-line-copy .ui-text:first-child{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#31352e;font-size:23rpx;font-weight:650}.batch-line-copy .ui-text:last-child{color:#8b8c83;font-size:20rpx}.batch-order-card .money{flex:none;color:#c24836;font-size:22rpx;font-weight:700}.batch-order-total{display:flex;justify-content:space-between;padding:16rpx 0;color:#797a72;font-size:22rpx}.batch-order-total text:last-child{color:#c24836;font-size:25rpx;font-weight:750}.batch-price-changed{margin-top:12rpx;padding:10rpx 14rpx;border-radius:10rpx;background:#fff5dd;color:#9a691c;font-size:20rpx}.batch-payment-note{margin-bottom:140rpx}.batch-payment-note .ui-text:first-child{font-size:24rpx;font-weight:700}

.batch-group-rule { display: flex; flex-direction: column; gap: 6rpx; margin-top: 14rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: #fff7e8; color: #73532b; font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.batch-campaign { overflow-wrap: anywhere; word-break: break-word; }
.checkout-topbar { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:0 0 18rpx; min-height:64rpx; }
.checkout-back { width:auto!important; min-width:210rpx; margin:0!important; padding:12rpx 20rpx!important; border:1rpx solid #deddd5!important; border-radius:14rpx!important; background:#fffefa!important; color:#50604f!important; font-size:24rpx!important; line-height:1.4!important; }
.checkout-processing { flex:1; color:#8a7553; font-size:21rpx; line-height:1.45; text-align:right; }
