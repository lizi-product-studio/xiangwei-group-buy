<view class="ui-view checkout">
  <view wx:if="{{loading}}" class="ui-view rule-card">正在核对商品、库存和收货区域…</view>
  <view wx:elif="{{error}}" class="ui-view rule-card checkout-error"><text class="ui-text">暂时不能结算</text><text class="ui-text">{{error}}</text><button class="ui-button secondary-button" bindtap="loadCheckout">重新核对</button></view>
  <block wx:else><view class="ui-view pickup-card" bindtap="openPickup"><text class="ui-text section-label">固定自提点</text><text class="ui-text pickup-card__name">{{pickupPoint.name}}</text><text class="ui-text pickup-card__address">{{pickupPoint.address}}</text><text wx:if="{{pickupPoint.businessHours}}" class="ui-text pickup-card__address">营业时间：{{pickupPoint.businessHours}}</text><text wx:if="{{pickupPoint.pickupInstructions}}" class="ui-text pickup-card__address">领取提示：{{pickupPoint.pickupInstructions}}</text><text class="ui-text pickup-card__address">{{deliveryNote}}</text><text class="ui-text pickup-card__change">查看 ›</text></view><view class="ui-view order-card"><view class="ui-view order-card__merchant">{{draft.campaignTitle}}</view><view wx:for="{{items}}" wx:key="skuId" class="ui-view order-card__goods"><view class="ui-image order-card__image"><product-image src="{{item.imageUrl || ''}}" /></view><view class="ui-view"><text class="ui-text">{{item.title}}</text><text class="ui-text">{{item.skuName}}</text></view><view class="ui-view"><text class="ui-text money">{{item.priceText}}</text><text class="ui-text">× {{item.quantity}}</text></view></view><view class="ui-view amount-line"><text class="ui-text">商品小计</text><text class="ui-text money">{{total}}</text></view><view class="ui-view amount-line"><text class="ui-text">集中配送</text><text class="ui-text">按团期统一安排</text></view></view><view class="ui-view rule-card"><text class="ui-text">成团说明</text><text class="ui-text">{{unformedRuleText}}</text></view><view class="ui-view checkout-bar"><view class="ui-view"><text class="ui-text">合计</text><text class="ui-text money">{{total}}</text></view><button class="ui-button {{submitting ? 'ui-disabled' : ''}} primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitOrder">{{submitting ? '正在下单' : '确认并支付'}}</button></view></block>
</view>
