<view class="checkout">
  <view wx:if="{{loading}}" class="rule-card">正在核对商品、库存和收货区域…</view>
  <view wx:elif="{{error}}" class="rule-card checkout-error"><text>暂时不能结算</text><text>{{error}}</text><button class="secondary-button" bindtap="loadCheckout">重新核对</button></view>
  <block wx:else><view class="pickup-card" bindtap="openPickup"><text class="section-label">固定自提点</text><text class="pickup-card__name">{{pickupPoint.name}}</text><text class="pickup-card__address">{{pickupPoint.address}}</text><text class="pickup-card__change">更换 ›</text></view><view class="order-card"><view class="order-card__merchant">{{draft.campaignTitle}}</view><view wx:for="{{items}}" wx:key="skuId" class="order-card__goods"><image class="order-card__image" src="{{item.imageUrl || '/assets/product-rice-noodles.jpg'}}" mode="aspectFill"/><view><text>{{item.title}}</text><text>{{item.skuName}}</text></view><view><text class="money">{{item.priceText}}</text><text>× {{item.quantity}}</text></view></view><view class="amount-line"><text>商品小计</text><text class="money">{{total}}</text></view><view class="amount-line"><text>集中配送</text><text>按团期统一安排</text></view></view><view class="rule-card"><text>成团说明</text><text>平台统一截单、备货并人工预约车辆配送；未达到成团门槛将按规则原路退款。</text></view><view class="checkout-bar"><view><text>合计</text><text class="money">{{total}}</text></view><button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitOrder">{{submitting ? '正在下单' : '确认并支付'}}</button></view></block>
</view>
