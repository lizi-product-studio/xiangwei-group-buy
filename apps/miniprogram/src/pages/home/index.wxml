<view class="ui-view home">
  <view class="ui-view home-hero">
    <view class="home-safe-top" style="height: {{statusBarHeight}}px"></view>
    <view class="home-brand" style="padding-right: {{menuReserveWidth}}px"><text class="ui-text home-brand__name">乡味集</text><text class="ui-text home-brand__slogan">附近好味道 · 一起带回家</text></view>
    <view class="pickup-card" bindtap="openPickup">
      <view class="pickup-card__copy"><text class="ui-text pickup-card__eyebrow">当前固定自提点</text><text class="ui-text pickup-card__name">{{pickupPoint ? pickupPoint.name : '选择固定自提点'}}<text class="pickup-card__chevron">›</text></text><text class="ui-text pickup-card__address">{{pickupPoint ? pickupPoint.address : '选择附近真实自提点，查看本期好物'}}</text></view>
      <view wx:if="{{pickupPoint && pickupPoint.photoUrl}}" class="pickup-photo"><product-image src="{{pickupPoint.photoUrl}}" image-mode="aspectFill" label="自提点照片" /></view>
      <view wx:elif="{{pickupPoint}}" class="pickup-photo pickup-photo--empty"><text>暂无点位照片</text></view>
      <view wx:else class="pickup-photo pickup-photo--empty"><text>先选点位</text></view>
    </view>
  </view>

  <view class="ui-view home-content">
    <view class="home-feature">
      <swiper wx:if="{{banners.length}}" class="home-banner" autoplay="{{banners.length > 1}}" circular="{{banners.length > 1}}" indicator-dots="{{banners.length > 1}}" interval="5000">
        <swiper-item wx:for="{{banners}}" wx:key="id"><view class="home-banner__item" data-index="{{index}}" bindtap="openBanner"><image class="home-banner__image" src="{{item.imageUrl}}" mode="aspectFill"/><view class="home-banner__copy"><text class="ui-text home-banner__title">{{item.title}}</text><text wx:if="{{item.subtitle}}" class="ui-text home-banner__subtitle">{{item.subtitle}}</text></view></view></swiper-item>
      </swiper>
      <view wx:else class="origin-story"><image class="origin-story__image" src="/assets/hero-sorghum-field.jpg" mode="aspectFill"/><view class="origin-story__cover"><text class="ui-text origin-story__title">时令之味，一起带回家</text><text class="ui-text origin-story__note">附近自提 · 按团集中到货</text></view></view>
      <view class="feature-info">
        <view wx:if="{{heroCampaign}}" class="feature-campaign">
          <view class="feature-campaign__heading"><text class="ui-text feature-campaign__title">{{heroCampaign.title}}</text><text class="ui-text feature-campaign__badge">正在收单</text></view>
          <view class="feature-campaign__facts"><view><text class="ui-text feature-campaign__label">距截单</text><text class="ui-text feature-campaign__countdown">{{countdownText}}</text></view><view class="feature-campaign__arrival"><text class="ui-text feature-campaign__label">截单 {{heroCampaign.cutoffText}}</text><text class="ui-text feature-campaign__date">预计到货 {{heroCampaign.arrivalText}}</text></view></view>
        </view>
        <view wx:else class="feature-campaign feature-campaign--empty"><text class="ui-text feature-campaign__title">{{pickupPoint ? '本期团购筹备中' : '选择固定自提点，看看附近团购'}}</text><text class="ui-text feature-campaign__date">{{pickupPoint ? '开团后会显示真实截单与到货安排' : '可选点位和商品以当前服务区域为准'}}</text></view>
        <subscription-reminder class="home-reminder" />
      </view>
    </view>

    <view wx:if="{{allProducts.length}}" class="category-grid" aria-label="商品分类">
      <view wx:for="{{categoryItems}}" wx:key="value" class="category-tile {{activeCategory === item.value ? 'category-tile--active' : ''}}" data-category="{{item.value}}" bindtap="changeCategory">
        <view class="category-tile__icon"><image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFit"/><text wx:else>{{item.fallback}}</text></view><text class="ui-text category-tile__label">{{item.label}}</text>
      </view>
    </view>
    <view class="shopping-heading"><text class="ui-text shopping-heading__title">正在团购</text><text class="ui-text shopping-heading__note">本期商品 · 固定自提点领取</text></view>
    <view class="home-search"><text class="search-mark">⌕</text><input value="{{searchQuery}}" placeholder="搜索本期商品" confirm-type="search" bindinput="onSearchInput"/><text wx:if="{{searchQuery}}" class="home-search__clear" catchtap="clearSearch">×</text></view>

    <view wx:if="{{loading}}" class="state-card"><text class="state-card__title">正在准备本期好物…</text></view>
    <view wx:elif="{{error}}" class="state-card state-card--error"><text class="state-card__title">暂时加载不了</text><text class="state-card__copy">{{error}}</text><button class="ui-button state-card__button" bindtap="loadCampaigns">重新加载</button></view>
    <view wx:elif="{{!availableAreaCount}}" class="state-card"><image class="state-card__icon" src="/assets/location-green.png" mode="aspectFit"/><text class="state-card__title">服务正在筹备中</text><text class="state-card__copy">暂时没有已开放的收货区域。留下开通意向，供我们安排后续服务。</text><button class="ui-button state-card__button" bindtap="openInterest">登记开通意向</button><button class="ui-button state-card__link" bindtap="openPickup">查看服务区域</button></view>
    <view wx:elif="{{!area || !pickupPoint}}" class="state-card"><image class="state-card__icon" src="/assets/location-green.png" mode="aspectFit"/><text class="state-card__title">好味道，从附近开始</text><text class="state-card__copy">选择已开放的收货区域与固定自提点，查看这期为你准备的家乡好物。</text><button class="ui-button state-card__button" bindtap="openPickup">选择收货区域</button></view>
    <view wx:elif="{{!allProducts.length}}" class="state-card"><text class="state-card__title">本期好物正在筹备</text><text class="state-card__copy">已为你记住{{pickupPoint.name}}。开团后，可以在这里查看本期商品。</text><button class="ui-button state-card__button" bindtap="openMessages">查看订单消息</button><button class="ui-button state-card__link" bindtap="openPickup">查看其他自提点</button></view>
    <view wx:elif="{{!campaigns.length}}" class="state-card"><text class="state-card__title">这个分类暂无商品</text><text class="state-card__copy">可以看看其他分类的本期好物。</text><button class="ui-button state-card__button" data-category="全部" bindtap="changeCategory">查看全部好物</button></view>

    <view class="campaign-list"><view wx:for="{{campaigns}}" wx:key="renderKey" class="product-card" data-id="{{item.id}}" data-sku="{{item.skuId}}" bindtap="openCampaign">
      <view class="product-card__photos product-card__photos--{{item.imageUrls.length}}">
        <view wx:if="{{!item.imageUrls.length}}" class="product-photo product-photo--empty"><product-image src="" label="商品图片暂缺" /></view>
        <view wx:elif="{{item.imageUrls.length === 1}}" class="product-photo product-photo--single"><product-image src="{{item.imageUrls[0]}}" refresh-key="{{imageRefreshKey}}" auto-aspect="{{true}}" image-mode="aspectFit" style="height:auto" label="{{item.productTitle}}商品图片" /></view>
        <block wx:else><view wx:for="{{item.imageUrls}}" wx:for-item="imageUrl" wx:key="*this" class="product-photo"><product-image src="{{imageUrl}}" refresh-key="{{imageRefreshKey}}" image-mode="aspectFit" label="{{item.productTitle}}商品图片" /></view></block>
      </view>
      <view class="product-card__body"><view class="product-card__top"><text class="product-card__category">{{item.category}}</text><text wx:if="{{item.origin}}" class="product-card__tag">{{item.origin}}</text></view><text class="ui-text product-card__title">{{item.productTitle}}</text><text wx:if="{{item.description}}" class="ui-text product-card__desc">{{item.description}}</text><text wx:if="{{item.skuName}}" class="ui-text product-card__sku">规格 · {{item.skuName}}</text><view class="product-card__foot"><view class="product-card__price-copy"><text class="ui-text price"><text class="price__currency">¥</text>{{item.priceText}}</text><text class="ui-text price-note">已售 {{item.salesQuantity}} 件</text></view><button class="ui-button buy-button" catchtap="addToCart" data-key="{{item.renderKey}}">加入购物车</button></view></view>
      <view class="product-card__schedule"><text class="ui-text">截单 {{item.cutoffText}}</text><text class="ui-text">预计到货 {{item.arrivalText}}</text></view>
    </view></view>
    <view wx:if="{{cartCount > 0}}" class="cart-entry" bindtap="openCart"><text>查看购物车 · {{cartCount}} 件</text><text class="cart-entry__hint">本期商品统一结算 ›</text></view>
  </view>
</view>
