.home{min-height:100vh;padding-bottom:calc(145rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff8f4;color:#302622}
.home-hero{padding:0 28rpx 124rpx;background:linear-gradient(148deg,#f45d4a 0%,#e94338 68%,#d9362d 100%);color:#fff}
.home-safe-top{width:100%}
.home-brand{display:flex;align-items:baseline;gap:14rpx;box-sizing:border-box;min-width:0;padding-left:3rpx;padding-bottom:18rpx}
.home-brand__name{flex:none;font-size:34rpx;font-weight:800;letter-spacing:2rpx;line-height:1.35}
.home-brand__slogan{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:20rpx;color:#ffe9df}
.pickup-card{display:flex;align-items:center;gap:18rpx;min-width:0;padding:18rpx 4rpx 0 3rpx}
.pickup-card__copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:4rpx}
.pickup-card__eyebrow{font-size:21rpx;color:#ffe5dc}
.pickup-card__name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:36rpx;font-weight:800;line-height:1.35}
.pickup-card__chevron{padding-left:5rpx;font-size:40rpx;font-weight:400;vertical-align:-2rpx}
.pickup-card__address{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:21rpx;color:#fff0e9;line-height:1.45}
.pickup-photo{display:flex;align-items:center;justify-content:center;flex:none;width:112rpx;height:112rpx;overflow:hidden;border:3rpx solid rgba(255,255,255,.78);border-radius:50%;background:#fff2ea;box-sizing:border-box}
.pickup-photo--empty{padding:12rpx;text-align:center;color:#9d766a;font-size:18rpx;line-height:1.35}
.home-content{position:relative;margin-top:-96rpx;padding:0 24rpx}
.home-feature{overflow:hidden;border:1rpx solid #f0dfd8;border-radius:24rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(118,51,38,.12)}
.home-banner{display:block;width:100%;height:340rpx}
.home-banner__item{position:relative;width:100%;height:100%;overflow:hidden;background:#e9dfcc}
.home-banner__image,.origin-story__image{position:absolute;inset:0;width:100%;height:100%}
.home-banner__copy{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:70rpx 27rpx 27rpx;box-sizing:border-box;background:linear-gradient(180deg,transparent 32%,rgba(48,31,24,.65));color:#fff}
.home-banner__title,.home-banner__subtitle{display:block}
.home-banner__title{font-size:36rpx;font-weight:800;line-height:1.35}
.home-banner__subtitle{margin-top:6rpx;font-size:22rpx;line-height:1.5}
.origin-story{position:relative;height:340rpx;overflow:hidden;background:#e7ddc9}
.origin-story__cover{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;box-sizing:border-box;padding:25rpx 28rpx;background:linear-gradient(90deg,rgba(53,42,29,.48),rgba(53,42,29,.02)),linear-gradient(0deg,rgba(42,34,22,.48),transparent 65%);color:#fff}
.origin-story__title{font-size:36rpx;line-height:1.38;font-weight:800}
.origin-story__note{margin-top:7rpx;font-size:22rpx}
.feature-info{padding:20rpx 22rpx 2rpx}
.feature-campaign{display:flex;flex-direction:column;gap:12rpx}
.feature-campaign__heading{display:flex;align-items:center;justify-content:space-between;gap:10rpx}
.feature-campaign__title{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#302622;font-size:29rpx;font-weight:750}
.feature-campaign__badge{flex:none;padding:6rpx 12rpx;border-radius:24rpx;background:#fff0e9;color:#db4a3b;font-size:19rpx;font-weight:650}
.feature-campaign__facts{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:13rpx 15rpx;border-radius:15rpx;background:#fff8f4}
.feature-campaign__facts>view{min-width:0;display:flex;flex-direction:column;gap:5rpx}
.feature-campaign__label{color:#9c8175;font-size:19rpx}
.feature-campaign__countdown{color:#d94335;font-size:30rpx;font-weight:800;font-variant-numeric:tabular-nums}
.feature-campaign__arrival{align-items:flex-end;text-align:right}
.feature-campaign__date{color:#785e53;font-size:20rpx;line-height:1.5}
.feature-campaign--empty{gap:5rpx;padding:8rpx 2rpx}
.home-reminder{margin-top:8rpx}
.category-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:19rpx 4rpx;margin-top:20rpx;padding:22rpx 9rpx 18rpx;border:1rpx solid #f0e5df;border-radius:21rpx;background:#fff}
.category-tile{display:flex;min-width:0;flex-direction:column;align-items:center;gap:8rpx;padding:0;border:0;background:transparent;color:#51443f;font-size:20rpx}
.category-tile__icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;overflow:hidden;border-radius:24rpx;background:#fff0e9;color:#cf5949;font-size:31rpx;font-weight:750}
.category-tile:nth-child(3n) .category-tile__icon{background:#eef4e7}
.category-tile:nth-child(4n) .category-tile__icon{background:#fff4dc}
.category-tile__icon image{display:block;width:51rpx;height:51rpx}
.category-tile__label{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center;font-size:20rpx}
.category-tile--active .category-tile__icon{box-shadow:inset 0 0 0 2rpx #e75545}
.category-tile--active .category-tile__label{color:#d74739;font-weight:750}
.shopping-heading{display:flex;flex-direction:column;align-items:center;gap:5rpx;margin:27rpx 0 16rpx;text-align:center}
.shopping-heading__title{color:#362a25;font-size:34rpx;font-weight:800;letter-spacing:2rpx}
.shopping-heading__note{color:#a28b80;font-size:20rpx}
.home-search{display:flex;align-items:center;height:76rpx;padding:0 23rpx;margin-bottom:18rpx;border:1rpx solid #eee4df;border-radius:40rpx;background:#fff;box-shadow:0 4rpx 14rpx rgba(84,47,35,.04)}
.search-mark{margin-right:12rpx;color:#b79e93;font-size:41rpx;line-height:1;transform:rotate(-18deg)}
.home-search input{flex:1;min-width:0;color:#302622;font-size:25rpx}
.home-search__clear{width:40rpx;height:40rpx;color:#998a85;font-size:38rpx;line-height:34rpx;text-align:center}
.state-card{display:flex;flex-direction:column;align-items:center;margin:19rpx 0;padding:43rpx 27rpx;text-align:center;border:1rpx solid #f1e4de;border-radius:23rpx;background:#fff}
.state-card__icon{width:72rpx;height:72rpx;margin-bottom:20rpx}
.state-card__title{display:block;color:#392e2a;font-size:29rpx;font-weight:700}
.state-card__copy{display:block;margin-top:12rpx;color:#8c7a73;font-size:23rpx;line-height:1.75}
.home .state-card__button{display:block;box-sizing:border-box;width:100%!important;max-width:450rpx;min-width:0;margin:24rpx 0 0!important;padding:18rpx 24rpx!important;border-radius:17rpx;background:#e85040;color:#fff;font-size:25rpx;line-height:1.5;font-weight:650}
.home .state-card__link{display:block;width:100%!important;margin:12rpx 0 0!important;padding:13rpx 0!important;background:transparent;color:#d65c4e;font-size:23rpx}
.state-card--error{border-color:#edbcb1}
.campaign-list{display:grid;grid-template-columns:minmax(0,1fr);gap:17rpx}
.product-card{overflow:hidden;border:1rpx solid #f0e6e1;border-radius:22rpx;background:#fff;box-shadow:0 5rpx 18rpx rgba(86,48,37,.045)}
.product-card__photos{overflow:hidden;background:#f5efec}
.product-photo{display:block;min-width:0;aspect-ratio:1/1;overflow:hidden;background:#f0e9e5}
.product-photo--empty{aspect-ratio:1.65/1}
.product-photo--single{position:relative;height:auto;aspect-ratio:auto}
.product-photo__count{position:absolute;right:16rpx;bottom:16rpx;padding:7rpx 13rpx;border-radius:99rpx;background:rgba(38,34,31,.72);color:#fff;font-size:20rpx;line-height:1.3}
.product-card__body{padding:16rpx 19rpx 0}
.product-card__top{display:flex;align-items:center;justify-content:space-between;gap:8rpx}
.product-card__tag,.product-card__category{max-width:55%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:19rpx}
.product-card__tag{color:#d85646}
.product-card__category{color:#998178}
.product-card__title{display:block;margin-top:8rpx;color:#302622;font-size:30rpx;font-weight:750;line-height:1.4}
.product-card__desc,.product-card__sku{display:block;margin-top:5rpx;color:#80756f;font-size:22rpx;line-height:1.55}
.product-card__sku{margin-top:3rpx;color:#a0928c;font-size:20rpx}
.product-card__foot{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:13rpx;padding-bottom:15rpx}
.product-card__price-copy{display:flex;flex:1;min-width:0;flex-direction:column;align-items:flex-start}
.product-card__foot .price{display:block;max-width:100%;color:#e54b3e;font-size:39rpx;font-weight:800;font-variant-numeric:tabular-nums;line-height:1.1;overflow-wrap:anywhere}
.price__currency{font-size:24rpx}
.price-note{display:block;margin-top:3rpx;color:#a5948d;font-size:19rpx}
.home .buy-button{display:flex;flex:none;align-items:center;justify-content:center;box-sizing:border-box;width:auto!important;max-width:210rpx;min-width:168rpx;min-height:66rpx;margin:0!important;padding:12rpx 18rpx!important;border:0;border-radius:34rpx;background:#e95545;color:#fff;font-size:22rpx;font-weight:700;line-height:1.3;white-space:nowrap}
.home .buy-button:after{border:0}
.product-card__schedule{display:flex;flex-wrap:wrap;justify-content:space-between;gap:5rpx 15rpx;margin:0;padding:12rpx 19rpx;border-top:1rpx solid #f0e8e3;background:#fffdfa;color:#9d705e;font-size:19rpx;line-height:1.45}
.cart-entry{position:fixed;z-index:8;right:24rpx;bottom:calc(19rpx + env(safe-area-inset-bottom));left:24rpx;display:flex;justify-content:space-between;gap:12rpx;padding:22rpx 25rpx;border-radius:21rpx;background:#e54c3f;color:#fff;box-shadow:0 7rpx 20rpx rgba(206,57,44,.25);font-size:23rpx}
.cart-entry__hint{color:#ffe5df;font-size:20rpx}
@media(max-width:350px){.home-hero{padding-right:21rpx;padding-left:21rpx}.home-brand{gap:8rpx}.home-brand__name{font-size:31rpx}.home-brand__slogan{font-size:18rpx}.pickup-card{gap:12rpx}.pickup-card__name{font-size:30rpx}.pickup-photo{width:96rpx;height:96rpx}.home-content{padding-right:17rpx;padding-left:17rpx}.category-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.category-tile__icon{width:68rpx;height:68rpx}.product-card__body{padding-right:14rpx;padding-left:14rpx}.product-card__title{font-size:27rpx}.home .buy-button{min-width:148rpx;padding-right:12rpx!important;padding-left:12rpx!important;font-size:20rpx}.product-card__schedule{padding-right:14rpx;padding-left:14rpx;font-size:17rpx}}
