.home { padding: 36rpx 40rpx calc(200rpx + env(safe-area-inset-bottom)); background: #faf8f2; min-height: 100vh; box-sizing: border-box; }
.home-header { margin-bottom: 36rpx; }.location__label,.location__name,.location__note { display:block; }.location__label { color:#818780;font-size:24rpx; }.location__name { margin-top:8rpx;font-size:32rpx;font-weight:650;color:#23312d; }.location__note { margin-top:6rpx;font-size:24rpx;color:#818780;line-height:1.5; }
.origin-story { height:270rpx;position:relative;overflow:hidden;border-radius:24rpx;margin-bottom:36rpx; }.origin-story__image { width:100%;height:100%; }.origin-story__cover { position:absolute;left:0;top:0;bottom:0;width:62%;box-sizing:border-box;padding:34rpx;background:rgba(255,254,250,.7);display:flex;flex-direction:column;justify-content:center; }.origin-story__title { white-space:pre-line;font-size:36rpx;line-height:1.5;font-weight:650; }.origin-story__note { margin-top:12rpx;font-size:22rpx;color:#597a43; }
.section-head { display:flex;justify-content:space-between;gap:18rpx;align-items:center;margin:28rpx 0 22rpx; }.section-head__title {display:block;font-size:38rpx;font-weight:700;}.section-head__count {display:block;margin-top:8rpx;font-size:24rpx;color:#818780;line-height:1.5;}.section-head__rule {flex:none;color:#597a43;font-size:24rpx;}
.benefit-row {display:flex;gap:12rpx;flex-wrap:wrap;margin:0 0 24rpx;}.benefit-row__item {padding:12rpx 22rpx;border:1rpx solid #e9e7df;border-radius:40rpx;background:#fffefa;font-size:24rpx;color:#697269;}.benefit-row__item--active {color:#f05232;border-color:#efab99;background:#fff0e9;}
.state-card {display:flex;flex-direction:column;align-items:center;padding:54rpx 30rpx;text-align:center;background:#fffefa;border:1rpx solid #e9e7df;border-radius:24rpx;}.state-card__icon {width:76rpx;height:76rpx;margin-bottom:26rpx;}.state-card__title {display:block;font-size:30rpx;font-weight:650;color:#23312d;}.state-card__copy {display:block;margin-top:14rpx;color:#818780;font-size:26rpx;line-height:1.8;}.home .state-card__button {display:block;box-sizing:border-box;width:100%!important;max-width:460rpx;min-width:0;margin:30rpx 0 0!important;padding:20rpx 24rpx!important;background:#f05232;color:#fff;border-radius:18rpx;font-size:28rpx;line-height:1.5;font-weight:650;}.home .state-card__link {display:block;width:100%!important;margin:16rpx 0 0!important;padding:14rpx 0!important;color:#597a43;background:transparent;font-size:24rpx;}.state-card--error {border-color:#edcbbf;}
.campaign-list {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;}.product-card {overflow:hidden;border:1rpx solid #e9e7df;border-radius:22rpx;background:#fffefa;}.product-card__media {position:relative;height:240rpx;}.product-card__image {width:100%;height:100%;}.product-card__tag {position:absolute;left:12rpx;top:12rpx;background:rgba(35,49,45,.75);color:#fff;padding:5rpx 10rpx;border-radius:8rpx;font-size:20rpx;}.product-card__body {padding:20rpx;}.product-card__title {display:block;font-size:28rpx;font-weight:650;line-height:1.5;}.product-card__desc,.product-card__schedule {display:block;margin-top:8rpx;font-size:22rpx;color:#818780;line-height:1.5;}.product-card__foot {display:flex;justify-content:space-between;align-items:center;margin-top:20rpx;}.price {color:#f05232;font-size:36rpx;font-weight:700;}.price__currency {font-size:24rpx;}.price-note {display:block;color:#818780;font-size:20rpx;}.buy-button {display:flex;align-items:center;justify-content:center;background:#f05232;color:#fff;border-radius:50%;width:50rpx;height:50rpx;font-size:36rpx;}.cart-entry {position:fixed;z-index:8;bottom:calc(30rpx + env(safe-area-inset-bottom));left:32rpx;right:32rpx;padding:24rpx;background:#f05232;border-radius:20rpx;color:#fff;display:flex;justify-content:space-between;gap:20rpx;font-size:26rpx;}.cart-entry__hint {font-size:22rpx;color:#ffe7df;}
