.home { position: relative; padding: 0 24rpx calc(230rpx + env(safe-area-inset-bottom)); overflow: hidden; background: #faf9f4; }.home__gate { position: absolute; top: 0; right: -56rpx; width: 525rpx; height: 280rpx; opacity: .82; }
.home-header { position: relative; z-index: 1; padding: 34rpx 16rpx 10rpx; }.location__label,.location__name { display: block; }.location__label { color: #17263a; font-size: 38rpx; font-weight: 800; letter-spacing: -.03em; }.location__name { margin-top: 13rpx; color: #2f3c4b; font-size: 27rpx; }
.campaign-intro { position: relative; z-index: 1; padding: 50rpx 16rpx 28rpx; }.campaign-intro__title { display: block; color: #17263a; font-family: STKaiti, KaiTi, serif; font-size: 76rpx; font-weight: 700; letter-spacing: .02em; }.campaign-intro__meta,.campaign-intro__promise { display: flex; align-items: center; gap: 10rpx; margin-top: 22rpx; color: #516b39; font-size: 29rpx; }.campaign-intro__calendar { color: #17263a; font-size: 34rpx; }.campaign-intro__promise { margin-top: 15rpx; color: #6f756e; font-size: 24rpx; }.campaign-intro__check { color: #547b36; font-size: 30rpx; }
.benefit-row { display: grid; grid-auto-columns: 1fr; grid-auto-flow: column; margin: 0 0 30rpx; padding: 20rpx 6rpx; background: #fffefb; border: 1rpx solid #eeebe4; border-radius: 24rpx; box-shadow: 0 10rpx 28rpx rgba(68, 56, 39, .045); }.benefit-row__item { display: grid; justify-items: center; gap: 8rpx; min-width: 0; padding: 0 3rpx; color: #27313c; font-size: 18rpx; }.benefit-row__icon { width: 52rpx; height: 52rpx; }.benefit-row__item--active { color: #547b36; font-weight: 700; }
.origin-story { position: relative; height: 318rpx; overflow: hidden; border-radius: 26rpx; background: #e8e4d7; }.origin-story__image { width: 100%; height: 100%; }.origin-story__cover { position: absolute; top: 0; bottom: 0; left: 0; display: flex; width: 59%; flex-direction: column; align-items: flex-start; justify-content: center; padding: 34rpx; background: rgba(255,253,247,.73); }.origin-story__eyebrow { color: #17263a; font-family: STKaiti, KaiTi, serif; font-size: 37rpx; font-weight: 700; }.origin-story__title { max-width: 350rpx; margin-top: 8rpx; color: #17263a; font-family: STKaiti, KaiTi, serif; font-size: 38rpx; font-weight: 700; line-height: 1.25; }.origin-story__rule { width: 48rpx; height: 5rpx; margin: 18rpx 0; background: #547b36; border-radius: 5rpx; }.origin-story__note { color: #39433c; font-size: 21rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 35rpx 6rpx 18rpx; }.section-head__title { display: block; color: #17263a; font-size: 36rpx; font-weight: 800; }.section-head__count { display: block; margin-top: 7rpx; color: #8d918c; font-size: 19rpx; }.section-head__rule { color: #547b36; font-size: 20rpx; }
.campaign-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }.product-card { overflow: hidden; background: #fffefb; border: 1rpx solid #eeebe4; border-radius: 20rpx; box-shadow: 0 8rpx 20rpx rgba(60, 50, 34,.035); }.product-card__media { position: relative; height: 222rpx; background: #eee; }.product-card__image { width: 100%; height: 100%; }.product-card__tag { position: absolute; top: 12rpx; left: 12rpx; padding: 6rpx 9rpx; color: #fff; background: rgba(23, 38, 58,.75); border-radius: 7rpx; font-size: 16rpx; }.product-card__body { padding: 18rpx 18rpx 19rpx; }.product-card__title { display: block; overflow: hidden; color: #17263a; font-size: 27rpx; font-weight: 800; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }.product-card__desc { display: block; overflow: hidden; margin-top: 7rpx; color: #8b8e8a; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.product-card__foot { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 18rpx; }.price { color: #f05232; font-size: 35rpx; font-weight: 800; }.price__currency { margin-right: 2rpx; font-size: 20rpx; }.price-note { display: block; margin-top: 2rpx; color: #9da19d; font-size: 16rpx; }.buy-button { display: grid; width: 45rpx; height: 45rpx; place-items: center; color: #fff; background: #f05232; border-radius: 50%; font-size: 37rpx; font-weight: 400; line-height: 1; }.state-card { padding: 70rpx 30rpx; text-align: center; color: #7f858e; background: #fffefb; border: 1rpx solid #eeebe4; border-radius: 20rpx; font-size: 23rpx; }.state-card--error { color: #b1432d; }
.cart-entry { position: fixed; z-index: 8; right: 28rpx; bottom: calc(112rpx + env(safe-area-inset-bottom)); left: 28rpx; display: flex; justify-content: space-between; padding: 26rpx 28rpx; color: #fff; background: #f05232; border-radius: 40rpx; box-shadow: 0 12rpx 24rpx rgba(240,82,50,.17); font-size: 24rpx; font-weight: 700; }.cart-entry__hint { color: #ffe1d8; font-size: 20rpx; font-weight: 500; }.product-card__schedule { display: block; margin-top: 7rpx; color: #777e87; font-size: 17rpx; line-height: 1.35; }
