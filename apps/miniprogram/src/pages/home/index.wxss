.home { padding: 32rpx 32rpx calc(200rpx + env(safe-area-inset-bottom)); background: #faf8f2; min-height: 100vh; box-sizing: border-box; }
.home-header { margin-bottom: 36rpx; }.location__label,.location__name,.location__note { display:block; }.location__label { color:#626c60;font-size:24rpx; }.location__name { margin-top:8rpx;font-size:32rpx;font-weight:650;color:#23312d; }.location__note { margin-top:6rpx;font-size:24rpx;color:#626c60;line-height:1.5; }
.home-banner { height: 260rpx; margin-bottom: 28rpx; border-radius: 28rpx; overflow: hidden; }.home-banner__item { position:relative; width:100%; height:100%; overflow:hidden; border-radius:28rpx; background:#e7eadf; }.home-banner__image { width:100%; height:100%; }.home-banner__copy { position:absolute; left:0; right:0; bottom:0; padding:48rpx 28rpx 22rpx; background:linear-gradient(transparent,rgba(20,35,28,.72)); color:#fff; }.home-banner__title,.home-banner__subtitle { display:block; }.home-banner__title { font-size:34rpx; font-weight:700; }.home-banner__subtitle { margin-top:6rpx; font-size:22rpx; opacity:.9; }
.origin-story { height:296rpx;position:relative;overflow:hidden;border-radius:32rpx;margin-bottom:36rpx; }.origin-story__image { width:100%;height:100%; }.origin-story__cover { position:absolute;inset:0;box-sizing:border-box;padding:40rpx 32rpx;background:linear-gradient(90deg,rgba(255,254,250,.82),rgba(255,254,250,.12));display:flex;flex-direction:column;justify-content:center; }.origin-story__title { white-space:pre-line;font-size:44rpx;line-height:1.4;font-weight:700; }.origin-story__note { margin-top:16rpx;font-size:28rpx;font-weight:650;color:#c2412d; }
.section-head { display:flex;justify-content:space-between;gap:18rpx;align-items:center;margin:28rpx 0 22rpx; }.section-head__title {display:block;font-size:38rpx;font-weight:700;}.section-head__count {display:block;margin-top:8rpx;font-size:24rpx;color:#626c60;line-height:1.5;}.section-head__rule {flex:none;color:#3f6b35;font-size:24rpx;}
.home-search{display:flex;align-items:center;margin:0 0 20rpx;padding:0 24rpx;height:76rpx;background:#fffefa;border:1rpx solid #e6e3d8;border-radius:38rpx}.home-search input{flex:1;min-width:0;font-size:26rpx;color:#23312d}.home-search__clear{width:40rpx;height:40rpx;text-align:center;color:#697269;font-size:38rpx;line-height:34rpx}
.benefit-row {display:flex;gap:12rpx;flex-wrap:wrap;margin:0 0 24rpx;}.benefit-row__item {padding:12rpx 22rpx;border:1rpx solid #e9e7df;border-radius:40rpx;background:#fffefa;font-size:24rpx;color:#697269;}.benefit-row__item--active {color:#c2412d;border-color:#efab99;background:#fff0e9;}
.state-card {display:flex;flex-direction:column;align-items:center;padding:54rpx 30rpx;text-align:center;background:#fffefa;border:1rpx solid #e9e7df;border-radius:24rpx;}.state-card__icon {width:76rpx;height:76rpx;margin-bottom:26rpx;}.state-card__title {display:block;font-size:30rpx;font-weight:650;color:#23312d;}.state-card__copy {display:block;margin-top:14rpx;color:#626c60;font-size:26rpx;line-height:1.8;}.home .state-card__button {display:block;box-sizing:border-box;width:100%!important;max-width:460rpx;min-width:0;margin:30rpx 0 0!important;padding:20rpx 24rpx!important;background:#c2412d;color:#fff;border-radius:18rpx;font-size:28rpx;line-height:1.5;font-weight:650;}.home .state-card__link {display:block;width:100%!important;margin:16rpx 0 0!important;padding:14rpx 0!important;color:#3f6b35;background:transparent;font-size:24rpx;}.state-card--error {border-color:#edcbbf;}
.campaign-list {display:grid;grid-template-columns:1fr;gap:20rpx;}.product-card {overflow:hidden;border:1rpx solid #e9e7df;border-radius:28rpx;background:#fffefa;}.product-card__media {position:relative;height:300rpx;background:#f4f1e9;}.product-card__image {width:100%;height:100%;}.product-card__tag {position:absolute;left:16rpx;top:16rpx;background:rgba(35,49,45,.75);color:#fff;padding:4rpx 14rpx;border-radius:12rpx;font-size:22rpx;}.product-card__body {padding:20rpx;}.product-card__title {display:block;font-size:30rpx;font-weight:700;line-height:1.4;}.product-card__desc,.product-card__schedule {display:block;margin-top:8rpx;font-size:24rpx;color:#626c60;line-height:1.45;}.product-card__foot {display:flex;justify-content:space-between;align-items:center;margin-top:20rpx;}.price {color:#c2412d;font-size:40rpx;font-weight:750;}.price__currency {font-size:28rpx;}.price-note {display:block;color:#626c60;font-size:22rpx;}.product-card__foot .buy-button {display:flex;flex:0 0 64rpx;align-items:center;justify-content:center;box-sizing:border-box;width:64rpx;min-width:64rpx;max-width:64rpx;height:64rpx;min-height:64rpx;max-height:64rpx;background:#c2412d;color:#fff;border-radius:50%;}.product-card__foot .buy-button .ui-text {color:#fff;font-size:38rpx;font-weight:400;line-height:1;transform:translateY(-1rpx);}.cart-entry {position:fixed;z-index:8;bottom:calc(30rpx + env(safe-area-inset-bottom));left:32rpx;right:32rpx;padding:28rpx 32rpx;background:#c2412d;border-radius:28rpx;color:#fff;display:flex;justify-content:space-between;gap:20rpx;font-size:26rpx;}.cart-entry__hint {font-size:24rpx;color:#ffe7df;}

.home-header { display: flex; align-items: center; gap: 20rpx; }
.home-header .location { min-width: 0; flex: 1; }
.pickup-photo { width: 112rpx; height: 112rpx; flex: none; border-radius: 16rpx; overflow: hidden; }
