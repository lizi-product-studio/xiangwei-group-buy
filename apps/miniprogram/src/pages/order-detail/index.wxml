<view class="ui-view order-detail">
  <view wx:if="{{loading}}" class="ui-view detail-state">正在加载订单…</view>
  <view wx:elif="{{error}}" class="ui-view detail-state detail-state--error"><text class="ui-text">{{error}}</text><button class="ui-button" wx:if="{{error === '登录后可查看订单详情'}}" size="mini" bindtap="openLogin">手机号快捷登录</button><button class="ui-button" wx:else size="mini" bindtap="retryLoad">重新加载</button></view>
  <block wx:else>
    <view class="ui-view status-card tone-{{order.statusTone}}"><text class="ui-text">{{order.statusText}}</text><text class="ui-text">{{order.statusHint}}</text><view wx:if="{{order.status === 'PENDING_PAYMENT'}}" class="ui-view payment-deadline"><text class="ui-text">支付截止：{{paymentDeadlineText}}</text><text class="ui-text">{{paymentCountdownText}}</text><button wx:if="{{!order.canPay}}" class="ui-button ghost-button" loading="{{statusCheckLoading}}" disabled="{{statusCheckLoading}}" bindtap="refreshPaymentStateAfterExpiry">刷新支付状态</button></view><text class="ui-text">订单号：{{order.orderNo}}</text></view>
    <view wx:if="{{order.checkoutBatch && order.checkoutBatch.orderCount > 1}}" class="ui-view detail-card exception-summary">此单属于多点结算批次，共 {{order.checkoutBatch.orderCount}} 张订单；继续支付将一次支付整批，取消未付款订单也会取消整批。</view>
    <view class="ui-view detail-card pickup-info"><text class="ui-text">本团领取安排</text><text class="ui-text">{{order.deliveryName}}</text><text class="ui-text">{{order.deliveryAddress}}</text><text class="ui-text">{{order.deliveryTime}}</text><text class="ui-text">{{order.pickupDeadlineText}}</text><text class="ui-text" wx:if="{{order.pickupWindowText}}">{{order.pickupWindowText}}</text></view>
    <view wx:if="{{order.cancellationText}}" class="ui-view detail-card exception-summary">{{order.cancellationText}}</view>
    <view class="ui-view detail-card"><text class="ui-text detail-card__title">商品明细</text><view wx:for="{{order.itemViews}}" wx:key="skuId" class="ui-view detail-line"><view class="ui-view"><text class="ui-text">{{item.name}}</text><text class="ui-text">{{item.priceText}} × {{item.quantity}}</text><text class="ui-text">{{item.fulfillmentText}}</text><text wx:if="{{item.exceptionReasonText}}" class="ui-text exception-copy">{{item.exceptionReasonText}}</text><text wx:if="{{item.refundText}}" class="ui-text exception-copy">{{item.refundText}}</text></view><text class="ui-text money">{{item.amountText}}</text></view><view wx:if="{{order.fulfillmentExceptionHint}}" class="ui-view exception-summary">{{order.fulfillmentExceptionHint}}</view><view wx:if="{{order.partialRefundText}}" class="ui-view exception-summary">{{order.partialRefundText}}</view><view class="ui-view detail-total"><text class="ui-text">实付合计</text><text class="ui-text money">{{order.totalText}}</text></view></view>
    <view class="ui-view detail-card order-meta"><view class="ui-view"><text class="ui-text">下单时间</text><text class="ui-text">{{order.createdText}}</text></view><view class="ui-view"><text class="ui-text">领取方式</text><text class="ui-text">本团固定自提点领取</text></view></view>
    <view wx:if="{{order.afterSaleViews.length}}" class="ui-view detail-card after-sale-card"><text class="ui-text detail-card__title">售后进度</text><view wx:for="{{order.afterSaleViews}}" wx:key="id" class="ui-view after-sale-row"><view class="ui-view"><text class="ui-text">{{item.reason}}</text><text class="ui-text">{{item.createdText}}</text><text wx:if="{{item.decisionNote}}" class="ui-text exception-copy">决定说明：{{item.decisionNote}}</text><text wx:if="{{item.statusText === '已驳回'}}" class="ui-text exception-copy">如需了解，可通过“我的—帮助与客服”联系平台</text></view><text class="ui-text">{{item.statusText}}</text></view></view>
    <view wx:if="{{order.pickupReceiptViews.length}}" class="ui-view detail-card after-sale-card"><text class="ui-text detail-card__title">分次领取凭证</text><view wx:for="{{order.pickupReceiptViews}}" wx:key="id" class="ui-view receipt-row"><text class="ui-text">{{item.quantityText}}</text><text class="ui-text">{{item.pickedUpText}}</text><text class="ui-text">{{item.qualityDeadlineText}}</text></view></view>
    <view wx:if="{{order.canPay || order.canCancel || order.canPickup || order.canAfterSale}}" class="ui-view detail-actions"><button wx:if="{{order.canAfterSale && !order.canPay}}" class="ui-button secondary-button" bindtap="openAfterSale">申请已领取商品售后</button><view wx:if="{{order.canPay}}" class="ui-view payment-actions"><button class="ui-button {{cancelling ? 'ui-disabled' : ''}} secondary-button" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel">取消订单</button><button class="ui-button {{paying || cancelling ? 'ui-disabled' : ''}} primary-button" loading="{{paying}}" disabled="{{paying || cancelling}}" bindtap="pay">继续支付</button></view><button wx:if="{{order.canCancel && !order.canPay}}" class="ui-button {{cancelling ? 'ui-disabled' : ''}} secondary-button" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel">申请取消订单</button><button wx:if="{{order.canPickup}}" class="ui-button primary-button" bindtap="openPickupCode">领取剩余商品 / 查看取货码</button></view>
  </block>
</view>
