<view class="order-detail">
  <view wx:if="{{loading}}" class="detail-state">正在加载订单…</view>
  <view wx:elif="{{error}}" class="detail-state detail-state--error"><text>{{error}}</text><button wx:if="{{error === '登录后可查看订单详情'}}" size="mini" bindtap="openLogin">微信快捷登录</button><button wx:else size="mini" bindtap="loadOrder">重新加载</button></view>
  <block wx:else>
    <view class="status-card"><text>{{order.statusText}}</text><text>{{order.statusHint}}</text><text>订单号：{{order.orderNo}}</text></view>
    <view class="detail-card pickup-info"><text>本团领取安排</text><text>{{order.deliveryName}}</text><text>{{order.deliveryAddress}}</text><text>{{order.deliveryTime}}</text><text>{{order.pickupDeadlineText}}</text><text wx:if="{{order.pickupWindowText}}">{{order.pickupWindowText}}</text></view>
    <view wx:if="{{order.cancellationText}}" class="detail-card exception-summary">{{order.cancellationText}}</view>
    <view class="detail-card"><text class="detail-card__title">商品明细</text><view wx:for="{{order.itemViews}}" wx:key="skuId" class="detail-line"><view><text>{{item.name}}</text><text>{{item.priceText}} × {{item.quantity}}</text><text>{{item.fulfillmentText}}</text><text wx:if="{{item.exceptionReasonText}}" class="exception-copy">{{item.exceptionReasonText}}</text><text wx:if="{{item.refundText}}" class="exception-copy">{{item.refundText}}</text></view><text class="money">{{item.amountText}}</text></view><view wx:if="{{order.fulfillmentExceptionHint}}" class="exception-summary">{{order.fulfillmentExceptionHint}}</view><view wx:if="{{order.partialRefundText}}" class="exception-summary">{{order.partialRefundText}}</view><view class="detail-total"><text>实付合计</text><text class="money">{{order.totalText}}</text></view></view>
    <view class="detail-card order-meta"><view><text>下单时间</text><text>{{order.createdText}}</text></view><view><text>领取方式</text><text>本团固定自提点领取</text></view></view>
    <view wx:if="{{order.afterSaleViews.length}}" class="detail-card after-sale-card"><text class="detail-card__title">售后进度</text><view wx:for="{{order.afterSaleViews}}" wx:key="id" class="after-sale-row"><view><text>{{item.reason}}</text><text>{{item.createdText}}</text></view><text>{{item.statusText}}</text></view></view>
    <view wx:if="{{order.pickupReceiptViews.length}}" class="detail-card after-sale-card"><text class="detail-card__title">分次领取凭证</text><view wx:for="{{order.pickupReceiptViews}}" wx:key="id" class="receipt-row"><text>{{item.quantityText}}</text><text>{{item.pickedUpText}}</text><text>{{item.qualityDeadlineText}}</text></view></view>
    <view wx:if="{{order.canPay || order.canCancel || order.canPickup || order.canAfterSale}}" class="detail-actions"><button wx:if="{{order.canAfterSale && !order.canPay && !order.canPickup}}" class="secondary-button" bindtap="openAfterSale">申请售后</button><view wx:if="{{order.canPay}}" class="payment-actions"><button class="secondary-button" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel">取消订单</button><button class="primary-button" loading="{{paying}}" disabled="{{paying || cancelling}}" bindtap="pay">继续支付</button></view><button wx:if="{{order.canCancel && !order.canPay}}" class="secondary-button" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel">申请取消订单</button><button wx:if="{{order.canPickup}}" class="primary-button" bindtap="openPickupCode">查看取货码</button></view>
  </block>
</view>
