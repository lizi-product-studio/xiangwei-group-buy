.order-detail{padding:24rpx 24rpx 150rpx}.detail-state{margin-top:50rpx;padding:60rpx 24rpx;border-radius:22rpx;background:#fff;text-align:center;color:#7d848e}.detail-state .ui-text{display:block}.detail-state .ui-button{margin-top:20rpx}.detail-state--error{color:#b74330}.status-card{padding:34rpx;border-radius:26rpx;background:#23312d;color:#fff;display:flex;flex-direction:column}.status-card .ui-text:first-child{font-size:39rpx;font-weight:650}.status-card .ui-text:nth-child(2){margin-top:10rpx;color:#d4dbe6;font-size:23rpx}.status-card .ui-text:last-child{margin-top:24rpx;color:#96a3b7;font-size:24rpx}.detail-card{margin-top:18rpx;padding:26rpx;background:#fff;border:1rpx solid #e9e7df;border-radius:22rpx}.pickup-info{display:flex;flex-direction:column}.pickup-info .ui-text:first-child,.detail-card__title{color:#8b929b;font-size:24rpx}.pickup-info .ui-text:nth-child(2){margin-top:13rpx;font-size:29rpx;font-weight:650}.pickup-info .ui-text:last-child{margin-top:8rpx;color:#7f8690;font-size:24rpx}.detail-line{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #edf0f2}.detail-line>.ui-view{display:flex;flex-direction:column;gap:8rpx}.detail-line>.ui-view .ui-text:first-child{font-size:25rpx;font-weight:700}.detail-line>.ui-view .ui-text:last-child{color:#8b929a;font-size:24rpx}.detail-line>.money{font-size:25rpx}.exception-copy{color:#bd553e!important}.exception-summary{margin-top:18rpx;padding:16rpx;border-radius:14rpx;background:#fff4eb;color:#a64b34;font-size:22rpx}.detail-total{display:flex;justify-content:space-between;align-items:center;padding-top:24rpx}.detail-total .ui-text:first-child{font-size:23rpx;font-weight:700}.detail-total .money{color:#c2412d;font-size:34rpx}.order-meta .ui-view{display:flex;justify-content:space-between;padding:10rpx 0;font-size:24rpx}.order-meta .ui-view .ui-text:first-child{color:#8b929a}.after-sale-row{display:flex;align-items:center;justify-content:space-between;padding-top:20rpx;color:#d04d32;font-size:22rpx}.after-sale-row .ui-view{display:flex;flex-direction:column;gap:6rpx}.after-sale-row .ui-view .ui-text:first-child{color:#303b46;font-size:23rpx}.after-sale-row .ui-view .ui-text:last-child{color:#9299a1;font-size:24rpx}.detail-actions{position:fixed;left:0;right:0;bottom:0;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1rpx solid #e7e8eb}.detail-actions .ui-button{width:100%;margin:0}.payment-actions{display:flex;gap:16rpx}.payment-actions .ui-button{flex:1}.secondary-button{color:#cf492f;background:#fff1eb;border:1rpx solid #f4c5b8}

