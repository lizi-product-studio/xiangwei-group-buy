.payment-result{min-height:100vh;padding:34rpx 30rpx 48rpx;background:#fffaf7}.payment-result__loading{display:flex;align-items:center;justify-content:center;gap:16rpx;padding:170rpx 20rpx;color:#718073;font-size:26rpx}.payment-result__spinner{width:30rpx;height:30rpx;border:4rpx solid #e8eee5;border-top-color:#55915d;border-radius:50%;animation:payment-result-spin .8s linear infinite}@keyframes payment-result-spin{to{transform:rotate(360deg)}}
.payment-result__hero{display:flex;flex-direction:column;align-items:center;text-align:center;padding:24rpx 18rpx 34rpx}.payment-result__mark{display:flex;align-items:center;justify-content:center;width:112rpx;height:112rpx;border-radius:50%;margin-bottom:24rpx;background:#eaf4e8;color:#4c8656;font-size:54rpx;font-weight:800}.payment-result__hero.state-CHECKING .payment-result__mark,.payment-result__hero.state-UNAVAILABLE .payment-result__mark{background:#fff1df;color:#b7783d;font-size:42rpx}.payment-result__hero.state-FAILED .payment-result__mark,.payment-result__hero.state-CANCELLED .payment-result__mark,.payment-result__hero.state-CLOSED .payment-result__mark,.payment-result__hero.state-EXPIRED .payment-result__mark{background:#f4eee9;color:#a96555}.payment-result__title{font-size:38rpx;font-weight:750;color:#29372f}.payment-result__message{margin-top:14rpx;color:#7f8a80;font-size:25rpx;line-height:1.7}.payment-result__error{margin:0 2rpx 20rpx;padding:18rpx 20rpx;border-radius:12rpx;background:#fff1eb;color:#b54f3c;font-size:24rpx;line-height:1.6}
.payment-result__summary{padding:4rpx 24rpx 0;border:1rpx solid #eee5dc;border-radius:18rpx;background:#fff;box-shadow:0 5rpx 18rpx rgba(83,68,49,.05)}.payment-result__total{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;color:#778277;font-size:25rpx}.payment-result__total .money{color:#d44e3b;font-size:42rpx;font-weight:800}.payment-result__separator{height:1rpx;background:#f0ebe5}.payment-result__order{padding:22rpx 0;border-bottom:1rpx solid #f1ece6}.payment-result__order:last-child{border-bottom:0}.payment-result__order-heading,.payment-result__order-foot{display:flex;align-items:center;justify-content:space-between;color:#929b92;font-size:22rpx}.payment-result__point{display:block;margin-top:11rpx;color:#334339;font-size:28rpx;font-weight:700}.payment-result__address{display:block;margin-top:6rpx;color:#8d978e;font-size:22rpx;line-height:1.5}.payment-result__order-foot{margin-top:17rpx}.payment-result__detail-link{color:#bc604c}
.payment-result__hint{margin:20rpx 4rpx 0;padding:18rpx 20rpx;border-radius:12rpx;background:#f3f6ee;color:#657b63;font-size:23rpx;line-height:1.65}.payment-result__actions{gap:14rpx;margin-top:34rpx}.payment-result__actions .ui-button{width:100%;margin:0}.payment-result__actions .text-button{border:0;background:transparent;color:#808c81;font-size:24rpx}.payment-result__actions .secondary-button{background:#fff}
