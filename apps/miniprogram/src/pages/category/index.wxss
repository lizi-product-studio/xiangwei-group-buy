.category-page{min-height:100vh;box-sizing:border-box;padding:30rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));background:#faf8f2;color:#23312d}.category-head{padding:8rpx 12rpx 24rpx}.category-head__title{display:block;font-size:40rpx;font-weight:700}.category-head__note{display:block;margin-top:8rpx;color:#697269;font-size:24rpx}.category-layout{display:flex;min-height:calc(100vh - 160rpx);overflow:hidden;border:1rpx solid #e6e3d8;border-radius:24rpx;background:#fffefa}.category-nav{width:176rpx;flex:none;background:#f3f4ee}.category-nav__item{padding:28rpx 16rpx;text-align:center;color:#697269;font-size:26rpx;line-height:1.4}.category-nav__item--active{position:relative;color:#c2412d;background:#fffefa;font-weight:700}.category-nav__item--active:before{content:"";position:absolute;left:0;top:24rpx;bottom:24rpx;width:6rpx;background:#c2412d;border-radius:0 6rpx 6rpx 0}.category-products{flex:1;min-width:0;padding:18rpx}.category-product{display:flex;gap:18rpx;padding:18rpx 0;border-bottom:1rpx solid #ece9df}.category-product__image{width:190rpx;height:190rpx;flex:none;border-radius:18rpx;overflow:hidden}.category-product__content{min-width:0;display:flex;flex-direction:column;flex:1}.category-product__title{font-size:28rpx;font-weight:700;line-height:1.4}.category-product__sku,.category-product__arrival{display:block;margin-top:8rpx;color:#697269;font-size:22rpx;line-height:1.4}.category-product__foot{display:flex;justify-content:space-between;align-items:flex-end;margin-top:auto;padding-top:14rpx}.category-product__price{color:#c2412d;font-size:34rpx;font-weight:700}.category-product__add{display:flex;align-items:center;justify-content:center;width:168rpx;height:52rpx;margin:0;padding:0;border:0;border-radius:18rpx;background:#c2412d;color:#fff;font-size:22rpx;line-height:1}.category-product__add:after{border:0}.category-empty,.category-state{padding:90rpx 24rpx;text-align:center;color:#697269;font-size:26rpx;line-height:1.8}.category-state--error button{margin-top:26rpx;background:#c2412d;color:#fff;border-radius:18rpx}.category-cart{position:fixed;left:32rpx;right:32rpx;bottom:calc(28rpx + env(safe-area-inset-bottom));z-index:8;padding:26rpx 30rpx;border-radius:24rpx;background:#c2412d;color:#fff;display:flex;justify-content:space-between;font-size:26rpx}
