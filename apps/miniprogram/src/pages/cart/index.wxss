.cart-page{min-height:100vh;padding:24rpx 24rpx 180rpx;box-sizing:border-box}.cart-empty{margin-top:100rpx;display:flex;flex-direction:column;align-items:center;text-align:center;color:#8a9098}.cart-empty__mark{width:112rpx;height:112rpx;margin-bottom:28rpx;border-radius:34rpx;display:grid;place-items:center;background:#fff0eb;color:#e74d31;font-size:38rpx;font-weight:800}.cart-empty>text:nth-child(2){color:#252a31;font-size:32rpx;font-weight:750}.cart-empty>text:nth-child(3){margin-top:12rpx;font-size:22rpx}.cart-empty navigator{margin-top:30rpx;padding:18rpx 34rpx;border-radius:40rpx;background:#f05232;color:#fff;font-size:24rpx}.cart-context{display:flex;align-items:center;justify-content:space-between;padding:25rpx;background:#17263a;color:#fff;border-radius:24rpx}.cart-context view{display:flex;flex-direction:column;gap:8rpx}.cart-context view text:first-child{font-size:27rpx;font-weight:750}.cart-context view text:last-child{font-size:21rpx;color:#c9d1de}.cart-context>text{font-size:21rpx;color:#ffb7a5}.cart-warning{margin-top:16rpx;padding:18rpx 22rpx;border-radius:16rpx;background:#fff1df;color:#975c17;font-size:21rpx;line-height:1.5}.cart-list{margin-top:18rpx;display:grid;gap:14rpx}.cart-line{display:grid;grid-template-columns:130rpx 1fr auto;gap:20rpx;padding:22rpx;background:#fff;border:1rpx solid #ece9e1;border-radius:22rpx}.cart-line>image{width:130rpx;height:130rpx;border-radius:17rpx;background:#eee}.cart-line__copy{min-width:0;display:flex;flex-direction:column}.cart-line__copy>text:first-child{font-size:27rpx;font-weight:750}.cart-line__copy>text:nth-child(2){margin-top:8rpx;color:#8d939b;font-size:20rpx}.cart-line__copy .money{margin-top:auto;color:#ef4d31;font-size:29rpx}.cart-line__tools{display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between}.remove{color:#9b9fa6;font-size:20rpx}.qty{display:grid;grid-template-columns:52rpx 48rpx 52rpx;align-items:center;text-align:center;background:#faf9f4;border-radius:30rpx}.qty text:first-child,.qty text:last-child{color:#ef4d31;font-size:28rpx}.qty text:nth-child(2){font-size:22rpx}.cart-bar{position:fixed;z-index:5;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 300rpx;align-items:center;gap:20rpx;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1rpx solid #e7e8eb}.cart-bar>view{display:flex;flex-direction:column}.cart-bar>view>text:first-child{color:#858b94;font-size:20rpx}.cart-bar .money{margin-top:2rpx;color:#ef4d31;font-size:38rpx}.cart-bar button{width:100%;margin:0;font-size:25rpx}
