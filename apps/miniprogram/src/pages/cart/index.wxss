.cart-page{min-height:100vh;padding:24rpx 24rpx 180rpx;box-sizing:border-box}.cart-empty{margin-top:100rpx;display:flex;flex-direction:column;align-items:center;text-align:center;color:#8a9098}.cart-empty__mark{width:112rpx;height:112rpx;margin-bottom:28rpx;border-radius:34rpx;display:grid;place-items:center;background:#fff0eb;color:#e74d31;font-size:38rpx;font-weight:650}.cart-empty>.ui-text:nth-child(2){color:#252a31;font-size:32rpx;font-weight:650}.cart-empty>.ui-text:nth-child(3){margin-top:12rpx;font-size:22rpx}.cart-empty .ui-navigator{margin-top:30rpx;padding:18rpx 34rpx;border-radius:40rpx;background:#c2412d;color:#fff;font-size:24rpx}.cart-context{display:flex;align-items:center;justify-content:space-between;padding:25rpx;background:#23312d;color:#fff;border-radius:24rpx}.cart-context .ui-view{display:flex;flex-direction:column;gap:8rpx}.cart-context .ui-view .ui-text:first-child{font-size:27rpx;font-weight:650}.cart-context .ui-view .ui-text:last-child{font-size:24rpx;color:#c9d1de}.cart-context>.ui-text{font-size:24rpx;color:#ffb7a5}.cart-warning{margin-top:16rpx;padding:18rpx 22rpx;border-radius:16rpx;background:#fff1df;color:#975c17;font-size:24rpx;line-height:1.5}.cart-list{margin-top:18rpx;display:grid;gap:14rpx}.cart-line{display:grid;grid-template-columns:130rpx 1fr auto;gap:20rpx;padding:22rpx;background:#fff;border:1rpx solid #e9e7df;border-radius:22rpx}.cart-line>.ui-image{width:130rpx;height:130rpx;border-radius:17rpx;background:#eee}.cart-line__copy{min-width:0;display:flex;flex-direction:column}.cart-line__copy>.ui-text:first-child{font-size:27rpx;font-weight:650}.cart-line__copy>.ui-text:nth-child(2){margin-top:8rpx;color:#8d939b;font-size:24rpx}.cart-line__copy .money{margin-top:auto;color:#c2412d;font-size:29rpx}.cart-line__tools{display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between}.remove{color:#9b9fa6;font-size:24rpx}.qty{display:grid;grid-template-columns:52rpx 48rpx 52rpx;align-items:center;text-align:center;background:#faf8f2;border-radius:30rpx}.qty .ui-text:first-child,.qty .ui-text:last-child{color:#c2412d;font-size:28rpx}.qty .ui-text:nth-child(2){font-size:22rpx}.cart-bar{position:fixed;z-index:5;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 300rpx;align-items:center;gap:20rpx;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1rpx solid #e7e8eb}.cart-bar>.ui-view{display:flex;flex-direction:column}.cart-bar>.ui-view>.ui-text:first-child{color:#626c60;font-size:24rpx}.cart-bar .money{margin-top:2rpx;color:#c2412d;font-size:38rpx}.cart-bar .ui-button{width:100%;margin:0;font-size:25rpx}

.cart-page {padding:36rpx 40rpx 180rpx;background:#faf8f2;}.cart-context {background:transparent;color:#23312d;padding:0 0 28rpx;border-radius:0;border-bottom:1rpx solid #e9e7df;gap:20rpx;}.cart-context .ui-view .ui-text:last-child {color:#626c60;font-size:24rpx;line-height:1.6;}.cart-context>.ui-text {color:#626c60;flex:none;}.cart-line {grid-template-columns:116rpx minmax(0,1fr);position:relative;padding:24rpx 0;border:0;border-bottom:1rpx solid #e9e7df;border-radius:0;background:transparent;}.cart-line>.ui-image {width:116rpx;height:116rpx;}.cart-line__tools {grid-column:2;flex-direction:row;align-items:center;}.cart-line__copy .money {margin-top:16rpx;}.cart-empty {padding:30rpx 20rpx;}.cart-empty__mark {background:transparent;}.empty-asset {width:76rpx;height:76rpx;}.cart-empty .ui-navigator {display:block;box-sizing:border-box;width:100%;max-width:460rpx;border-radius:18rpx;padding:22rpx;font-size:28rpx;}.cart-empty>.ui-text:nth-child(3) {line-height:1.8;font-size:26rpx;}.cart-bar {grid-template-columns:1fr 300rpx;padding:20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));}.cart-page .primary-button {width:100%!important;margin:0!important;}
.cart-page{padding-top:0}.cart-heading{display:flex;flex-direction:column;gap:5rpx;margin:0 -24rpx 22rpx;padding:35rpx 40rpx 31rpx;background:linear-gradient(145deg,#ef5b47,#d93e32);color:#fff;border-radius:0 0 28rpx 28rpx}.cart-heading__title{font-size:38rpx;font-weight:800}.cart-heading__note{font-size:22rpx;color:#ffe1d9}.cart-empty{margin-top:55rpx}.cart-bar .primary-button{background:#e54d3e}
.cart-empty-state{display:block}.empty-pickup-card{display:flex;align-items:center;gap:16rpx;padding:18rpx;border:1rpx solid #eee4df;border-radius:20rpx;background:#fff}.empty-pickup-card__photo{display:flex;flex:none;align-items:center;justify-content:center;width:92rpx;height:92rpx;overflow:hidden;border-radius:50%;background:#fff0e9}.empty-pickup-card__photo--empty{padding:9rpx;box-sizing:border-box;text-align:center;color:#a47c70;font-size:18rpx;line-height:1.35}.empty-pickup-card__copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:4rpx}.empty-pickup-card__eyebrow{color:#a18a80;font-size:19rpx}.empty-pickup-card__name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#302622;font-size:26rpx;font-weight:700}.empty-pickup-card__address{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#80756f;font-size:20rpx}.empty-pickup-card__chevron{flex:none;color:#a59891;font-size:38rpx}
