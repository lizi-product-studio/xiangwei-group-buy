<view class="ui-view cart-page">
  <view class="cart-heading"><text class="cart-heading__title">购物车</text><text class="cart-heading__note">本期好物 · 固定自提点领取</text></view>
  <view wx:if="{{!cart}}" class="cart-empty-state">
    <view class="empty-pickup-card" bindtap="openPickup">
      <view wx:if="{{pickupPoint && pickupPoint.photoUrl}}" class="empty-pickup-card__photo"><product-image src="{{pickupPoint.photoUrl}}" image-mode="aspectFill" label="当前自提点照片" /></view>
      <view wx:elif="{{pickupPoint}}" class="empty-pickup-card__photo empty-pickup-card__photo--empty"><text>暂无点位照片</text></view>
      <view wx:else class="empty-pickup-card__photo empty-pickup-card__photo--empty"><text>选择点位</text></view>
      <view class="empty-pickup-card__copy"><text class="ui-text empty-pickup-card__eyebrow">当前固定自提点</text><text class="ui-text empty-pickup-card__name">{{pickupPoint ? pickupPoint.name : '尚未选择固定自提点'}}</text><text class="ui-text empty-pickup-card__address">{{pickupPoint ? pickupPoint.address : '选择方便领取的附近点位'}}</text></view>
      <text class="empty-pickup-card__chevron">›</text>
    </view>
    <view class="ui-view cart-empty"><view class="ui-view cart-empty__mark"><image class="ui-image empty-asset" src="/assets/tab-cart-default.png" mode="aspectFit"/></view><text class="ui-text">购物车还是空的</text><text class="ui-text">从当前收货区域正在收单的商品里挑几件吧。</text><navigator class="ui-navigator" open-type="switchTab" url="/pages/home/index">去逛团购</navigator></view>
  </view>
  <block wx:else>
    <view class="ui-view cart-context"><view class="ui-view"><text class="ui-text">{{cart.campaignTitle}}</text><text class="ui-text">{{cart.pickupPointName}} · {{cart.pickupPointAddress}}</text></view><text class="ui-text" bindtap="clearAll">清空</text></view>
    <view wx:if="{{areaMismatch}}" class="ui-view cart-warning">当前固定自提点与购物车不一致，请切回该自提点或清空后重新选购。</view>
    <view class="ui-view cart-list"><view wx:for="{{cart.items}}" wx:key="skuId" class="ui-view cart-line"><view class="ui-image"><product-image src="{{item.imageUrl || ''}}" /></view><view class="ui-view cart-line__copy"><text class="ui-text">{{item.title}}</text><text class="ui-text">{{item.skuName}}</text><text class="ui-text money">{{item.priceText}}</text></view><view class="ui-view cart-line__tools"><text class="ui-text remove" data-id="{{item.skuId}}" bindtap="removeLine">删除</text><view class="ui-view qty"><text class="ui-text" data-id="{{item.skuId}}" data-step="-1" bindtap="changeQuantity">−</text><text class="ui-text">{{item.quantity}}</text><text class="ui-text" data-id="{{item.skuId}}" data-step="1" bindtap="changeQuantity">＋</text></view></view></view></view>
    <view wx:if="{{count > 0}}" class="ui-view cart-bar"><view class="ui-view"><text class="ui-text">共 {{count}} 件</text><text class="ui-text money">{{total}}</text></view><button class="ui-button {{areaMismatch ? 'ui-disabled' : ''}} primary-button" disabled="{{areaMismatch}}" bindtap="checkout">去结算</button></view>
  </block>
</view>
