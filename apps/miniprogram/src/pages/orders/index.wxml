<view class="orders">
  <scroll-view class="order-filters" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="order-filters__inner">
      <text class="{{activeFilter === 'ALL' ? 'active' : ''}}" data-filter="ALL" bindtap="changeFilter">全部</text>
      <text class="{{activeFilter === 'PENDING' ? 'active' : ''}}" data-filter="PENDING" bindtap="changeFilter">待付款</text>
      <text class="{{activeFilter === 'ACTIVE' ? 'active' : ''}}" data-filter="ACTIVE" bindtap="changeFilter">进行中</text>
      <text class="{{activeFilter === 'READY' ? 'active' : ''}}" data-filter="READY" bindtap="changeFilter">待自提</text>
      <text class="{{activeFilter === 'AFTER' ? 'active' : ''}}" data-filter="AFTER" bindtap="changeFilter">退款/售后</text>
    </view>
  </scroll-view>
  <view wx:if="{{loading}}" class="empty-order"><text>正在同步订单…</text></view>
  <view wx:elif="{{error}}" class="empty-order"><text>暂时没能加载订单</text><text>{{error}}</text></view>
  <view wx:elif="{{!orders.length}}" class="empty-order">
    <view class="empty-order__stamp">单</view>
    <text>{{activeFilter === 'ALL' ? '还没有订单' : '这里还没有相关订单'}}</text>
    <text>去首页看看正在收单的团购商品。</text>
    <navigator open-type="switchTab" url="/pages/home/index" class="empty-order__link">返回逛逛</navigator>
  </view>
  <view wx:for="{{orders}}" wx:key="id" class="order-item" data-id="{{item.id}}" bindtap="openOrder">
    <view class="order-item__head"><text>{{item.orderNo}}</text><text>{{item.statusText}}</text></view>
    <view class="order-item__body"><image class="order-item__image" src="{{item.imageUrl}}" mode="aspectFill"/><view><text>{{item.itemSummary}}</text><text>{{item.deliveryName}}</text><text wx:if="{{item.deliveryAddress}}">{{item.deliveryAddress}}</text></view><text class="money">{{item.total}}</text></view>
    <view class="order-item__foot"><text>{{item.createdText}}</text><navigator wx:if="{{item.canPickup}}" url="/pages/pickup-code/index?orderId={{item.id}}">查看取货码</navigator><text wx:else>{{item.statusText}}</text></view>
  </view>
</view>
