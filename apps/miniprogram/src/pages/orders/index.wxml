<view class="ui-view orders">
  <scroll-view class="ui-scroll-view order-filters" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="ui-view order-filters__inner">
      <text class="ui-text {{activeFilter === 'ALL' ? 'active' : ''}}" data-filter="ALL" bindtap="changeFilter">全部</text>
      <text class="ui-text {{activeFilter === 'PENDING' ? 'active' : ''}}" data-filter="PENDING" bindtap="changeFilter">待付款</text>
      <text class="ui-text {{activeFilter === 'ACTIVE' ? 'active' : ''}}" data-filter="ACTIVE" bindtap="changeFilter">进行中</text>
      <text class="ui-text {{activeFilter === 'READY' ? 'active' : ''}}" data-filter="READY" bindtap="changeFilter">待自提</text>
      <text class="ui-text {{activeFilter === 'DONE' ? 'active' : ''}}" data-filter="DONE" bindtap="changeFilter">已完成</text>
      <text class="ui-text {{activeFilter === 'AFTER' ? 'active' : ''}}" data-filter="AFTER" bindtap="changeFilter">退款/售后</text>
    </view>
  </scroll-view>
  <view wx:if="{{loading}}" class="ui-view empty-order"><text class="ui-text">正在同步订单…</text></view>
  <view wx:elif="{{error}}" class="ui-view empty-order"><text class="ui-text">{{error === '登录后可查看你的订单与领取进度' ? '登录后查看订单' : '暂时没能加载订单'}}</text><text class="ui-text">{{error}}</text><button wx:if="{{error === '登录后可查看你的订单与领取进度'}}" class="ui-button primary-button" bindtap="openLogin">手机号快捷登录</button><button wx:else class="ui-button ghost-button" bindtap="onShow">重新加载</button></view>
  <view wx:elif="{{!orders.length}}" class="ui-view empty-order">
    <view class="ui-view empty-order__stamp"><image class="ui-image empty-asset" src="/assets/tab-orders-default.png" mode="aspectFit"/></view>
    <text class="ui-text">{{activeFilter === 'ALL' ? '还没有订单' : '这里还没有相关订单'}}</text>
    <text class="ui-text">去首页看看正在收单的团购商品。</text>
    <navigator open-type="switchTab" url="/pages/home/index" class="ui-navigator empty-order__link">返回逛逛</navigator>
  </view>
  <view wx:for="{{orders}}" wx:key="id" class="ui-view order-item" data-id="{{item.id}}" bindtap="openOrder">
    <view class="ui-view order-item__head"><text class="ui-text">{{item.orderNo}}</text><text class="ui-text order-status-label tone-{{item.statusTone}}">{{item.statusText}}</text></view>
    <view class="ui-view order-item__body"><view class="ui-image order-item__image"><product-image src="{{item.imageUrl}}" /></view><view class="ui-view"><text class="ui-text">{{item.itemSummary}}</text><text class="ui-text">{{item.deliveryName}}</text><text class="ui-text" wx:if="{{item.deliveryAddress}}">{{item.deliveryAddress}}</text></view><text class="ui-text money">{{item.total}}</text></view>
    <view class="ui-view order-item__foot"><text class="ui-text">{{item.createdText}}</text><navigator class="ui-navigator" wx:if="{{item.canPickup}}" url="/pages/pickup-code/index?orderId={{item.id}}">查看取货码</navigator><text class="ui-text" wx:else>{{item.statusText}}</text></view>
  </view>
</view>
