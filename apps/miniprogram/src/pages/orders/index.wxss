.orders { padding: 0 24rpx 24rpx; }.order-filters { margin: 0 -24rpx 22rpx; background: #fff; border-bottom: 1rpx solid #ece9e1; white-space: nowrap; }.order-filters__inner { display: inline-flex; gap: 38rpx; padding: 0 28rpx; }.order-filters text { position: relative; padding: 24rpx 0 21rpx; color: #7e858e; font-size: 22rpx; }.order-filters text.active { color: #17263a; font-weight: 750; }.order-filters text.active::after { position: absolute; right: 16%; bottom: 9rpx; left: 16%; height: 5rpx; background: #f05232; border-radius: 5rpx; content: ""; }.empty-order { margin-top: 80rpx; padding: 70rpx 30rpx; text-align: center; background: #fff; border: 1rpx solid #ece9e1; border-radius: 22rpx; }.empty-order text { display: block; }.empty-order text:nth-child(2) { margin: 24rpx 0 10rpx; font-size: 34rpx; font-weight: 750; }.empty-order text:nth-child(3) { color: #858b94; font-size: 23rpx; }.empty-order__stamp { display: grid; width: 80rpx; height: 80rpx; margin: auto; place-items: center; color: #f05232; background: #fff0eb; border-radius: 22rpx; font-size: 34rpx; font-weight: 800; }.empty-order__link { margin-top: 30rpx; color: #f05232; font-size: 24rpx; font-weight: 700; }
.order-item { margin-bottom: 20rpx; overflow: hidden; background: #fff; border: 1rpx solid #ece9e1; border-radius: 20rpx; }.order-item__head,.order-item__foot { display: flex; justify-content: space-between; padding: 20rpx 24rpx; font-size: 20rpx; }.order-item__head { color: #818791; border-bottom: 1rpx solid #eeeae2; }.order-item__head text:last-child { color: #f05232; font-weight: 700; }.order-item__body { display: grid; grid-template-columns: 92rpx 1fr auto; gap: 18rpx; align-items: center; padding: 26rpx 24rpx; }.order-item__image { width: 92rpx; height: 92rpx; border-radius: 14rpx; }.order-item__body view:nth-child(2) text { display: block; }.order-item__body view:nth-child(2) text:first-child { font-size: 24rpx; font-weight: 700; }.order-item__body view:nth-child(2) text:last-child { margin-top: 8rpx; color: #898f97; font-size: 20rpx; }.order-item__body .money { color: #f05232; font-size: 28rpx; }.order-item__foot { color: #8b919a; background: #fafafb; }.order-item__foot text:last-child,.order-item__foot navigator { color: #547b36; }
