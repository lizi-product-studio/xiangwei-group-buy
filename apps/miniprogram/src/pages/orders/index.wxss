.orders { padding: 0 24rpx 24rpx; }.order-filters { margin: 0 -24rpx 22rpx; background: #fff; border-bottom: 1rpx solid #e9e7df; white-space: nowrap; }.order-filters__inner { display: inline-flex; gap: 38rpx; padding: 0 28rpx; }.order-filters .ui-text { position: relative; padding: 24rpx 0 21rpx; color: #7e858e; font-size: 22rpx; }.order-filters .ui-text.active { color: #23312d; font-weight:650; }.order-filters .ui-text.active::after { position: absolute; right: 16%; bottom: 9rpx; left: 16%; height: 5rpx; background: #f05232; border-radius: 5rpx; content: ""; }.empty-order { margin-top: 80rpx; padding: 70rpx 30rpx; text-align: center; background: #fff; border: 1rpx solid #e9e7df; border-radius: 22rpx; }.empty-order .ui-text { display: block; }.empty-order .ui-text:nth-child(2) { margin: 24rpx 0 10rpx; font-size: 34rpx; font-weight:650; }.empty-order .ui-text:nth-child(3) { color: #818780; font-size: 23rpx; }.empty-order__stamp { display: grid; width: 80rpx; height: 80rpx; margin: auto; place-items: center; color: #f05232; background: #fff0eb; border-radius: 22rpx; font-size: 34rpx; font-weight:650; }.empty-order__link { margin-top: 30rpx; color: #f05232; font-size: 24rpx; font-weight: 700; }
.order-item { margin-bottom: 20rpx; overflow: hidden; background: #fff; border: 1rpx solid #e9e7df; border-radius: 20rpx; }.order-item__head,.order-item__foot { display: flex; justify-content: space-between; padding: 20rpx 24rpx; font-size:24rpx; }.order-item__head { color: #818791; border-bottom: 1rpx solid #eeeae2; }.order-item__head .ui-text:last-child { color: #f05232; font-weight: 700; }.order-item__body { display: grid; grid-template-columns: 92rpx 1fr auto; gap: 18rpx; align-items: center; padding: 26rpx 24rpx; }.order-item__image { width: 92rpx; height: 92rpx; border-radius: 14rpx; }.order-item__body .ui-view:nth-child(2) .ui-text { display: block; }.order-item__body .ui-view:nth-child(2) .ui-text:first-child { font-size: 24rpx; font-weight: 700; }.order-item__body .ui-view:nth-child(2) .ui-text:last-child { margin-top: 8rpx; color: #818780; font-size:24rpx; }.order-item__body .money { color: #f05232; font-size: 28rpx; }.order-item__foot { color: #8b919a; background: #fafafb; }.order-item__foot .ui-text:last-child,.order-item__foot .ui-navigator { color: #597a43; }

.orders {padding:26rpx 40rpx 48rpx;}.order-filters {background:transparent;border:0;margin:0 0 24rpx;width:100%;}.order-filters__inner {gap:12rpx;padding:0;}.order-filters .ui-text {padding:14rpx 22rpx;border:1rpx solid #e9e7df;border-radius:40rpx;background:#fffefa;font-size:24rpx;}.order-filters .ui-text.active {color:#f05232;background:#fff0e9;border-color:#efab99;}.order-filters .ui-text.active::after {display:none;}.empty-order {margin-top:30rpx;padding:60rpx 28rpx;background:#fffefa;}.empty-order__stamp {background:transparent;}.empty-asset {width:72rpx;height:72rpx;}.empty-order .ui-text {font-size:26rpx;line-height:1.7;}.empty-order__link {display:block;box-sizing:border-box;max-width:460rpx;margin:30rpx auto 0;padding:20rpx 28rpx;background:#f05232;color:#fff;border-radius:18rpx;font-size:28rpx;}.orders .primary-button,.orders .ghost-button {width:100%!important;margin:26rpx 0 0!important;padding:20rpx!important;}.order-item {border-radius:24rpx;background:#fffefa;}.order-item__body {grid-template-columns:100rpx minmax(0,1fr);}.order-item__body>.money {grid-column:2;text-align:right;}.order-item__body .ui-view {min-width:0;}.order-item__foot {background:transparent;gap:18rpx;align-items:center;}.order-item__foot .ui-navigator {padding:12rpx 18rpx;background:#eef2e6;border-radius:12rpx;font-size:24rpx;}
