<view class="ui-view login-page">
  <view class="ui-view login-page__navigation" style="top: {{navigationTop}}px; height: {{navigationHeight}}px;">
    <button class="ui-button {{status === 'AUTHENTICATING' ? 'ui-disabled' : ''}} login-page__back {{status === 'AUTHENTICATING' ? 'login-page__back--disabled' : ''}}" bindtap="cancel" disabled="{{status === 'AUTHENTICATING'}}" aria-label="返回">
      <image class="ui-image login-page__back-icon" src="/assets/right-gray.png" mode="aspectFit" />
    </button>
  </view>
  <image class="ui-image login-page__hero" src="/assets/login-market-hero.jpg" mode="widthFix" aria-hidden="true" />
  <view class="ui-view login-page__intro">
    <text class="ui-text login-page__brand">乡味集</text>
    <text class="ui-text login-page__title">好味道，一起分享</text>
    <text class="ui-text login-page__subtitle">登录后查看订单与取货信息</text>
  </view>
  <view class="ui-view login-page__actions">
    <checkbox-group bindchange="changePrivacy">
      <label class="ui-label login-page__consent">
        <checkbox class="ui-checkbox {{status === 'AUTHENTICATING' ? 'ui-disabled' : ''}} login-page__checkbox" value="accepted" checked="{{privacyAccepted}}" disabled="{{status === 'AUTHENTICATING'}}" color="#547b36" aria-label="同意用户服务协议和隐私说明" />
        <view class="ui-view login-page__consent-copy">我已阅读并同意<text class="ui-text login-page__legal" catchtap="openTerms">《用户服务协议》</text>和<text class="ui-text login-page__legal" catchtap="openPrivacy">《隐私说明》</text></view>
      </label>
    </checkbox-group>
    <text wx:if="{{privacyError}}" class="ui-text login-page__inline-error" role="alert">{{privacyError}}</text>
    <view wx:if="{{error}}" class="ui-view login-page__error" role="alert">{{error}}</view>
    <text wx:if="{{phoneRequired}}" class="ui-text login-page__phone-copy">首次登录需要绑定手机号，用于账号绑定、订单联系、取货及售后，不用于营销。</text>
    <button wx:if="{{!phoneRequired}}" class="ui-button {{status === 'AUTHENTICATING' ? 'ui-disabled' : ''}} login-page__button {{status === 'AUTHENTICATING' ? 'login-page__button--disabled' : ''}}" loading="{{status === 'AUTHENTICATING'}}" disabled="{{status === 'AUTHENTICATING'}}" bindtap="login">
      <text class="ui-text">{{status === 'ERROR' ? '重新登录' : (status === 'AUTHENTICATING' ? '登录中…' : '手机号快捷登录')}}</text>
    </button>
    <button wx:else class="ui-button login-page__button {{status === 'AUTHENTICATING' || !privacyAccepted ? 'login-page__button--disabled' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="authorizePhone" loading="{{status === 'AUTHENTICATING'}}" disabled="{{status === 'AUTHENTICATING' || !privacyAccepted}}">
      <text class="ui-text">{{status === 'AUTHENTICATING' ? '正在绑定…' : '手机号快捷登录'}}</text>
    </button>
    <button wx:if="{{phoneRequired && status === 'ERROR'}}" class="ui-button login-page__retry" bindtap="retryIdentity">已完成授权？重新确认登录</button>
    <button class="ui-button {{status === 'AUTHENTICATING' ? 'ui-disabled' : ''}} login-page__cancel {{status === 'AUTHENTICATING' ? 'login-page__cancel--disabled' : ''}}" bindtap="cancel" disabled="{{status === 'AUTHENTICATING'}}">暂不登录，先逛逛</button>
    <text class="ui-text login-page__privacy-note">首次授权手机号后，后续可快捷登录</text>
    <view wx:if="{{demoLoginAvailable}}" class="ui-view login-page__dev-zone">
      <text class="ui-text">仅本地开发环境 · 用于预览认证流程</text>
      <button class="ui-button {{status === 'AUTHENTICATING' ? 'ui-disabled' : ''}} login-page__experience-button" loading="{{status === 'AUTHENTICATING'}}" disabled="{{status === 'AUTHENTICATING'}}" bindtap="experienceLogin">开发体验登录</button>
    </view>
  </view>
</view>
