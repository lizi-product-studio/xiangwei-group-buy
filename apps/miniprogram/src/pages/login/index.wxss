.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  color: #1c2a34;
  background: #fffefd;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}
.login-page__navigation { position: absolute; left: 20rpx; width: 44px; z-index: 2; }
.login-page .login-page__back {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 44px !important;
  min-width: 44px;
  max-width: 44px;
  min-height: 44px;
  height: 44px;
  padding: 0 !important;
  margin: -6px 0 0 !important;
  border: 0;
  border-radius: 0;
  background: transparent !important;
  box-shadow: none;
}
.login-page__back-icon { width: 38rpx; height: 38rpx; transform: rotate(180deg); filter: brightness(0) invert(1); }
.login-page__hero { display: block; flex: none; width: 100%; }
.login-page__intro { padding: 0 64rpx; margin-top: -8rpx; position: relative; }
.login-page__brand { display: block; color: #ff5933; font-size: 38rpx; font-weight: 700; line-height: 54rpx; }
.login-page__title { display: block; margin-top: 18rpx; font-size: 46rpx; font-weight: 700; line-height: 66rpx; letter-spacing: 1rpx; }
.login-page__subtitle { display: block; margin-top: 14rpx; color: #62676b; font-size: 27rpx; line-height: 40rpx; }
.login-page__actions { margin-top: auto; padding: 100rpx 48rpx 0; }
.login-page__consent { display: flex; align-items: center; min-height: 72rpx; gap: 10rpx; color: #737575; font-size: 12px; line-height: 36rpx; }
.login-page__checkbox { flex: none; transform: scale(.76); transform-origin: center; }
.login-page__consent-copy { flex: 1; min-width: 0; }
.login-page__legal { color: #547b36; text-decoration: underline; }
.login-page .login-page__button, .login-page .login-page__cancel, .login-page .login-page__experience-button {
  box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 100% !important; min-width: 0; max-width: none; margin-left: 0 !important; margin-right: 0 !important; font-family: inherit;
}
.login-page__back::after, .login-page__button::after, .login-page__cancel::after, .login-page__experience-button::after { border: 0; }
.login-page .login-page__button { min-height: 106rpx; margin-top: 24rpx; padding: 20rpx 24rpx !important; color: #fff; background: #ff5933; border-radius: 18rpx; font-size: 34rpx; font-weight: 650; line-height: 48rpx; }
.login-page__button-icon { width: 52rpx; height: 52rpx; margin-right: 18rpx; }
.login-page__button:active { background: #e84b28; }
.login-page .login-page__button--disabled { color: #fff; background: #ed9b86; }
.login-page__cancel { min-height: 88rpx; margin-top: 28rpx; padding: 12rpx; color: #547b36; background: transparent; font-size: 28rpx; font-weight: 600; line-height: 42rpx; }
.login-page__cancel--disabled, .login-page__back--disabled { opacity: .5; }
.login-page__privacy-note { display: block; margin-top: 28rpx; text-align: center; color: #777a78; font-size: 12px; line-height: 36rpx; }
.login-page__inline-error { display: block; color: #b44732; font-size: 23rpx; line-height: 36rpx; }
.login-page__error { margin: 12rpx 0; padding: 20rpx 24rpx; color: #b44732; background: #fff1ec; border-radius: 16rpx; font-size: 24rpx; line-height: 36rpx; }
.login-page__dev-zone { margin-top: 36rpx; padding: 24rpx; color: #626b5d; background: #f6f7f0; border-radius: 16rpx; font-size: 22rpx; line-height: 34rpx; }
.login-page__experience-button { min-height: 80rpx; margin-top: 16rpx; color: #547b36; background: #fffefd; font-size: 27rpx; }
@media (max-height: 700px) {
  .login-page__actions { padding-top: 54rpx; }
  .login-page__cancel { margin-top: 16rpx; }
  .login-page__privacy-note { margin-top: 14rpx; }
}
