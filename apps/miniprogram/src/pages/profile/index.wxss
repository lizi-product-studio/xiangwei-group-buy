page {
  background: #f8f7f2;
}

.profile {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx calc(72rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  color: #20251f;
  background: #f8f7f2;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.identity-card,
.login-card,
.order-card,
.pickup-card,
.service-card {
  box-sizing: border-box;
  overflow: hidden;
  background: #fff;
  border: 2rpx solid #ebe7de;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(55, 66, 49, 0.045);
}

.identity-card {
  display: grid;
  min-height: 280rpx;
  grid-template-columns: 124rpx 1fr;
  grid-template-rows: 1fr 76rpx;
  column-gap: 26rpx;
  align-items: center;
  padding: 28rpx 30rpx 24rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(145deg, #f3f3f0, #e7e9e5);
  border: 6rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 10rpx 28rpx rgba(53, 62, 50, 0.12);
}

.avatar image {
  width: 70%;
  height: 70%;
  opacity: 0.78;
}

.avatar--member {
  width: 124rpx;
  height: 124rpx;
  grid-row: 1;
}

.identity-card__copy {
  min-width: 0;
}

.identity-card__eyebrow {
  display: block;
  color: #5f7f35;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 30rpx;
}

.identity-card__name {
  display: block;
  margin-top: 2rpx;
  color: #20251f;
  font-size: 38rpx;
  font-weight: 740;
  line-height: 50rpx;
}

.identity-card__description {
  display: block;
  margin-top: 4rpx;
  color: #747b74;
  font-size: 22rpx;
  line-height: 32rpx;
}

.identity-card__logout {
  display: flex;
  width: 100%;
  min-height: 72rpx;
  box-sizing: border-box;
  grid-column: 1 / -1;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #ef5937;
  background: #fff7f4;
  border: 2rpx solid #f2c1b5;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 650;
}

.identity-card__logout::after,
.login-card button::after,
.order-card button::after,
.service-card button::after {
  border: 0;
}

.identity-card__logout image {
  width: 34rpx;
  height: 34rpx;
}

.identity-card__logout:active {
  background: #ffece6;
}

.login-card {
  min-height: 328rpx;
  padding: 28rpx 28rpx 24rpx;
}

.login-card__identity {
  display: grid;
  grid-template-columns: 112rpx 1fr;
  column-gap: 24rpx;
  align-items: center;
}

.avatar--guest {
  width: 112rpx;
  height: 112rpx;
}

.login-card__copy {
  min-width: 0;
}

.login-card__title {
  display: block;
  color: #20251f;
  font-size: 34rpx;
  font-weight: 720;
  line-height: 46rpx;
}

.login-card__description {
  display: block;
  margin-top: 6rpx;
  color: #747b74;
  font-size: 23rpx;
  line-height: 34rpx;
}

.primary-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  font-family: inherit;
}

.login-card__button {
  width: 460rpx;
  max-width: 100%;
  min-height: 84rpx;
  margin: 20rpx auto 0;
  padding: 0 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #f44d2e 0%, #f26a3f 100%);
  box-shadow: 0 14rpx 32rpx rgba(239, 89, 55, 0.19);
  font-size: 30rpx;
  font-weight: 700;
}

.login-card__button image {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
}

.login-card__button:active {
  background: #dc4729;
  transform: scale(0.98);
}

.login-card__privacy {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
  margin-top: 16rpx;
  color: #747b74;
  font-size: 20rpx;
  line-height: 30rpx;
}

.login-card__privacy image {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-top: 2rpx;
}

.order-card {
  margin-top: 20rpx;
}

.card-head {
  display: flex;
  min-height: 80rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
  border-bottom: 2rpx solid #efebe4;
}

.card-head__title {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 14rpx;
}

.card-head__title > text:first-child,
.card-head > text {
  color: #20251f;
  font-size: 30rpx;
  font-weight: 720;
  line-height: 42rpx;
}

.card-head__count {
  color: #979d96;
  font-size: 21rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.card-head__link {
  display: flex;
  min-height: 80rpx;
  align-items: center;
  gap: 6rpx;
  color: #747b74;
  font-size: 23rpx;
  line-height: 32rpx;
}

.card-head__link image {
  width: 26rpx;
  height: 26rpx;
}

.order-statuses {
  display: grid;
  min-height: 154rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: center;
  padding: 10rpx 8rpx 16rpx;
}

.order-status {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 112rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 4rpx 0;
  color: #525a52;
  background: transparent;
  font-size: 23rpx;
  line-height: 32rpx;
}

.status-icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
}

.status-icon image {
  width: 58rpx;
  height: 58rpx;
}

.status-count {
  position: absolute;
  top: 4rpx;
  left: calc(50% + 20rpx);
  min-width: 30rpx;
  height: 30rpx;
  box-sizing: border-box;
  padding: 0 7rpx;
  color: #fff;
  background: #ef5937;
  border: 4rpx solid #fff;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 22rpx;
  text-align: center;
}

.summary-error {
  box-sizing: border-box;
  padding: 28rpx;
  color: #b44732;
  background: #fff1ec;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.pickup-card {
  margin-top: 20rpx;
}

.pickup-content {
  display: grid;
  min-height: 150rpx;
  grid-template-columns: 106rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: center;
  padding: 16rpx 24rpx;
}

.pickup-mark {
  display: flex;
  width: 106rpx;
  height: 106rpx;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #6d8e3f, #4f7129);
  border-radius: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(83, 115, 46, 0.16);
}

.pickup-mark image {
  width: 62rpx;
  height: 62rpx;
}

.pickup-copy {
  min-width: 0;
}

.pickup-copy__title,
.pickup-copy__description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pickup-copy__title {
  color: #20251f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.pickup-copy__description {
  margin-top: 2rpx;
  color: #747b74;
  font-size: 21rpx;
  line-height: 30rpx;
}

.pickup-copy__tags {
  display: flex;
  max-width: 100%;
  gap: 8rpx;
  margin-top: 10rpx;
}

.pickup-copy__tags text {
  max-width: 48%;
  overflow: hidden;
  padding: 6rpx 10rpx;
  color: #697069;
  background: #f7f7f3;
  border: 2rpx solid #ece9e1;
  border-radius: 10rpx;
  font-size: 17rpx;
  line-height: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-card {
  width: 100%;
  min-width: 0;
  margin-top: 20rpx;
  padding: 0 26rpx;
}

.service-card__title {
  display: block;
  padding: 22rpx 0 14rpx;
  color: #20251f;
  font-size: 30rpx;
  font-weight: 720;
  line-height: 42rpx;
}

.service-row {
  display: grid !important;
  width: 100%;
  max-width: none;
  min-width: 0;
  min-height: 90rpx;
  grid-template-columns: 44rpx auto minmax(0, 1fr) 26rpx;
  column-gap: 14rpx;
  align-items: center;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  justify-self: stretch;
  color: #20251f;
  background: transparent;
  border: 0;
  border-top: 2rpx solid #efebe4;
  border-radius: 0;
  text-align: left;
}

.service-row > image:first-child {
  width: 44rpx;
  height: 44rpx;
}

.service-row > image:last-child {
  width: 26rpx;
  height: 26rpx;
}

.service-row__label {
  min-width: 0;
  color: #20251f;
  font-size: 25rpx;
  font-weight: 620;
  line-height: 36rpx;
  white-space: nowrap;
}

.service-row__hint {
  min-width: 0;
  overflow: hidden;
  color: #979d96;
  font-size: 21rpx;
  line-height: 30rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-row:active {
  background: #fbfbf8;
}

/* Beat the platform wx-button:not([size=mini]) width/margin defaults. */
.service-card .service-row {
  width: 100%;
  max-width: none;
  margin-right: 0;
  margin-left: 0;
  box-sizing: border-box;
  justify-self: stretch;
}

@media (max-width: 720rpx) {
  .profile {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .identity-card {
    column-gap: 18rpx;
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .service-row {
    grid-template-columns: 40rpx auto minmax(0, 1fr) 24rpx;
    column-gap: 10rpx;
  }

  .service-row > image:first-child {
    width: 40rpx;
    height: 40rpx;
  }

  .service-row__label {
    font-size: 23rpx;
  }

  .service-row__hint {
    font-size: 19rpx;
  }
}
