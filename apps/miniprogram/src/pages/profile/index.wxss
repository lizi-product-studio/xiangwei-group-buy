.profile {min-height:100vh;box-sizing:border-box;padding:40rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));background:#faf8f2;color:#23312d;}.identity-card {display:flex;gap:26rpx;align-items:center;padding:4rpx 0 36rpx;}.avatar {width:110rpx;height:110rpx;background:#eceee6;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none;}.avatar__image {width:78rpx;height:78rpx;}.identity-card__copy {min-width:0;}.identity-card__name {display:block;font-size:40rpx;font-weight:650;line-height:1.4;}.identity-card__description,.identity-card__login {display:block;margin-top:8rpx;font-size:24rpx;line-height:1.6;color:#626c60;}.identity-card__login {color:#3f6b35;}
.card-head {display:flex;justify-content:space-between;align-items:center;gap:12rpx;min-height:70rpx;font-size:30rpx;font-weight:650;}.card-head__title {display:flex;align-items:baseline;gap:12rpx;}.card-head__count {font-size:22rpx;font-weight:400;color:#626c60;}.card-head__link {display:flex;align-items:center;gap:6rpx;font-size:24rpx;font-weight:400;color:#3f6b35;}.card-head__link .ui-image {width:24rpx;height:24rpx;}.order-statuses {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:22rpx 0 30rpx;border-bottom:1rpx solid #e9e7df;}.order-status {position:relative;display:flex;flex-direction:column;align-items:center;gap:10rpx;font-size:24rpx;color:#697269;}.status-icon {width:46rpx;height:46rpx;}.status-icon .ui-image {width:100%;height:100%;}.status-count {position:absolute;top:-8rpx;left:calc(50% + 14rpx);background:#c2412d;color:white;border-radius:20rpx;font-size:20rpx;padding:0 8rpx;}.pickup-card {margin-top:30rpx;padding-bottom:24rpx;border-bottom:1rpx solid #e9e7df;}.pickup-content {padding:12rpx 0;}.pickup-copy__title {display:block;font-size:28rpx;font-weight:600;}.pickup-copy__description {display:block;margin-top:8rpx;font-size:24rpx;line-height:1.6;color:#626c60;}.summary-error {padding:22rpx;margin:14rpx 0;color:#ad4934;background:#fff0e9;border-radius:16rpx;font-size:24rpx;line-height:1.6;}.service-card {margin-top:28rpx;}.service-card__title {display:block;font-size:30rpx;font-weight:650;padding:12rpx 0;}.profile .service-row {display:grid!important;grid-template-columns:36rpx auto minmax(0,1fr) 22rpx;gap:12rpx;align-items:center;width:100%!important;margin:0!important;padding:24rpx 0!important;min-height:92rpx;box-sizing:border-box;background:transparent;border-radius:0;border-bottom:1rpx solid #e9e7df;text-align:left;}.service-row .ui-image {width:32rpx;height:32rpx;}.service-row__label {font-size:26rpx;white-space:nowrap;}.service-row__hint {font-size:22rpx;color:#626c60;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.account-settings {margin-top:32rpx;}.profile .account-settings__logout {display:flex;align-items:center;justify-content:center;width:100%!important;height:88rpx;min-height:88rpx;box-sizing:border-box;padding:0 24rpx!important;margin:0!important;text-align:center;font-size:28rpx;line-height:1.5;color:#59615c;background:#fffefa;border:1rpx solid #e2e3dc;border-radius:18rpx;}.profile .account-settings__logout--hover {background:#f0f1eb;}.account-settings__logout::after,.service-row::after {border:0;}

.profile {padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));}
.identity-card {padding:16rpx 8rpx 32rpx;}
.identity-card__name {font-size:36rpx;}
.order-card,.pickup-card,.service-card {padding:22rpx 28rpx;background:#fffefa;border:1rpx solid #e6e3d8;border-radius:24rpx;margin-top:24rpx;}
.order-card {margin-top:0;}
.order-statuses {border-bottom:0;padding:24rpx 0 12rpx;}
.order-count {font-size:38rpx;line-height:1.3;color:#23312d;font-weight:650;font-variant-numeric:tabular-nums;}
.profile .service-row:last-child {border-bottom:0;}
.service-row__hint {font-size:24rpx;}
@media(max-width:350px) {.service-row__hint {display:none;} .profile .service-row {grid-template-columns:36rpx 1fr 22rpx;}}
