.profile{min-height:100vh;box-sizing:border-box;padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));background:#faf8f2;color:#23312d}.identity-card,.guest-card{display:flex;align-items:center;gap:22rpx;padding:16rpx 8rpx 32rpx}.guest-card{flex-direction:column;align-items:stretch;gap:24rpx;padding:16rpx 0 32rpx}.guest-card__identity{display:flex;align-items:center;gap:22rpx;min-width:0}.avatar{width:104rpx;height:104rpx;flex:none;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e9ece4}.avatar__image{width:100%;height:100%;border-radius:50%}.identity-card__copy,.guest-card__copy{min-width:0;flex:1}.identity-card__name{display:block;font-size:36rpx;font-weight:700;line-height:1.4}.identity-card__description{display:block;margin-top:8rpx;color:#697269;font-size:24rpx;line-height:1.5}.profile .guest-card__button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%!important;max-width:100%;min-width:0;min-height:80rpx;margin:0!important;padding:18rpx 24rpx!important;background:#c2412d;color:#fff;border-radius:18rpx;font-size:28rpx;line-height:1.5}.guest-card__button:after{border:0}.order-card,.pickup-card,.service-card{width:100%;min-width:0;box-sizing:border-box;overflow:hidden;margin-top:24rpx;padding:22rpx 28rpx;background:#fffefa;border:1rpx solid #e6e3d8;border-radius:24rpx}.order-card{margin-top:0}.card-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:70rpx;font-size:30rpx;font-weight:650}.card-head__title{display:flex;align-items:baseline;gap:12rpx}.card-head__count{font-size:22rpx;font-weight:400;color:#697269}.card-head__link{display:flex;align-items:center;gap:6rpx;font-size:24rpx;font-weight:400;color:#3f6b35}.card-head__link .ui-image{width:24rpx;height:24rpx}.order-statuses{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:24rpx 0 12rpx}.order-status{display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#697269;font-size:24rpx}.order-count{font-size:38rpx;line-height:1.3;color:#23312d;font-weight:650;font-variant-numeric:tabular-nums}.pickup-content{padding:12rpx 0}.pickup-copy__title{display:block;font-size:28rpx;font-weight:650}.pickup-copy__description{display:block;margin-top:8rpx;color:#697269;font-size:24rpx;line-height:1.6}.service-card__title{display:block;padding:4rpx 0 18rpx;font-size:30rpx;font-weight:700}.service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:minmax(150rpx,auto);width:100%;min-width:0;gap:14rpx}.profile .service-tile{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;width:100%!important;max-width:100%;min-width:0;min-height:150rpx;box-sizing:border-box;overflow:hidden;margin:0!important;padding:20rpx!important;background:#f8f8f3;border:1rpx solid #ece9df;border-radius:18rpx;text-align:left}.service-tile:after{border:0}.service-tile .ui-image{width:36rpx;height:36rpx;flex:none;margin-bottom:14rpx}.service-tile__label,.service-tile__hint{width:100%;min-width:0;overflow-wrap:anywhere}.service-tile__label{font-size:26rpx;font-weight:650}.service-tile__hint{display:block;margin-top:6rpx;color:#697269;font-size:21rpx;line-height:1.4}.account-settings__logout{display:flex;align-items:center;justify-content:center;width:100%!important;max-width:100%;height:78rpx;min-height:78rpx;box-sizing:border-box;margin:20rpx 0 0!important;padding:0!important;background:#fffefa;border:1rpx solid #e2e3dc;border-radius:18rpx;color:#59615c;font-size:26rpx}.account-settings__logout:after{border:0}.account-settings__logout--hover{background:#f0f1eb}.summary-error{margin:14rpx 0;padding:20rpx;color:#ad4934;background:#fff0e9;border-radius:16rpx;font-size:24rpx;line-height:1.6}@media(max-width:350px){.service-tile__hint{font-size:19rpx}.profile .service-tile{padding:16rpx!important}}
.request-support{display:flex;align-items:center;gap:16rpx;margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #e9e7df}.request-support__copy{flex:1;color:#697269;font-size:22rpx;line-height:1.5}.request-support__copy-button{flex:none;margin:0;padding:8rpx 16rpx;color:#3f6b35;background:#f2f5ed;border:0;border-radius:12rpx;font-size:22rpx}.request-support__copy-button:after{border:0}

.pickup-content { display: flex; align-items: center; gap: 20rpx; }
.pickup-photo { width: 112rpx; height: 112rpx; flex: none; border-radius: 16rpx; overflow: hidden; }
.pickup-copy { flex: 1; min-width: 0; }
.identity-card,.guest-card{margin:-32rpx -28rpx 0;padding:42rpx 28rpx 34rpx;background:linear-gradient(145deg,#ef5c48,#d93e32);color:#fff;border-radius:0 0 30rpx 30rpx}.guest-card{margin-left:-28rpx;margin-right:-28rpx}.identity-card__description{color:#ffded5}.avatar{background:#fff1e9}.profile .guest-card__button{background:#fff;color:#d94335}.pickup-tools{display:flex;gap:12rpx;padding-top:16rpx;border-top:1rpx solid #f0e6e1}.pickup-tools__button{flex:1;margin:0!important;padding:13rpx 10rpx!important;border-radius:14rpx;background:#fff2ed;color:#d94a3c;font-size:22rpx}.pickup-tools__button:after{border:0}
.order-statuses{grid-template-columns:repeat(5,minmax(0,1fr));gap:2rpx;padding:18rpx 0 10rpx}.order-status{min-width:0;gap:5rpx;font-size:19rpx}.order-status__icon{display:flex;align-items:center;justify-content:center;width:49rpx;height:49rpx;border-radius:50%;background:#fff1ec;color:#dd5a48;font-size:24rpx;font-weight:750}.order-status:nth-child(2) .order-status__icon{background:#f0f4e9;color:#56774d}.order-status:nth-child(3) .order-status__icon{background:#fff5df;color:#b37b29}.order-status:nth-child(4) .order-status__icon{background:#edf3eb;color:#55774f}.order-status:nth-child(5) .order-status__icon{background:#f4eff8;color:#866699}.order-count{font-size:29rpx}.order-label{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:18rpx}.pickup-copy__instructions{display:block;margin-top:7rpx;color:#9a7768;font-size:22rpx;line-height:1.5}.service-list{display:flex;flex-direction:column}.profile .service-row{display:flex;align-items:center;justify-content:flex-start;gap:18rpx;width:100%!important;max-width:100%;min-width:0;min-height:91rpx;box-sizing:border-box;margin:0!important;padding:12rpx 0!important;border:0;border-bottom:1rpx solid #f0eee8;border-radius:0;background:#fffefa;text-align:left}.profile .service-row:after{border:0}.profile .service-row:last-child{border-bottom:0}.service-row__icon{flex:none;width:37rpx;height:37rpx}.service-row__copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:4rpx}.service-row .service-tile__label{font-size:26rpx;line-height:1.4}.service-row .service-tile__hint{margin:0;font-size:21rpx;line-height:1.4}.service-row__chevron{flex:none;color:#bbb2ad;font-size:35rpx;line-height:1}.profile .service-row--logout{min-height:75rpx;color:#776d68}.service-card__title{padding-bottom:10rpx}.pickup-content{padding:17rpx 0}.pickup-photo{width:104rpx;height:104rpx;border-radius:50%;border:2rpx solid #f3e7e0;box-sizing:border-box}.pickup-photo--empty{padding:10rpx;text-align:center;color:#9d766a;font-size:18rpx;line-height:1.4}.service-card{padding-top:18rpx;padding-bottom:16rpx}@media(max-width:350px){.order-status{font-size:17rpx}.order-status__icon{width:43rpx;height:43rpx}.order-count{font-size:25rpx}.order-label{font-size:16rpx}.profile .service-row{gap:13rpx}}
