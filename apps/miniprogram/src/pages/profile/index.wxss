.profile { padding: 24rpx 24rpx 60rpx; }
.identity-card { display: flex; align-items: center; gap: 22rpx; padding: 28rpx 8rpx 34rpx; }.avatar { display: grid; width: 92rpx; height: 92rpx; place-items: center; color: #fff; background: #f05232; border-radius: 30rpx; font-size: 36rpx; font-weight: 800; box-shadow: 0 12rpx 28rpx rgba(240,82,50,.2); }.identity-card__copy { flex: 1; }.identity-card__copy text { display: block; }.identity-card__copy text:first-child { color: #17263a; font-size: 34rpx; font-weight: 800; }.identity-card__copy text:last-child { margin-top: 8rpx; color: #8a9099; font-size: 21rpx; }.identity-card__logout { color: #8a9099; font-size: 21rpx; }
.login-card { margin-bottom: 22rpx; padding: 30rpx; color: #fff; background: #28322e; border-radius: 24rpx; box-shadow: 0 14rpx 30rpx rgba(31,46,39,.14); }.login-card view text { display: block; }.login-card view text:first-child { font-size: 30rpx; font-weight: 800; }.login-card view text:last-child { margin-top: 10rpx; color: #c8d0cc; font-size: 21rpx; }.login-card button { margin-top: 26rpx; font-size: 25rpx; }.login-card__hint { display: block; margin-top: 16rpx; padding: 12rpx 14rpx; color: #dbe6d8; background: rgba(255,255,255,.09); border-radius: 10rpx; font-size: 19rpx; line-height: 1.45; }.login-card__consent { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 20rpx; color: #d8dfda; font-size: 20rpx; line-height: 1.5; }.login-card__consent checkbox { transform: scale(.82); transform-origin: left top; }.login-card__privacy { display: flex; flex-wrap: wrap; gap: 4rpx; margin-top: 10rpx; color: #aab6b0; font-size: 18rpx; line-height: 1.5; }.login-card__privacy text { margin: 0!important; font-size: inherit!important; font-weight: 400!important; }.login-card__link { color: #ffd4ca!important; text-decoration: underline; }
.order-card,.service-card { background: #fff; border: 1rpx solid #ece9e1; border-radius: 22rpx; }.card-head { display: flex; align-items: center; justify-content: space-between; padding: 25rpx 26rpx; border-bottom: 1rpx solid #eeeae2; }.card-head view text { display: inline; }.card-head view text:first-child { color: #24292f; font-size: 27rpx; font-weight: 750; }.card-head view text:last-child { margin-left: 12rpx; color: #9a9fa7; font-size: 19rpx; }.card-head > text { color: #7e858e; font-size: 20rpx; }.order-statuses { display: grid; grid-template-columns: repeat(4,1fr); padding: 26rpx 10rpx 28rpx; }.order-statuses view { position: relative; display: grid; justify-items: center; gap: 10rpx; color: #575e67; font-size: 20rpx; }.status-icon { display: grid; width: 58rpx; height: 58rpx; place-items: center; color: #f05232; background: #fff0eb; border-radius: 18rpx; font-size: 22rpx; font-weight: 800; }.status-icon--green { color: #547b36; background: #edf3e6; }.status-icon--gray { color: #6c737c; background: #f0f1f3; }.status-count { position: absolute; top: -8rpx; left: calc(50% + 12rpx); min-width: 29rpx; height: 29rpx; padding: 0 5rpx; color: #fff; background: #f05232; border: 3rpx solid #fff; border-radius: 20rpx; font-size: 17rpx; line-height: 29rpx; text-align: center; }.summary-error { padding: 30rpx; color: #b24631; text-align: center; font-size: 21rpx; }
.pickup-pass { position: relative; display: grid; grid-template-columns: 68rpx 1fr auto; align-items: center; gap: 18rpx; margin-top: 20rpx; padding: 27rpx; overflow: hidden; color: #fff; background: #28322e; border-radius: 22rpx; }.pickup-pass::after { position: absolute; right: -50rpx; bottom: -80rpx; width: 220rpx; height: 220rpx; border: 34rpx solid rgba(255,255,255,.045); border-radius: 50%; content: ""; }.pickup-pass__mark { display: grid; width: 68rpx; height: 68rpx; place-items: center; color: #547b36; background: #fff; border-radius: 18rpx; font-size: 25rpx; font-weight: 800; }.pickup-pass__copy { position: relative; z-index: 1; }.pickup-pass__copy text { display: block; }.pickup-pass__copy text:first-child { color: #a9b7b0; font-size: 18rpx; }.pickup-pass__copy text:nth-child(2) { margin-top: 7rpx; font-size: 27rpx; font-weight: 750; }.pickup-pass__copy text:last-child { margin-top: 6rpx; color: #b9c3be; font-size: 19rpx; }.pickup-pass__arrow { position: relative; z-index: 1; color: #cad1ce; font-size: 36rpx; }
.service-card { margin-top: 20rpx; padding: 0 25rpx; }.service-card__title { display: block; padding: 25rpx 0 15rpx; color: #24292f; font-size: 26rpx; font-weight: 750; }.service-card button { display: flex; width: 100%; align-items: center; justify-content: space-between; margin: 0; padding: 24rpx 0; color: #545b64; background: transparent; border-top: 1rpx solid #eeeae2; border-radius: 0; font-size: 22rpx; line-height: 1.4; text-align: left; }.service-card button text:last-child { color: #92979f; font-size: 20rpx; }
