<view class="ui-view profile">
  <view wx:if="{{!loggedIn}}" class="ui-view guest-card">
    <view class="guest-card__identity"><view class="ui-view avatar"><image class="ui-image avatar__image" src="/assets/avatar-persimmon.png" mode="aspectFit"/></view><view class="guest-card__copy"><text class="ui-text identity-card__name">当前未登录</text><text class="ui-text identity-card__description">登录后查看历史订单和固定自提点</text></view></view>
    <button class="ui-button guest-card__button" bindtap="openLogin">手机号快捷登录</button>
  </view>
  <view wx:else class="ui-view identity-card" bindtap="openProfileEdit"><view class="ui-view avatar"><image class="ui-image avatar__image" src="/assets/avatar-persimmon.png" mode="aspectFit" aria-hidden="true"/></view><view class="ui-view identity-card__copy"><text class="ui-text identity-card__name">{{userName}}</text><text class="ui-text identity-card__description">{{phoneNumber || '手机号未绑定'}} · 编辑资料 ›</text></view></view>

  <view class="ui-view order-card">
    <view class="ui-view card-head" data-filter="ALL" bindtap="openOrders"><view class="ui-view card-head__title"><text class="ui-text">我的订单</text><text wx:if="{{loggedIn && !loading && !error}}" class="ui-text card-head__count">共 {{orderTotal}} 单</text></view><view class="ui-view card-head__link"><text class="ui-text">查看全部订单</text><image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true"/></view></view>
    <view wx:if="{{loggedIn && error}}" class="ui-view summary-error" bindtap="loadSummary" role="alert">{{error}}，点击重试</view>
    <view wx:else class="ui-view order-statuses">
      <view class="ui-view order-status" data-filter="PENDING" bindtap="openOrders"><image class="ui-image order-status__icon" src="/assets/order-status-pending.png" mode="aspectFit" aria-hidden="true"/><text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.pending : '—'}}</text><text class="ui-text order-label">待付款</text></view>
      <view class="ui-view order-status" data-filter="ACTIVE" bindtap="openOrders"><image class="ui-image order-status__icon" src="/assets/order-status-active.png" mode="aspectFit" aria-hidden="true"/><text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.active : '—'}}</text><text class="ui-text order-label">进行中</text></view>
      <view class="ui-view order-status" data-filter="READY" bindtap="openOrders"><image class="ui-image order-status__icon" src="/assets/order-status-ready.png" mode="aspectFit" aria-hidden="true"/><text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.ready : '—'}}</text><text class="ui-text order-label">待提货</text></view>
      <view class="ui-view order-status" data-filter="DONE" bindtap="openOrders"><image class="ui-image order-status__icon" src="/assets/order-status-done.png" mode="aspectFit" aria-hidden="true"/><text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.done : '—'}}</text><text class="ui-text order-label">已提货</text></view>
      <view class="ui-view order-status" data-filter="AFTER" bindtap="openOrders"><image class="ui-image order-status__icon" src="/assets/order-status-after.png" mode="aspectFit" aria-hidden="true"/><text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.afterSale : '—'}}</text><text class="ui-text order-label">退款/售后</text></view>
    </view>
  </view>

  <view class="ui-view pickup-card">
    <view class="ui-view card-head" bindtap="openPickup"><text class="ui-text">我的当前自提点</text><view class="ui-view card-head__link"><text class="ui-text">查看 / 切换 ›</text></view></view>
    <view wx:if="{{areaError}}" class="ui-view summary-error" catchtap="loadArea" role="alert">{{areaError}}，点击重试</view>
    <view class="ui-view pickup-content" bindtap="openPickup">
      <view wx:if="{{pickupPoint && pickupPoint.photoUrl}}" class="pickup-photo"><product-image src="{{pickupPoint.photoUrl}}" image-mode="aspectFill" label="自提点照片"/></view>
      <view wx:elif="{{pickupPoint}}" class="pickup-photo pickup-photo--empty"><text>暂无点位照片</text></view>
      <view class="ui-view pickup-copy"><text class="ui-text pickup-copy__title">{{pickupPoint ? pickupPoint.name : '请选择固定自提点'}}</text><text wx:if="{{pickupPoint && pickupPoint.displayAddress}}" class="ui-text pickup-copy__description">{{pickupPoint.displayAddress}}</text><text wx:elif="{{!pickupPoint}}" class="ui-text pickup-copy__description">选好附近点位，逛逛本期团购</text><text wx:if="{{pickupPoint && pickupPoint.pickupInstructions}}" class="ui-text pickup-copy__instructions">{{pickupPoint.pickupInstructions}}</text></view>
    </view>
    <view wx:if="{{pickupPoint}}" class="pickup-tools"><button class="pickup-tools__button" catchtap="openPickupLocation">一键导航</button><button class="pickup-tools__button" catchtap="callPickupPoint">拨打电话</button></view>
  </view>

  <view class="ui-view service-card">
    <text class="ui-text service-card__title">常用服务</text>
    <view class="service-list">
      <button class="ui-button service-row" bindtap="openMessages"><image class="ui-image service-row__icon" src="/assets/message-green.png" mode="aspectFit"/><view class="service-row__copy"><text class="ui-text service-tile__label">消息提醒</text><text class="ui-text service-tile__hint">订阅管理与订单进度</text></view><text class="service-row__chevron">›</text></button>
      <button class="ui-button service-row" bindtap="openPickupCode"><image class="ui-image service-row__icon" src="/assets/wallet-green.png" mode="aspectFit"/><view class="service-row__copy"><text class="ui-text service-tile__label">取货码</text><text class="ui-text service-tile__hint">到点出示领取</text></view><text class="service-row__chevron">›</text></button>
      <button class="ui-button service-row" bindtap="openProfileEdit"><image class="ui-image service-row__icon" src="/assets/user-gray.png" mode="aspectFit"/><view class="service-row__copy"><text class="ui-text service-tile__label">个人资料</text><text class="ui-text service-tile__hint">姓名与手机号</text></view><text class="service-row__chevron">›</text></button>
      <button class="ui-button service-row" open-type="contact"><image class="ui-image service-row__icon" src="/assets/service-green.png" mode="aspectFit"/><view class="service-row__copy"><text class="ui-text service-tile__label">帮助与客服</text><text class="ui-text service-tile__hint">下单领取说明</text></view><text class="service-row__chevron">›</text></button>
      <button class="ui-button service-row" bindtap="openPrivacy"><image class="ui-image service-row__icon" src="/assets/privacy-green.png" mode="aspectFit"/><view class="service-row__copy"><text class="ui-text service-tile__label">隐私与协议</text><text class="ui-text service-tile__hint">用户协议与隐私说明</text></view><text class="service-row__chevron">›</text></button>
      <button class="ui-button service-row service-row--logout" wx:if="{{loggedIn}}" bindtap="confirmLogout"><view class="service-row__copy"><text class="ui-text service-tile__label">退出登录</text></view><text class="service-row__chevron">›</text></button>
      <button class="ui-button service-row" wx:else bindtap="openLogin"><view class="service-row__copy"><text class="ui-text service-tile__label">登录账号</text></view><text class="service-row__chevron">›</text></button>
    </view>
    <view wx:if="{{latestRequestId}}" class="request-support"><text class="ui-text request-support__copy">最近一次失败可提供给客服：{{latestRequestId}}</text><button class="ui-button request-support__copy-button" size="mini" bindtap="copyLatestRequestId">复制排查编号</button></view>
  </view>
</view>
