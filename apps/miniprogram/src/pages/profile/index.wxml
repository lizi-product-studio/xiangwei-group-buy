<view class="ui-view profile">
  <view wx:if="{{!loggedIn}}" class="ui-view guest-card"><view class="guest-card__identity"><view class="ui-view avatar"><image class="ui-image avatar__image" src="/assets/avatar-persimmon.png" mode="aspectFit"/></view><view class="guest-card__copy"><text class="ui-text identity-card__name">当前未登录</text><text class="ui-text identity-card__description">登录后查看历史订单和固定自提点</text></view></view><button class="ui-button guest-card__button" bindtap="openLogin">手机号快捷登录</button></view>
  <view wx:else class="ui-view identity-card" bindtap="openProfileEdit"><view class="ui-view avatar"><image class="ui-image avatar__image" src="/assets/avatar-persimmon.png" mode="aspectFit" aria-hidden="true"/></view><view class="ui-view identity-card__copy"><text class="ui-text identity-card__name">{{userName}}</text><text class="ui-text identity-card__description">{{phoneNumber || '手机号未绑定'}} · 编辑资料 ›</text></view></view>
  <view class="ui-view order-card"><view class="ui-view card-head" data-filter="ALL" bindtap="openOrders"><view class="ui-view card-head__title"><text class="ui-text">我的订单</text><text wx:if="{{loggedIn && !loading && !error}}" class="ui-text card-head__count">共 {{orderTotal}} 单</text></view><view class="ui-view card-head__link"><text class="ui-text">查看全部订单</text><image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" /></view></view><view wx:if="{{loggedIn && error}}" class="ui-view summary-error" bindtap="loadSummary" role="alert">{{error}}，点击重试</view><view wx:else class="ui-view order-statuses"><view class="ui-view order-status" data-filter="PENDING" bindtap="openOrders"><text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.pending : '—'}}</text><text class="ui-text">待付款</text></view><view class="ui-view order-status" data-filter="ACTIVE" bindtap="openOrders"><text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.active : '—'}}</text><text class="ui-text">等待成团</text></view><view class="ui-view order-status" data-filter="READY" bindtap="openOrders"><text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.ready : '—'}}</text><text class="ui-text">待领取</text></view><view class="ui-view order-status" data-filter="AFTER" bindtap="openOrders"><text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.afterSale : '—'}}</text><text class="ui-text">退款/售后</text></view></view></view>
  <view class="ui-view pickup-card" bindtap="openPickup"><view class="ui-view card-head"><text class="ui-text">默认自提点</text><view class="ui-view card-head__link"><text class="ui-text">切换自提点</text><image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" /></view></view><view wx:if="{{areaError}}" class="ui-view summary-error" catchtap="loadArea" role="alert">{{areaError}}，点击重试</view><view class="ui-view pickup-content"><view class="ui-view pickup-copy"><text class="ui-text pickup-copy__title">{{pickupPoint ? pickupPoint.name : '请选择固定自提点'}}</text><text class="ui-text pickup-copy__description">{{pickupPoint ? pickupPoint.address : '选好附近点位，逛逛本期团购'}}</text></view></view></view>
  <view class="ui-view service-card"><text class="ui-text service-card__title">常用服务</text><view class="service-grid"><button class="ui-button service-tile" bindtap="openPickupCode"><image class="ui-image" src="/assets/wallet-green.png" mode="aspectFit"/><text class="ui-text service-tile__label">取货码</text><text class="ui-text service-tile__hint">到点出示领取</text></button><button class="ui-button service-tile" bindtap="openMessages"><image class="ui-image" src="/assets/message-green.png" mode="aspectFit"/><text class="ui-text service-tile__label">订单消息</text><text class="ui-text service-tile__hint">发车与到货提醒</text></button><button class="ui-button service-tile" bindtap="openPickup"><image class="ui-image" src="/assets/location-green.png" mode="aspectFit"/><text class="ui-text service-tile__label">切换自提点</text><text class="ui-text service-tile__hint">选择附近点位</text></button><button class="ui-button service-tile" open-type="contact"><image class="ui-image" src="/assets/service-green.png" mode="aspectFit"/><text class="ui-text service-tile__label">帮助与客服</text><text class="ui-text service-tile__hint">下单领取说明</text></button></view><view wx:if="{{latestRequestId}}" class="request-support"><text class="ui-text request-support__copy">最近一次失败可提供给客服：{{latestRequestId}}</text><button class="ui-button request-support__copy-button" size="mini" bindtap="copyLatestRequestId">复制排查编号</button></view></view>
  <view class="ui-view service-card account-card"><text class="ui-text service-card__title">账号与设置</text><view class="service-grid"><button class="ui-button service-tile" bindtap="openProfileEdit"><image class="ui-image" src="/assets/user-gray.png" mode="aspectFit"/><text class="ui-text service-tile__label">个人资料</text><text class="ui-text service-tile__hint">姓名与手机号</text></button><button class="ui-button service-tile" bindtap="openPrivacy"><image class="ui-image" src="/assets/privacy-green.png" mode="aspectFit"/><text class="ui-text service-tile__label">隐私与协议</text><text class="ui-text service-tile__hint">用户协议与隐私说明</text></button></view><button wx:if="{{loggedIn}}" class="ui-button account-settings__logout" hover-class="account-settings__logout--hover" bindtap="confirmLogout">退出当前账号</button><button wx:else class="ui-button account-settings__logout" hover-class="account-settings__logout--hover" bindtap="openLogin">登录账号</button></view>
</view>
