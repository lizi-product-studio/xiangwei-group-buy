<view class="ui-view profile">
  <view class="ui-view identity-card"><view class="ui-view avatar"><image class="ui-image avatar__image" src="/assets/user-gray.png" mode="aspectFit" aria-hidden="true"/></view><view class="ui-view identity-card__copy"><text class="ui-text identity-card__name">{{loggedIn ? userName : '欢迎来到乡味集'}}</text><text wx:if="{{loggedIn}}" class="ui-text identity-card__description">好味道，就在家附近</text><text wx:else class="ui-text identity-card__login" bindtap="openLogin">登录，查看订单与取货信息 ›</text></view></view>
  <view class="ui-view order-card">
    <view class="ui-view card-head" data-filter="ALL" bindtap="openOrders">
      <view class="ui-view card-head__title">
        <text class="ui-text">我的订单</text>
        <text wx:if="{{loggedIn && !loading && !error}}" class="ui-text card-head__count">共 {{orderTotal}} 单</text>
      </view>
      <view class="ui-view card-head__link"><text class="ui-text">全部订单</text><image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" /></view>
    </view>
    <view wx:if="{{loggedIn && error}}" class="ui-view summary-error" bindtap="loadSummary" role="alert">{{error}}，点击重试</view>
    <view wx:else class="ui-view order-statuses">
      <view class="ui-view order-status" data-filter="PENDING" bindtap="openOrders">
        <text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.pending : '—'}}</text>
        <text class="ui-text">待付款</text>
      </view>
      <view class="ui-view order-status" data-filter="ACTIVE" bindtap="openOrders">
        <text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.active : '—'}}</text>
        <text class="ui-text">进行中</text>
      </view>
      <view class="ui-view order-status" data-filter="READY" bindtap="openOrders">
        <text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.ready : '—'}}</text>
        <text class="ui-text">待自提</text>
      </view>
      <view class="ui-view order-status" data-filter="AFTER" bindtap="openOrders">
        <text class="ui-text order-count">{{loggedIn && !loading && !error ? counts.afterSale : '—'}}</text>
        <text class="ui-text">退款售后</text>
      </view>
    </view>
  </view>

  <view class="ui-view pickup-card" bindtap="openPickup">
    <view class="ui-view card-head">
      <text class="ui-text">默认自提点</text>
      <view class="ui-view card-head__link"><text class="ui-text">切换自提点</text><image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" /></view>
    </view>
    <view wx:if="{{areaError}}" class="ui-view summary-error" catchtap="loadArea" role="alert">{{areaError}}，点击重试</view>
    <view class="ui-view pickup-content">

      <view class="ui-view pickup-copy">
        <text class="ui-text pickup-copy__title">{{pickupPoint ? pickupPoint.name : '请选择固定自提点'}}</text>
        <text class="ui-text pickup-copy__description">{{pickupPoint ? pickupPoint.address : '选好附近点位，逛逛本期团购'}}</text>

      </view>
    </view>
  </view>

  <view class="ui-view service-card">
    <text class="ui-text service-card__title">常用服务</text>
    <button class="ui-button service-row" bindtap="openMessages">
      <image class="ui-image" src="/assets/message-green.png" mode="aspectFit" aria-label="订单消息" />
      <text class="ui-text service-row__label">订单消息</text>
      <text class="ui-text service-row__hint">地点、发车与到货提醒</text>
      <image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="ui-button service-row" bindtap="openInterest">
      <image class="ui-image" src="/assets/interest-green.png" mode="aspectFit" aria-label="开通意向" />
      <text class="ui-text service-row__label">开通意向</text>
      <text class="ui-text service-row__hint">所在区县暂未开放？登记需求</text>
      <image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="ui-button service-row" open-type="contact">
      <image class="ui-image" src="/assets/service-green.png" mode="aspectFit" aria-label="客服" />
      <text class="ui-text service-row__label">客服</text>
      <text class="ui-text service-row__hint">联系在线客服</text>
      <image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="ui-button service-row" bindtap="showHelp">
      <image class="ui-image" src="/assets/help-green.png" mode="aspectFit" aria-label="帮助" />
      <text class="ui-text service-row__label">帮助</text>
      <text class="ui-text service-row__hint">下单与集中领取说明</text>
      <image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="ui-button service-row" bindtap="showAbout">
      <image class="ui-image" src="/assets/about-green.png" mode="aspectFit" aria-label="关于" />
      <text class="ui-text service-row__label">关于</text>
      <text class="ui-text service-row__hint">版本与平台信息</text>
      <image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="ui-button service-row" bindtap="openPrivacy">
      <image class="ui-image" src="/assets/privacy-green.png" mode="aspectFit" aria-label="隐私与协议" />
      <text class="ui-text service-row__label">隐私与协议</text>
      <text class="ui-text service-row__hint">隐私政策与用户协议</text>
      <image class="ui-image" src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
  </view>
  <view class="ui-view account-settings"><button wx:if="{{loggedIn}}" class="ui-button account-settings__logout" hover-class="account-settings__logout--hover" bindtap="logout">退出登录</button><button wx:else class="ui-button account-settings__logout" hover-class="account-settings__logout--hover" bindtap="openLogin">登录账号</button></view>
</view>
