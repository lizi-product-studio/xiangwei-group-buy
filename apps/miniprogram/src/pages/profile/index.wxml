<view class="profile">
  <view wx:if="{{loggedIn}}" class="identity-card">
    <view class="avatar avatar--member"><image src="/assets/user-gray.png" mode="aspectFit" aria-label="用户头像" /></view>
    <view class="identity-card__copy">
      <text class="identity-card__eyebrow">当前微信身份</text>
      <text class="identity-card__name">{{userName}}</text>
      <text class="identity-card__description">订单与领取信息仅对您本人可见</text>
    </view>
    <button class="identity-card__logout" bindtap="logout">
      <image src="/assets/logout-orange.png" mode="aspectFit" aria-label="退出登录" />
      <text>退出登录</text>
    </button>
  </view>

  <view wx:else class="login-card">
    <view class="login-card__identity">
      <view class="avatar avatar--guest"><image src="/assets/user-gray.png" mode="aspectFit" aria-label="游客头像" /></view>
      <view class="login-card__copy">
        <text class="login-card__title">登录后查看订单与取货码</text>
        <text class="login-card__description">登录后可管理订单、查看取货码，不错过开团与到货通知。</text>
      </view>
    </view>
    <button class="primary-button login-card__button" bindtap="openLogin">
      <image src="/assets/wechat-white.png" mode="aspectFit" aria-label="微信" />
      <text>微信快捷登录</text>
    </button>
    <view class="login-card__privacy">
      <image src="/assets/shield-green.png" mode="aspectFit" aria-label="隐私保护" />
      <text>我们仅使用微信授权的头像与昵称来识别账号，保障隐私安全。</text>
    </view>
  </view>

  <view class="order-card">
    <view class="card-head" data-filter="ALL" bindtap="openOrders">
      <view class="card-head__title">
        <text>我的订单</text>
        <text wx:if="{{loggedIn && !loading}}" class="card-head__count">共 {{orderTotal}} 单</text>
      </view>
      <view class="card-head__link"><text>全部订单</text><image src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" /></view>
    </view>
    <view wx:if="{{loggedIn && error}}" class="summary-error" bindtap="loadSummary" role="alert">{{error}}，点击重试</view>
    <view wx:else class="order-statuses">
      <view class="order-status" data-filter="PENDING" bindtap="openOrders">
        <view class="status-icon"><image src="/assets/wallet-green.png" mode="aspectFit" aria-label="待付款" /></view>
        <text>待付款</text>
        <text wx:if="{{counts.pending}}" class="status-count">{{counts.pending > 99 ? '99+' : counts.pending}}</text>
      </view>
      <view class="order-status" data-filter="ACTIVE" bindtap="openOrders">
        <view class="status-icon"><image src="/assets/active-green.png" mode="aspectFit" aria-label="进行中" /></view>
        <text>进行中</text>
        <text wx:if="{{counts.active}}" class="status-count">{{counts.active > 99 ? '99+' : counts.active}}</text>
      </view>
      <view class="order-status" data-filter="READY" bindtap="openOrders">
        <view class="status-icon"><image src="/assets/pickup-green.png" mode="aspectFit" aria-label="待自提" /></view>
        <text>待自提</text>
        <text wx:if="{{counts.ready}}" class="status-count">{{counts.ready > 99 ? '99+' : counts.ready}}</text>
      </view>
      <view class="order-status" data-filter="AFTER" bindtap="openOrders">
        <view class="status-icon"><image src="/assets/refund-green.png" mode="aspectFit" aria-label="退款售后" /></view>
        <text>退款售后</text>
        <text wx:if="{{counts.afterSale}}" class="status-count">{{counts.afterSale > 99 ? '99+' : counts.afterSale}}</text>
      </view>
    </view>
  </view>

  <view class="pickup-card" bindtap="openPickup">
    <view class="card-head">
      <text>我的固定自提点</text>
      <view class="card-head__link"><text>切换自提点</text><image src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" /></view>
    </view>
    <view wx:if="{{areaError}}" class="summary-error" catchtap="loadArea" role="alert">{{areaError}}，点击重试</view>
    <view class="pickup-content">
      <view class="pickup-mark"><image src="/assets/location-white.png" mode="aspectFit" aria-label="自提点" /></view>
      <view class="pickup-copy">
        <text class="pickup-copy__title">{{pickupPoint ? pickupPoint.name : '请选择固定自提点'}}</text>
        <text class="pickup-copy__description">{{pickupPoint ? pickupPoint.address : '选择后，开团与到货信息将优先通知您'}}</text>
        <view class="pickup-copy__tags">
          <text>地址：{{pickupPoint ? pickupPoint.address : '请选择固定自提点'}}</text>
          <text>营业时间：{{pickupPoint ? '以点位页面为准' : '请选择'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="service-card">
    <text class="service-card__title">常用服务</text>
    <button class="service-row" bindtap="openMessages">
      <image src="/assets/message-green.png" mode="aspectFit" aria-label="订单消息" />
      <text class="service-row__label">订单消息</text>
      <text class="service-row__hint">地点、发车与到货提醒</text>
      <image src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="service-row" bindtap="openInterest">
      <image src="/assets/interest-green.png" mode="aspectFit" aria-label="开通意向" />
      <text class="service-row__label">开通意向</text>
      <text class="service-row__hint">所在区县暂未开放？登记需求</text>
      <image src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="service-row" open-type="contact">
      <image src="/assets/service-green.png" mode="aspectFit" aria-label="客服" />
      <text class="service-row__label">客服</text>
      <text class="service-row__hint">联系在线客服</text>
      <image src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="service-row" bindtap="showHelp">
      <image src="/assets/help-green.png" mode="aspectFit" aria-label="帮助" />
      <text class="service-row__label">帮助</text>
      <text class="service-row__hint">下单与集中领取说明</text>
      <image src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="service-row" bindtap="showAbout">
      <image src="/assets/about-green.png" mode="aspectFit" aria-label="关于" />
      <text class="service-row__label">关于</text>
      <text class="service-row__hint">版本与平台信息</text>
      <image src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
    <button class="service-row" bindtap="openPrivacy">
      <image src="/assets/privacy-green.png" mode="aspectFit" aria-label="隐私与协议" />
      <text class="service-row__label">隐私与协议</text>
      <text class="service-row__hint">隐私政策与用户协议</text>
      <image src="/assets/right-gray.png" mode="aspectFit" aria-hidden="true" />
    </button>
  </view>
</view>
