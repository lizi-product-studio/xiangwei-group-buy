.interest-page{min-height:100vh;padding:28rpx;background:#faf8f2;box-sizing:border-box}.hero{padding:36rpx 32rpx;border-radius:28rpx;background:#23312d;color:#fff}.hero .ui-text{display:block}.hero .ui-text:first-child{font-size:36rpx;font-weight:650}.hero .ui-text:last-child{margin-top:12rpx;color:#d8dfda;font-size:24rpx;line-height:1.55}.form-card{margin-top:22rpx;padding:30rpx;background:#fff;border:1rpx solid #e9e7df;border-radius:24rpx}.form-card .ui-label{display:block;margin:22rpx 0 12rpx;color:#27313d;font-size:25rpx;font-weight:700}.form-card .ui-label:first-child{margin-top:0}.form-card .ui-label .ui-text{margin-left:6rpx;color:#f05232}.form-card .ui-input{height:84rpx;padding:0 22rpx;background:#f8f8f5;border:1rpx solid #e7e6e0;border-radius:16rpx;color:#26313c;font-size:25rpx;box-sizing:border-box}.privacy{display:flex!important;align-items:flex-start;gap:10rpx;margin-top:28rpx!important;color:#68717d!important;font-size:24rpx!important;font-weight:400!important;line-height:1.5}.privacy .ui-checkbox{transform:scale(.82);transform-origin:left top}.privacy-note{display:block;margin:10rpx 0 26rpx;color:#9a9fa7;font-size:24rpx;line-height:1.45}.privacy-note .ui-text{display:block}.privacy-note__link{margin-top:8rpx;color:#d74b31;text-decoration:underline}.form-card .ui-button{margin:0}

.interest-page {padding:36rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));}.hero {padding:0 0 18rpx;background:transparent;color:#23312d;border-radius:0;}.hero .ui-text:first-child {font-size:38rpx;}.hero .ui-text:last-child {color:#818780;font-size:26rpx;line-height:1.7;}.form-card {background:#fffefa;border-radius:24rpx;padding:28rpx;font-size:26rpx;}.form-card .ui-input {background:white;font-size:26rpx;}.privacy {font-size:24rpx!important;line-height:1.7;}.privacy-note {font-size:24rpx;color:#818780;line-height:1.7;}.privacy-note__link {color:#597a43;}.interest-record {margin-top:22rpx;padding:20rpx 0;border-top:1rpx solid #e9e7df;display:flex;flex-direction:column;gap:12rpx;font-size:24rpx;}.interest-record>.ui-view {display:flex;justify-content:space-between;gap:12rpx;}.interest-page .primary-button {width:100%!important;margin:20rpx 0 0!important;padding:20rpx!important;}
