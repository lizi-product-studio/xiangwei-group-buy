.interest-page{min-height:100vh;padding:28rpx;background:#faf9f4;box-sizing:border-box}.hero{padding:36rpx 32rpx;border-radius:28rpx;background:#17263a;color:#fff}.hero text{display:block}.hero text:first-child{font-size:36rpx;font-weight:800}.hero text:last-child{margin-top:12rpx;color:#d8dfda;font-size:24rpx;line-height:1.55}.form-card{margin-top:22rpx;padding:30rpx;background:#fff;border:1rpx solid #ece9e1;border-radius:24rpx}.form-card label{display:block;margin:22rpx 0 12rpx;color:#27313d;font-size:25rpx;font-weight:700}.form-card label:first-child{margin-top:0}.form-card label text{margin-left:6rpx;color:#e94c2f}.form-card input{height:84rpx;padding:0 22rpx;background:#f8f8f5;border:1rpx solid #e7e6e0;border-radius:16rpx;color:#26313c;font-size:25rpx;box-sizing:border-box}.privacy{display:flex!important;align-items:flex-start;gap:10rpx;margin-top:28rpx!important;color:#68717d!important;font-size:21rpx!important;font-weight:400!important;line-height:1.5}.privacy checkbox{transform:scale(.82);transform-origin:left top}.privacy-note{display:block;margin:10rpx 0 26rpx;color:#9a9fa7;font-size:19rpx;line-height:1.45}.privacy-note text{display:block}.privacy-note__link{margin-top:8rpx;color:#d74b31;text-decoration:underline}.form-card button{margin:0}
