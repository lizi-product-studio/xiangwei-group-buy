<view class="ui-view interest-page">
  <view class="ui-view hero">
    <text class="ui-text">你所在的区县暂未开放？</text>
    <text class="ui-text">留下需求，我们优先评估收单、配送和集中领取条件。</text>
  </view>
  <view wx:if="{{loading}}" class="ui-view form-card"><text class="ui-text">正在加载意向记录…</text></view>
  <view wx:elif="{{loadError}}" class="ui-view form-card"><text class="ui-text">{{loadError}}</text><button class="ui-button secondary-button" bindtap="loadInterests">重新加载</button></view>
  <view wx:elif="{{interests.length}}" class="ui-view form-card">
    <text class="ui-text">我的开通意向</text>
    <view wx:for="{{interests}}" wx:key="id" class="ui-view interest-record">
      <view class="ui-view"><text class="ui-text">{{item.regionText}}</text><text class="ui-text">{{item.statusText}}</text></view>
      <text class="ui-text">{{item.contactName}} · {{item.maskedContactPhone}}</text>
      <text class="ui-text" wx:if="{{item.statusNote}}">{{item.statusNote}}</text>
      <view class="ui-view" wx:if="{{item.status !== 'CLOSED'}}">
        <button class="ui-button" wx:if="{{item.status === 'NEW'}}" size="mini" data-id="{{item.id}}" bindtap="startEdit">更正</button>
        <button class="ui-button" size="mini" data-id="{{item.id}}" bindtap="withdraw">撤回</button>
      </view>
    </view>
  </view>
  <view class="ui-view form-card">
    <text class="ui-text">{{editingId ? '更正开通意向' : '登记新的开通意向'}}</text>
    <label class="ui-label">所在省 / 市 / 区县<text class="ui-text">*</text></label>
    <input class="ui-input" data-field="regionText" value="{{regionText}}" maxlength="80" placeholder="请填写省 / 市 / 区县" bindinput="inputValue" />
    <label class="ui-label">联系人<text class="ui-text">*</text></label>
    <input class="ui-input" data-field="contactName" value="{{contactName}}" maxlength="30" placeholder="怎么称呼您" bindinput="inputValue" />
    <label class="ui-label">联系电话<text class="ui-text">*</text></label>
    <input class="ui-input" data-field="contactPhone" value="{{contactPhone}}" type="number" maxlength="20" placeholder="便于通知开通进展" bindinput="inputValue" />
    <checkbox-group bindchange="changePrivacy"><label class="ui-label privacy"><checkbox class="ui-checkbox" value="accepted" checked="{{privacyAccepted}}" color="#e94c2f" />我已阅读并同意平台为开通评估和通知进展使用以上信息</label></checkbox-group>
    <view class="ui-view privacy-note"><text class="ui-text">信息仅供开通评估与联系，不会用于营销转售。</text><text class="ui-text privacy-note__link" bindtap="openPrivacy">查看《隐私说明》（版本 {{privacyVersion}}）</text></view>
    <button class="ui-button primary-button" loading="{{submitting}}" bindtap="submit">{{editingId ? '保存更正' : '提交开通意向'}}</button>
    <button class="ui-button" wx:if="{{editingId}}" loading="{{submitting}}" bindtap="cancelEdit">取消更正</button>
  </view>
</view>
