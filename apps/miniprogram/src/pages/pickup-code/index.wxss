.pickup-card{margin:70rpx 28rpx;padding:64rpx 36rpx;text-align:center;background:#fff;border:1rpx solid #ece9e1;border-radius:28rpx;box-shadow:0 18rpx 50rpx rgba(35,38,43,.07)}.pickup-card__stamp{display:grid;place-items:center;width:76rpx;height:76rpx;margin:0 auto 30rpx;color:#547b36;background:#edf3e6;border-radius:20rpx;font-size:34rpx;font-weight:800}.pickup-card__title,.pickup-card__hint,.pickup-card__warning,.pickup-card__error{display:block}.pickup-card__title{font-size:28rpx;font-weight:750}.pickup-card__code{display:block;margin:55rpx 0 24rpx;color:#17263a;font-size:82rpx;font-weight:800;letter-spacing:18rpx}.pickup-card__hint{margin-top:18rpx;color:#818791;font-size:22rpx}.pickup-card__warning{margin-top:46rpx;padding-top:28rpx;border-top:1rpx dashed #dfe1e4;color:#c6791b;font-size:21rpx}.pickup-card__error{margin-top:36rpx;color:#f05232}
