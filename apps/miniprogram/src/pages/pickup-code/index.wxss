.pickup-card{margin:70rpx 28rpx;padding:64rpx 36rpx;text-align:center;background:#fff;border:1rpx solid #e9e7df;border-radius:28rpx;box-shadow:0 18rpx 50rpx rgba(35,38,43,.07)}.pickup-card__stamp{display:grid;place-items:center;width:76rpx;height:76rpx;margin:0 auto 30rpx;color:#3f6b35;background:#edf3e6;border-radius:20rpx;font-size:34rpx;font-weight:650}.pickup-card__title,.pickup-card__hint,.pickup-card__warning,.pickup-card__error{display:block}.pickup-card__title{font-size:28rpx;font-weight:650}.pickup-card__code{display:block;margin:55rpx 0 24rpx;color:#23312d;font-size:82rpx;font-weight:650;letter-spacing:18rpx}.pickup-card__hint{margin-top:18rpx;color:#818791;font-size:22rpx}.pickup-card__warning{margin-top:46rpx;padding-top:28rpx;border-top:1rpx dashed #dfe1e4;color:#c6791b;font-size:24rpx}.pickup-card__error{margin-top:36rpx;color:#c2412d}

.pickup-card {margin:40rpx;padding:46rpx 26rpx;border-radius:24rpx;background:#fffefa;box-shadow:none;}.pickup-card__stamp {background:transparent;margin-bottom:24rpx;}.pickup-code__asset {width:64rpx;height:64rpx;}.pickup-card__title {font-size:32rpx;line-height:1.5;}.pickup-card__code {color:#3f6b35;letter-spacing:10rpx;font-size:76rpx;overflow-wrap:anywhere;}.pickup-card__hint {font-size:25rpx;line-height:1.7;}.pickup-card__warning {font-size:24rpx;line-height:1.7;color:#626c60;}.pickup-card__error {font-size:26rpx;line-height:1.6;}.pickup-card .primary-button,.pickup-card .secondary-button {width:100%!important;margin:24rpx 0 0!important;padding:20rpx!important;}
