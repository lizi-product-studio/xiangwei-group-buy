.profile-edit{min-height:100vh;box-sizing:border-box;padding:28rpx;background:#faf8f2;color:#23312d}.profile-edit__card{margin-bottom:20rpx;padding:28rpx;border:1rpx solid #e6e3d8;border-radius:24rpx;background:#fffefa}.profile-edit__label{display:block;font-size:28rpx;font-weight:650}.profile-edit__avatar-button{display:flex;align-items:center;gap:18rpx;margin:22rpx 0 0;padding:0;background:transparent;color:#697269;text-align:left;font-size:24rpx}.profile-edit__avatar-button:after{border:0}.profile-edit__avatar{width:112rpx;height:112rpx;border-radius:50%;background:#eef0e9}.profile-edit__input{box-sizing:border-box;width:100%;margin-top:18rpx;padding:20rpx 0;border-bottom:1rpx solid #e6e3d8;font-size:30rpx}.profile-edit__hint,.profile-edit__value{display:block;margin-top:14rpx;color:#697269;font-size:24rpx}.profile-edit__line{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.profile-edit__phone{margin:0;padding:14rpx 20rpx;background:#fff0e9;color:#c2412d;border:1rpx solid #efab99;border-radius:16rpx;font-size:24rpx}.profile-edit__phone:after{border:0}.profile-edit__error{margin:18rpx 4rpx;color:#b34c35;font-size:24rpx;line-height:1.6}.profile-edit__save{width:100%;margin-top:26rpx;background:#c2412d;color:#fff;border-radius:18rpx;font-size:30rpx}.profile-edit__save:after{border:0}.profile-edit__state{text-align:center;padding:140rpx 30rpx;color:#697269;font-size:28rpx;line-height:1.8}.profile-edit__state button{margin-top:24rpx;background:#c2412d;color:#fff;border-radius:16rpx}
