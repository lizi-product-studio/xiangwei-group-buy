.profile-edit{min-height:100vh;box-sizing:border-box;padding:28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));background:#faf8f2;color:#23312d}.profile-edit__content{width:100%;min-width:0}.profile-edit__card{box-sizing:border-box;overflow:visible;margin-bottom:20rpx;padding:28rpx;border:1rpx solid #e6e3d8;border-radius:24rpx;background:#fffefa}.profile-edit__card--field{padding-bottom:24rpx}.profile-edit__label{display:block;color:#23312d;font-size:28rpx;font-weight:650;line-height:1.45}.profile-edit__avatar-button{display:flex;align-items:center;width:100%;min-height:112rpx;gap:20rpx;margin:22rpx 0 0;padding:0;background:transparent;color:#23312d;text-align:left}.profile-edit__avatar-button:after{border:0}.profile-edit__avatar{width:112rpx;height:112rpx;flex:none;border-radius:50%;background:#eef0e9}.profile-edit__avatar-copy,.profile-edit__phone-copy{min-width:0;flex:1}.profile-edit__avatar-action{display:block;font-size:28rpx;font-weight:600;line-height:1.4}.profile-edit__input{display:block;box-sizing:border-box;width:100%;height:76rpx;margin-top:14rpx;padding:18rpx 0 16rpx;border:0;border-bottom:1rpx solid #e6e3d8;background:transparent;color:#23312d;font-size:30rpx;line-height:42rpx}.profile-edit__placeholder{color:#9aa198}.profile-edit__hint,.profile-edit__value{display:block;margin-top:12rpx;color:#697269;font-size:24rpx;line-height:1.5}.profile-edit__line{display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:80rpx}.profile-edit__phone{flex:none;min-width:200rpx;margin:0;padding:16rpx 20rpx;background:#fff0e9;color:#c2412d;border:1rpx solid #efab99;border-radius:16rpx;font-size:24rpx;line-height:1.35;text-align:center}.profile-edit__phone:after{border:0}.profile-edit__error{display:block;margin:18rpx 4rpx;color:#b34c35;font-size:24rpx;line-height:1.6}.profile-edit__save{display:flex;align-items:center;justify-content:center;width:100%;height:88rpx;box-sizing:border-box;margin-top:26rpx;padding:0;background:#c2412d;color:#fff;border-radius:18rpx;font-size:30rpx;line-height:1}.profile-edit__save:after{border:0}.profile-edit__state{display:flex;flex-direction:column;align-items:center;gap:24rpx;box-sizing:border-box;min-height:60vh;padding:140rpx 30rpx;color:#697269;font-size:28rpx;line-height:1.8;text-align:center}.profile-edit__state button{width:260rpx;margin:0;background:#c2412d;color:#fff;border-radius:16rpx}.profile-edit__state button:after{border:0}@media(max-width:350px){.profile-edit__phone{min-width:172rpx;padding-right:14rpx;padding-left:14rpx}.profile-edit__line{gap:16rpx}}
