.detail { padding-bottom: 180rpx; }.detail-state { margin: 40rpx 24rpx; padding: 70rpx 24rpx; text-align: center; color: #7f858e; background: #fff; border-radius: 20rpx; }
.product-hero { position: relative; height: 620rpx; background: #eee; }.product-hero image { width: 100%; height: 100%; }.product-hero > text { position: absolute; left: 24rpx; bottom: 24rpx; padding: 10rpx 16rpx; color: #fff; background: rgba(30,33,36,.72); border-radius: 8rpx; font-size: 20rpx; }
.product-summary,.group-card,.pickup-card,.promise { margin: 18rpx 24rpx 0; padding: 25rpx; background: #fff; border: 1rpx solid #ece9e1; border-radius: 20rpx; }.price-row { display: flex; align-items: center; }.price { color: #f05232; font-size: 47rpx; font-weight: 800; }.price > text { font-size: 25rpx; }.price-tag { margin-left: 12rpx; padding: 5rpx 9rpx; color: #f05232; background: #fff0eb; border-radius: 6rpx; font-size: 18rpx; }.sold { margin-left: auto; color: #8e949c; font-size: 20rpx; }.product-summary__title { display: block; margin-top: 18rpx; color: #17263a; font-size: 33rpx; font-weight: 800; line-height: 1.45; }.product-summary__desc { display: block; margin-top: 9rpx; color: #898f97; font-size: 22rpx; }
.group-card__head,.group-card__rule { display: flex; justify-content: space-between; }.group-card__head text:first-child { color: #24292f; font-size: 24rpx; font-weight: 750; }.group-card__head text:last-child { color: #f05232; font-size: 20rpx; }.progress-track { height: 12rpx; margin: 20rpx 0 16rpx; overflow: hidden; background: #f0f1f3; border-radius: 10rpx; }.progress-track__value { width: 72%; height: 100%; background: #ff8a64; }.group-card__rule { color: #858b94; font-size: 19rpx; }
.pickup-card { display: flex; align-items: center; justify-content: space-between; }.pickup-card > view { display: flex; align-items: center; gap: 18rpx; }.pickup-card__icon { display: grid; width: 58rpx; height: 58rpx; place-items: center; color: #547b36; background: #edf3e6; border-radius: 15rpx; font-size: 22rpx; font-weight: 800; }.pickup-card view view text { display: block; }.pickup-card view view text:first-child { color: #292e34; font-size: 24rpx; font-weight: 700; }.pickup-card view view text:last-child { margin-top: 7rpx; color: #92979f; font-size: 19rpx; }.pickup-card__change { color: #f05232; font-size: 21rpx; }
.promise { display: flex; justify-content: space-between; padding: 22rpx 20rpx; }.promise view { color: #747b84; font-size: 19rpx; }.promise view text:first-child { margin-right: 6rpx; color: #547b36; }
.buy-bar { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 92rpx 1fr; gap: 16rpx; align-items:center;padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.98); border-top: 1rpx solid #e7e8eb; }.cart-shortcut{position:relative;display:flex;flex-direction:column;align-items:center;color:#68717d;font-size:18rpx}.cart-shortcut>text:first-child{font-size:30rpx;color:#17263a;font-weight:800}.cart-shortcut b{position:absolute;right:4rpx;top:-6rpx;min-width:28rpx;height:28rpx;padding:0 5rpx;border-radius:20rpx;display:grid;place-items:center;background:#ef4d31;color:#fff;font-size:16rpx}.buy-actions{display:grid;grid-template-columns:150rpx 1fr 1fr;gap:10rpx}.stepper { display: grid; grid-template-columns: repeat(3,1fr); align-items: center; overflow: hidden; text-align: center; background: #f6f7f8; border-radius: 40rpx; }.stepper text:first-child,.stepper text:last-child { color: #f05232; font-size: 30rpx; }.buy-bar button { width: 100%; margin: 0;padding:0 8rpx;font-size: 22rpx; }.cart-button{color:#e84b30;background:#fff0eb;font-weight:750}
