.detail { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); background: #faf8f2; }
.detail-state { display: flex; flex-direction: column; align-items: center; gap: 24rpx; margin: 32rpx; padding: 70rpx 32rpx; color: #626c60; text-align: center; background: #fffefa; border: 1rpx solid #e9e7df; border-radius: 28rpx; font-size: 26rpx; }
.detail-state--error { border-color: #edcbbf; }
.detail-state .ui-button { color: #3f6b35; font-size: 26rpx; }

.product-hero { position: relative; height: 480rpx; overflow: hidden; background: #ece6d8; }
.product-hero .ui-image { width: 100%; height: 100%; }
.product-hero > .ui-text { position: absolute; left: 24rpx; bottom: 24rpx; padding: 8rpx 14rpx; color: #fff; background: rgba(35,49,45,.75); border-radius: 12rpx; font-size: 22rpx; }

.product-summary { margin: 0; padding: 32rpx 32rpx 16rpx; background: transparent; }
.price-row { display: flex; align-items: center; gap: 12rpx; }
.price { color: #c2412d; font-size: 56rpx; font-weight: 750; }
.price > .ui-text { font-size: 28rpx; }
.price-tag { padding: 4rpx 16rpx; color: #c2412d; background: #fff0eb; border-radius: 12rpx; font-size: 24rpx; }
.sold { margin-left: auto; color: #626c60; font-size: 24rpx; }
.product-summary__title { display: block; margin-top: 16rpx; color: #23312d; font-size: 40rpx; font-weight: 700; line-height: 1.4; }
.product-summary__desc { display: block; margin-top: 12rpx; color: #626c60; font-size: 26rpx; line-height: 1.5; }

.group-card, .pickup-card { width: auto; margin: 24rpx 32rpx 0; padding: 32rpx; background: #fffefa; border: 1rpx solid #e6e3d8; border-radius: 28rpx; }
.group-card__head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.group-card__head .ui-text:first-child { color: #23312d; font-size: 28rpx; font-weight: 700; }
.group-card__head .ui-text:last-child { color: #c2412d; font-size: 26rpx; font-weight: 650; }
.progress-track { height: 16rpx; margin: 20rpx 0; overflow: hidden; background: #efe8dc; border-radius: 99rpx; }
.progress-track__value { height: 100%; background: #c2412d; }
.time-row { display: flex; justify-content: space-between; gap: 24rpx; margin-top: 16rpx; color: #626c60; font-size: 26rpx; line-height: 1.5; }
.time-row .ui-text:last-child { color: #23312d; font-weight: 650; text-align: right; }
.countdown { margin-top: 16rpx; color: #c2412d; font-size: 28rpx; font-weight: 700; }
.group-card__explain { display: block; margin-top: 20rpx; color: #626c60; font-size: 24rpx; line-height: 1.6; }

.pickup-card__heading { display: block; margin-bottom: 20rpx; color: #626c60; font-size: 24rpx; font-weight: 650; }
.pickup-card__row { display: flex; align-items: center; gap: 20rpx; }
.pickup-card__asset { flex: none; width: 104rpx; height: 104rpx; border-radius: 16rpx; background: #ece6d8; }
.pickup-card__content { min-width: 0; flex: 1; }
.pickup-card__content .ui-text { display: block; color: #626c60; font-size: 24rpx; line-height: 1.5; }
.pickup-card__content .ui-text:first-child { color: #23312d; font-size: 28rpx; font-weight: 700; }
.pickup-card__content .ui-text + .ui-text { margin-top: 6rpx; }
.pickup-card__tools { display: flex; flex: none; flex-direction: column; gap: 12rpx; }
.pickup-card__tools .ui-text { min-width: 76rpx; padding: 12rpx 10rpx; color: #c2412d; text-align: center; background: #fff0eb; border: 1rpx solid #f0b9aa; border-radius: 14rpx; font-size: 22rpx; font-weight: 650; }

.buy-bar { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 150rpx minmax(0, 38fr) minmax(0, 62fr); gap: 16rpx; align-items: center; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: rgba(255,254,250,.98); border-top: 1rpx solid #e6e3d8; }
.stepper { display: grid; grid-template-columns: repeat(3,1fr); align-items: center; height: 88rpx; overflow: hidden; text-align: center; background: #fff; border: 1rpx solid #e6e3d8; border-radius: 20rpx; }
.stepper .ui-text:first-child, .stepper .ui-text:last-child { color: #c2412d; font-size: 32rpx; }
.detail .primary-button, .detail .cart-button { width: 100% !important; min-width: 0; min-height: 88rpx; margin: 0 !important; padding: 12rpx 10rpx !important; border-radius: 20rpx; font-size: 24rpx; font-weight: 650; line-height: 1.35; }
.cart-button { color: #c2412d; background: #fff0eb; border: 1rpx solid #f0b9aa; }
.primary-button { color: #fff; background: #c2412d; }
