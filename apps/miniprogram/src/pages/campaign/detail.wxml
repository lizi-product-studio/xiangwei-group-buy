<view wx:if="{{loading}}" class="detail-state">正在加载商品…</view>
<view wx:elif="{{error}}" class="detail-state detail-state--error"><text>{{error}}</text><button size="mini" bindtap="retryLoad">重新加载</button></view>
<view wx:else class="detail">
  <view class="product-hero"><image src="{{product.imageUrl || '/assets/product-rice-noodles.jpg'}}" mode="aspectFill"/><text>{{product.origin}} · 产地直采</text></view>
  <view class="product-summary"><view class="price-row"><text class="price"><text>¥</text>{{priceText}}</text><text class="price-tag">团购价</text><text class="sold">已支付 {{product.paidQuantity || 0}} 件</text></view><text class="product-summary__title">{{product.title}}</text><text class="product-summary__desc">{{product.skuName}} · 团期集中送达</text></view>
  <view class="group-card">
    <view class="group-card__head"><text>本团成团进度</text><text>已支付 {{campaignSoldQuantity}} / {{campaign.minTotalQuantity}} 件</text></view>
    <view class="progress-track"><view class="progress-track__value" style="width: {{progressPercent}}%;"></view></view>
    <view class="time-row"><text>截单时间</text><text>{{cutoffText}}</text></view>
    <view class="countdown">{{countdownText}}</view>
    <view class="time-row"><text>预计到货</text><text>{{estimatedArrivalText}}</text></view>
    <view class="time-row"><text>计划发车</text><text>{{dispatchText}}</text></view>
    <text class="group-card__explain">最小成团件数：{{campaign.minTotalQuantity}} 件。{{unformedRuleText}}</text>
  </view>
  <view class="pickup-card">
    <view bindtap="openPickup"><text class="pickup-card__icon">取</text><view><text>{{area ? area.name + ' · ' + deliveryTitle : '请选择本团收货区域'}}</text><text>{{deliveryNote}}</text><text wx:if="{{pickupPoint.businessHours}}">营业时间：{{pickupPoint.businessHours}}</text><text wx:if="{{pickupPoint.pickupInstructions}}">领取提示：{{pickupPoint.pickupInstructions}}</text><text wx:if="{{pickupPoint.contactName || pickupPoint.contactPhone}}">联系人：{{pickupPoint.contactName || '点位负责人'}} {{pickupPoint.contactPhone}}</text></view></view>
    <view class="pickup-card__tools"><text bindtap="openPickup">详情 ›</text><text catchtap="openLocation">一键导航</text><text catchtap="callPickupPoint">联系点位</text></view>
  </view>
  <view class="rule-card"><text>领取期限</text><text>{{pickupDeadlineRule}}</text></view>
  <view class="promise"><view><text>✓</text><text>未成团按公示规则处理</text></view><view><text>✓</text><text>一团固定一个自提点</text></view><view><text>✓</text><text>到货后凭码领取</text></view></view>
  <view class="buy-bar"><view class="cart-shortcut" bindtap="openCart"><text>购</text><text>购物车</text><b wx:if="{{cartCount}}">{{cartCount}}</b></view><view class="buy-actions"><view class="stepper"><text data-step="-1" bindtap="changeQuantity">−</text><text>{{quantity}}</text><text data-step="1" bindtap="changeQuantity">＋</text></view><button class="cart-button" disabled="{{!area || soldOut || !canBuy}}" bindtap="addToCart">加入购物车</button><button class="primary-button" disabled="{{!area || soldOut || !canBuy}}" bindtap="goCheckout">{{soldOut ? '已售罄' : (!canBuy ? '暂不可购买' : '立即购买')}}</button></view></view>
</view>
