<view wx:if="{{loading}}" class="detail-state">正在加载商品…</view>
<view wx:elif="{{error}}" class="detail-state">{{error}}</view>
<view wx:else class="detail">
  <view class="product-hero"><image src="{{product.imageUrl || '/assets/product-rice-noodles.jpg'}}" mode="aspectFill"/><text>{{product.origin}} · 产地直采</text></view>
  <view class="product-summary"><view class="price-row"><text class="price"><text>¥</text>{{priceText}}</text><text class="price-tag">团购价</text><text class="sold">已售 {{product.soldQuantity}} 件</text></view><text class="product-summary__title">{{product.title}}</text><text class="product-summary__desc">{{product.skuName}} · 团期集中送达</text></view>
  <view class="group-card"><view class="group-card__head"><text>本团进度</text><text>已收 {{campaignSoldQuantity}} / {{campaign.minTotalQuantity}} 件</text></view><view class="progress-track"><view class="progress-track__value" style="width: {{progressPercent}}%;"></view></view><view class="group-card__rule"><text>截单 {{cutoffText}}</text><text>计划发车 {{dispatchText}}</text></view></view>
  <view class="pickup-card" bindtap="openPickup"><view><text class="pickup-card__icon">取</text><view><text>{{area ? area.name + ' · ' + deliveryTitle : '请选择本团收货区域'}}</text><text>{{deliveryNote}}</text></view></view><text class="pickup-card__change">查看 ›</text></view>
  <view class="promise"><view><text>✓</text><text>未成团自动退款</text></view><view><text>✓</text><text>固定自提点下单前可见</text></view><view><text>✓</text><text>到货后凭码领取</text></view></view>
  <view class="buy-bar"><view class="cart-shortcut" bindtap="openCart"><text>购</text><text>购物车</text><b wx:if="{{cartCount}}">{{cartCount}}</b></view><view class="buy-actions"><view class="stepper"><text data-step="-1" bindtap="changeQuantity">−</text><text>{{quantity}}</text><text data-step="1" bindtap="changeQuantity">＋</text></view><button class="cart-button" disabled="{{!area || soldOut}}" bindtap="addToCart">加入购物车</button><button class="primary-button" disabled="{{!area || soldOut}}" bindtap="goCheckout">{{soldOut ? '已售罄' : '立即购买'}}</button></view></view>
</view>
