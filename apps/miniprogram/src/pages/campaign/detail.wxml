<view wx:if="{{loading}}" class="ui-view detail-state">正在加载商品…</view>
<view wx:elif="{{error}}" class="ui-view detail-state detail-state--error"><text class="ui-text">{{error}}</text><button class="ui-button" size="mini" bindtap="retryLoad">重新加载</button></view>
<view wx:else class="ui-view detail">
  <view class="ui-view product-hero"><view class="ui-image"><product-image src="{{product.imageUrl || ''}}" image-mode="aspectFit" /></view><text class="ui-text">{{product.origin}} · 产地直采</text></view>
  <view class="ui-view product-summary"><view class="ui-view price-row"><text class="ui-text price"><text class="ui-text">¥</text>{{priceText}}</text><text class="ui-text price-tag">团购价</text><text class="ui-text sold">已支付 {{product.paidQuantity || 0}} 件</text></view><text class="ui-text product-summary__title">{{product.title}}</text><text class="ui-text product-summary__desc">{{product.skuName}} · 团期集中送达</text></view>
  <view class="ui-view group-card">
    <view class="ui-view group-card__head"><text class="ui-text">本团成团进度</text><text class="ui-text">已支付 {{campaignSoldQuantity}} / {{campaign.minTotalQuantity}} 件</text></view>
    <view class="ui-view progress-track"><view class="ui-view progress-track__value" style="width: {{progressPercent}}%;"></view></view>
    <view class="ui-view time-row"><text class="ui-text">截单时间</text><text class="ui-text">{{cutoffText}}</text></view>
    <view class="ui-view countdown">{{countdownText}}</view>
    <view class="ui-view time-row"><text class="ui-text">到货安排</text><text class="ui-text">{{estimatedArrivalText}}</text></view>
    <text class="ui-text group-card__explain">最小成团件数：{{campaign.minTotalQuantity}} 件。{{unformedRuleText}}</text>
  </view>
  <view class="ui-view pickup-card">
    <text class="ui-text pickup-card__heading">本团固定自提点</text>
    <view class="ui-view pickup-card__row">
      <view class="ui-view pickup-card__asset" bindtap="openPickup"><image class="ui-image pickup-card__icon" src="/assets/location-green.png" mode="aspectFit"/></view>
      <view class="ui-view pickup-card__content" bindtap="openPickup"><text class="ui-text">{{area ? deliveryTitle : '请选择本团收货区域'}}</text><text class="ui-text">{{deliveryNote}}</text><text class="ui-text" wx:if="{{pickupPoint.businessHours}}">{{pickupPoint.businessHours}}</text><text class="ui-text" wx:if="{{pickupPoint.contactName}}">点位负责人 {{pickupPoint.contactName}}</text></view>
      <view class="ui-view pickup-card__tools"><text class="ui-text" catchtap="openLocation">导航</text><text class="ui-text" catchtap="callPickupPoint">电话</text></view>
    </view>
  </view>
  <view class="ui-view buy-bar"><view class="ui-view stepper"><text class="ui-text" data-step="-1" bindtap="changeQuantity">−</text><text class="ui-text">{{quantity}}</text><text class="ui-text" data-step="1" bindtap="changeQuantity">＋</text></view><button class="ui-button {{!area || soldOut || !canBuy ? 'ui-disabled' : ''}} cart-button" disabled="{{!area || soldOut || !canBuy}}" bindtap="addToCart">加入购物车</button><button class="ui-button {{!area || soldOut || !canBuy ? 'ui-disabled' : ''}} primary-button" disabled="{{!area || soldOut || !canBuy}}" bindtap="goCheckout">{{soldOut ? '已售罄' : (!canBuy ? '暂不可购买' : '立即购买')}}</button></view>
</view>
