NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
TRUST_PROXY=false
RATE_LIMIT_MAX=300
# Keep this value identical to apps/miniprogram/src/config/legal.ts when a notice is revised.
PRIVACY_NOTICE_VERSION=2026-09-07-phone-v1
AUTH_PROVIDER=demo
# WECHAT_APP_ID=wx_your_miniprogram_appid
# WECHAT_APP_SECRET=replace-with-secret-from-wechat-console
AUTH_SESSION_TTL_SECONDS=604800
# 仅在执行 pnpm admin:bootstrap 时临时提供，不要写入镜像或提交真实值
# BOOTSTRAP_ADMIN_USERNAME=ops.admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
PAYMENT_PROVIDER=mock
# Production must use PAYMENT_PROVIDER=wechat with direct JSAPI credentials.
# WECHAT_PAY_MCHID=1234567890
# WECHAT_PAY_CERT_SERIAL=merchant-api-certificate-serial
# WECHAT_PAY_PRIVATE_KEY_PATH=C:/secure/apiclient_key.pem
# WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_3000000001
# WECHAT_PAY_PUBLIC_KEY_PATH=C:/secure/wechatpay_public_key.pem
# WECHAT_PAY_API_V3_KEY=exactly-32-characters-secret-key
# WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify
# WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/refund-notify
# WECHAT_PAY_MERCHANT_NAME=营业执照主体全称
DATA_STORE=mysql
QUEUE_DRIVER=redis
DATABASE_URL=mysql://app:app_password@127.0.0.1:3306/hometown_food
REDIS_URL=redis://127.0.0.1:6379
PICKUP_CODE_SECRET=development-only-pickup-secret
# Optional. Enables Chinese POI search and reverse geocoding for pickup-point maps.
# AMAP_WEB_KEY=replace-with-amap-web-service-key

# Product images default to ~/.local/share/hometown/product-images outside the repository.
# Set an absolute writable persistent directory to override.
# PRODUCT_IMAGE_DIR=/absolute/path/to/product-images
