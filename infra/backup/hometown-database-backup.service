[Unit]
Description=Private hometown database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/hometown-backup/database_backup.py
UMask=0077
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=300
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/hometown-database
PrivateTmp=true
