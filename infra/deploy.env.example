MYSQL_APP_PASSWORD=replace-with-strong-random-password
MYSQL_ROOT_PASSWORD=replace-with-different-strong-random-password
REDIS_PASSWORD=replace-with-strong-random-password
# Public HTTPS hostname. DNS A/AAAA must already resolve to this host for ACME.
PUBLIC_DOMAIN=replace-with-registered-https-host.example.invalid
ACME_EMAIL=replace-with-operations-email@example.invalid
PRIVACY_NOTICE_VERSION=2026-08-12
WECHAT_APP_ID=wx_your_miniprogram_appid
WECHAT_APP_SECRET=replace-with-wechat-app-secret
# Use the exact data field keys of your four approved templates. Values may use:
# {{title}}, {{content}}, {{siteName}}, {{address}}, {{arrivalStartAt}}, {{arrivalEndAt}}
WECHAT_SUBSCRIBE_SITE_TEMPLATE_ID=replace-with-site-template-id
WECHAT_SUBSCRIBE_SITE_TEMPLATE_DATA={"thing1":"{{siteName}}","thing2":"{{address}}"}
WECHAT_SUBSCRIBE_DISPATCH_TEMPLATE_ID=replace-with-dispatch-template-id
WECHAT_SUBSCRIBE_DISPATCH_TEMPLATE_DATA={"thing1":"{{siteName}}","thing2":"{{content}}"}
WECHAT_SUBSCRIBE_ARRIVAL_TEMPLATE_ID=replace-with-arrival-template-id
WECHAT_SUBSCRIBE_ARRIVAL_TEMPLATE_DATA={"thing1":"{{siteName}}","thing2":"{{content}}"}
WECHAT_SUBSCRIBE_PARTIAL_REFUND_TEMPLATE_ID=replace-with-partial-refund-template-id
WECHAT_SUBSCRIBE_PARTIAL_REFUND_TEMPLATE_DATA={"thing1":"{{title}}","thing2":"{{content}}"}
WECHAT_PAY_MCHID=1234567890
WECHAT_PAY_CERT_SERIAL=merchant-api-certificate-serial
WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_3000000001
WECHAT_PAY_API_V3_KEY=exactly-32-characters-secret-key
WECHAT_PAY_NOTIFY_URL=https://replace-with-registered-https-host.example.invalid/api/v1/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://replace-with-registered-https-host.example.invalid/api/v1/payments/wechat/refund-notify
WECHAT_PAY_MERCHANT_NAME=营业执照主体全称
PICKUP_CODE_SECRET=replace-with-at-least-32-random-characters
WECHAT_PRIVATE_KEY_FILE=./secrets/apiclient_key.pem
WECHAT_PUBLIC_KEY_FILE=./secrets/wechatpay_public_key.pem
