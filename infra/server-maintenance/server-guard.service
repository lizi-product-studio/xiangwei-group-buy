[Unit]
Description=Bounded server memory check and opt-in test cleanup
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/server-guard/server_guard.py check
TimeoutStartSec=40
MemoryMax=96M
CPUQuota=20%
TasksMax=32
Nice=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/server-guard /var/log/server-guard
